import OddMath.SKM.BWWReesParameters
import OddMath.SKM.BWWPureNilpotent

/-!
# Truncated Rees parameters have nilpotent pure coefficients

J. Brundan, W. Wang, B. Webster, arXiv:2505.22929v2, §2.2.

In the Rees parameters `BWWReesParameters.scalars` the pure coefficient of `u^p` (`p < dᵢⱼ`)
is multiplied by a positive power of `h` (`coefficientDegree_pos_of_pure`). After truncation to
`k[h]/(h^N)` it lies in the ideal generated by `h`, whose `N`-th power vanishes.

* `BWWReesParameters.truncated_pureIn`: the pure coefficients lie in `(h)`.
* `BWWReesParameters.truncated_pureNilpotent`: the truncated Rees parameters satisfy
  `ScalarData.PureNilpotent`.
-/

noncomputable section

namespace OddMath.SKM

universe u v w

variable {I : Type u} {X : Type v} [AddCommGroup X] {D : Datum I X}

namespace BWWReesParameters

open MvPolynomial TruncatedRees

variable (sy : Symmetrizer D) {k : Type w} [CommRing k]

/-- The image of `h` in `k[h]/(h^N)`. -/
abbrev truncH (N : ℕ) : TruncRing k N := trunc k N (MvPolynomial.X ())

theorem truncH_pow (N : ℕ) : truncH (k := k) N ^ N = 0 := by
  rw [truncH, ← map_pow, trunc, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
  simp

/-- The pure coefficients of the truncated Rees parameters lie in the ideal generated by `h`. -/
theorem truncated_pureIn (Sc : BWWScalars D k) (N : ℕ) :
    ((scalars sy Sc).map (trunc k N)).PureIn (Ideal.span {truncH N}) := by
  intro i j p hij hp
  have hji : D.dn j i ≠ 0 := fun h =>
    absurd ((ScalarData.dn_eq_zero_iff (D := D) i j).mpr h) (by omega)
  have hpd : (p : ℤ) < D.d i j := by rw [← D.dn_cast hij]; exact_mod_cast hp
  have hqd : ((0 : ℕ) : ℤ) < D.d j i := by
    rw [← D.dn_cast hij.symm]; exact_mod_cast Nat.pos_of_ne_zero hji
  have he : 0 < exponent sy i j p 0 := by
    rw [exponent_of_lt sy hpd hqd]
    have := coefficientDegree_pos_of_pure sy hpd hqd (Or.inr rfl)
    omega
  rw [BWWScalars.map_c]
  change trunc k N (C (Sc.c i j p 0) * MvPolynomial.X () ^ exponent sy i j p 0) ∈ _
  obtain ⟨e, he'⟩ := Nat.exists_eq_add_of_lt he
  rw [he', pow_succ, ← mul_assoc, map_mul]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

/-- **The truncated Rees parameters have nilpotent pure coefficients.** -/
theorem truncated_pureNilpotent (Sc : BWWScalars D k) (N : ℕ) :
    ((scalars sy Sc).map (trunc k N)).toScalars.PureNilpotent := by
  refine ⟨Ideal.span {truncH N}, N, ?_, ?_⟩
  · rw [Ideal.span_singleton_pow, truncH_pow, Ideal.span_singleton_eq_bot]
  · rw [BWWScalars.toScalars_toBWW]
    exact truncated_pureIn sy Sc N

end BWWReesParameters

end OddMath.SKM
