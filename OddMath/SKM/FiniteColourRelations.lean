import OddMath.SKM.Presentation

/-!
# Finite colour witnesses for the defining Hom relations

Brundan–Ellis, *Super Kac–Moody 2-categories*, Definition 1.5. Membership in the
actual presented Hom relation submodule has a finite witness, including the
pre- and post-composition diagrams, whiskering strands, and the interior
vertices of relations and super interchange. Boundary words alone do not
record colours created and removed inside a diagram.
-/

noncomputable section
namespace OddMath.SKM
open CategoryTheory StringDiagrams

universe u v w
variable {I : Type u} {X : Type v} [AddCommGroup X] (D : Datum I X)
variable {k : Type w} [CommRing k] (Sc : Scalars D k)
local instance : DecidableEq I := Classical.decEq I

/-- Colours appearing in a generating vertex, even when its boundary is empty. -/
def Shape.colours : Shape I → List I
  | .dot i | .cup i | .cap i | .dcup i _ | .dcap i _ => [i]
  | .cross i j | .lcross i j => [i, j]

/-- Colours in a strand word, with the original weight labels left untouched. -/
def wordColours (w : List (Col I X)) : Finset I :=
  (w.map fun c => c.l.2).toFinset

/-- Include generator vertices, not just the strands visible at the boundary. -/
def layerColours (L : Layer (sig D)) : Finset I :=
  wordColours L.left ∪ (L.gen.1.colours).toFinset ∪ wordColours L.right

/-- Support of a free diagram, including temporary cup/cap strands. -/
def diagramColours {a b : Obj (sig D)} (f : a ⟶ b) : Finset I :=
  wordColours a.word ∪ wordColours b.word ∪
    ((Diagram.layers f).foldl (fun J L => J ∪ layerColours D L) ∅)

/-- Support of a finite linear combination of free diagrams. -/
def linearColours {a b : Obj (sig D)} (f : LinDiagram k a b) : Finset I :=
  wordColours a.word ∪ wordColours b.word ∪
    f.support.toList.foldl (fun J d => J ∪ diagramColours D d) ∅

/-- Raw colour parameters of a defining relation. Unlike expanded linear support,
this records the parameters even when coefficients cancel or the ring is zero. -/
def Rel.colours : Rel D → List I
  | .quadEq i _ | .slideLEq i _ | .slideREq i _ | .zigE i _ | .zigF i _
  | .invP₁ i _ _ | .invP₂ i _ _ | .invP₃ i _ _ _ | .invP₄ i _ _ _
  | .invP₅ i _ _ _ _ _ | .invM₁ i _ _ | .invM₂ i _ _ | .invM₃ i _ _ _
  | .invM₄ i _ _ _ | .invM₅ i _ _ _ _ _ | .dcupZero i _ _ _ | .dcapZero i _ _ _ => [i]
  | .quadZero i j _ _ _ | .quadNe i j _ _ _ | .slideL i j _ _ | .slideR i j _ _
  | .braidEq i j _ _ | .invNe₁ i j _ _ | .invNe₂ i j _ _ => [i, j]
  | .braid i j k _ _ => [i, j, k]

/-- Raw support of an imposed relation, including the two generating vertices
and all intervening strands of superinterchange, before linear expansion. -/
def allRelColours : (pres D Sc).AllRel → Finset I
  | .user r => (r.colours).toFinset
  | .interchange x _ => x.g.1.colours.toFinset ∪ wordColours x.mid ∪ x.h.1.colours.toFinset

/-- A fully contextual instance of an imposed relation, before taking its span. -/
structure RelationContext (a b : Obj (sig D)) where
  rel : (pres D Sc).AllRel
  left : Obj (sig D)
  right : List (sig D).Colour
  compatible : rel.dom.WhiskerOK left right
  pre : LinDiagram k a (rel.dom.whisker left right)
  post : LinDiagram k (rel.cod.whisker left right) b

/-- The precise generator of the relation submodule attached to a context. -/
def RelationContext.value {a b : Obj (sig D)} (c : RelationContext D Sc a b) :
    LinDiagram k a b :=
  c.pre ≫ LinDiagram.whisker c.rel.rel c.left c.right c.compatible ≫ c.post

/-- A finite set containing every colour in the context and its relation, including
internal vertices in the relation and in pre/post compositions. -/
def RelationContext.colours {a b : Obj (sig D)} (c : RelationContext D Sc a b) :
    Finset I :=
  wordColours a.word ∪ wordColours b.word ∪
  wordColours c.left.word ∪ wordColours c.right ∪
  linearColours D c.pre ∪ linearColours D c.rel.rel ∪ linearColours D c.post ∪
  allRelColours D Sc c.rel

/-- The submodule generated by contextual relations whose complete syntax is
supported on `J`. This is a submodule of the actual free Hom, not a toy quotient. -/
def finiteColourIdeal (a b : Obj (sig D)) (J : Finset I) :
    Submodule k (LinDiagram k a b) :=
  Submodule.span k {f | ∃ c : RelationContext D Sc a b,
    c.colours ⊆ J ∧ c.value = f}

/-- Every element of the defining relation submodule has a finite contextual
colour witness. In particular, this is not a statement about boundary support. -/
theorem mem_finiteColourIdeal {a b : Obj (sig D)} {f : LinDiagram k a b}
    (hf : f ∈ (pres D Sc).ideal a b) :
    ∃ J : Finset I, f ∈ finiteColourIdeal D Sc a b J := by
  induction hf using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨r, l, w, hw, pre, post⟩ := hx
    let c : RelationContext D Sc _ _ := ⟨r, l, w, hw, pre, post⟩
    refine ⟨c.colours, Submodule.subset_span ?_⟩
    exact ⟨c, Finset.Subset.rfl, rfl⟩
  | zero => exact ⟨∅, Submodule.zero_mem _⟩
  | add x y _ _ hx hy =>
    obtain ⟨J, hJ⟩ := hx
    obtain ⟨K, hK⟩ := hy
    refine ⟨J ∪ K, Submodule.add_mem _ ?_ ?_⟩
    · exact Submodule.span_mono (by
        rintro f ⟨c, hc, rfl⟩
        exact ⟨c, hc.trans (Finset.subset_union_left), rfl⟩) hJ
    · exact Submodule.span_mono (by
        rintro f ⟨c, hc, rfl⟩
        exact ⟨c, hc.trans (Finset.subset_union_right), rfl⟩) hK
  | smul r x _ hx =>
    obtain ⟨J, hJ⟩ := hx
    exact ⟨J, Submodule.smul_mem _ r hJ⟩

/-- Equality in the actual presented Hom admits a finite contextual colour
witness for its defining difference. -/
theorem eq_finiteColourIdeal {a b : Obj (sig D)} (f g : LinDiagram k a b)
    (h : (pres D Sc).lin f = (pres D Sc).lin g) :
    ∃ J : Finset I, f - g ∈ finiteColourIdeal D Sc a b J :=
  mem_finiteColourIdeal D Sc ((pres D Sc).lin_eq_iff f g |>.mp h)

end OddMath.SKM
