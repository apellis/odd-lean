import OddMath.SKM.Beta

/-!
# The image of `β_λ` in `End(1_λ)`

J. Brundan, A. P. Ellis, *Super Kac–Moody 2-categories*, arXiv:1701.04133v2, (1.21)–(1.22) and
Theorem 8.1 with `a = b = ∅`: the homomorphism `β_λ : SYM → End(1_λ)`, the tensor product over
all colours `i` of the homomorphisms `β_{λ;i}` of (1.19), (1.20) (`beta`, `betaD`), is
surjective. Its image is the subalgebra generated by the images of the `β_{λ;i}` (they
supercommute, Proposition 5.1). This file describes that image.

* `bubbleSpan cs ν`: the subalgebra of `End(1_ν)` generated by the counterclockwise bubbles
  `bubLs i ν n` (all colours `i`, all `n ∈ ℤ`).
* `bubbleSpan_eq_iSup`: it is the image of `β_ν`, i.e. the supremum over the colours of the
  ranges of `β_{ν;i}` (`betaRange`).
* `IsBub cs ν f`: `f` lies in `bubbleSpan cs ν`. This holds for every dotted bubble:
  `isBub_bubLs`, `isBub_bubRs`, `isBub_bubL`, `isBub_bubR` (all `n ∈ ℤ`, fake bubbles
  included), and for the odd bubble (`isBub_oddBubble`), whose square vanishes for odd `i`
  (`oddBubble_sq`, (1.24)). Homogeneous elements supercommute (`comm_of_mem`, Proposition 5.1).
* `bubbleSpan_eq_adjoin_bubRs`: the clockwise bubbles generate the same subalgebra. Both
  directions come from the infinite Grassmannian relation (`bubble_key`) by induction on the
  degree (`bubRs_mem_of_bubLs`, `bubLs_mem_of_bubRs`).
-/

noncomputable section

namespace OddMath.SKM

open CategoryTheory StringDiagrams Presentation Finset MvPolynomial

universe u v w

variable {I : Type u} {X : Type v} [AddCommGroup X] {D : Datum I X} {k : Type w} [CommRing k]
  {Sc : Scalars D k} (cs : CScalars Sc)

/-! ## The subalgebra generated by the bubbles -/

/-- The counterclockwise bubbles with `n + *` dots, all colours, all `n ∈ ℤ`. -/
def bubGens (ν : X) : Set (End ((pres D Sc).obj (ob D ν []))) :=
  {f | ∃ i n, f = bubLs cs i ν n}

/-- **The image of `β_ν`** ((1.21)): the subalgebra of `End(1_ν)` generated by the dotted
counterclockwise bubbles (`bubbleSpan_eq_iSup`). -/
def bubbleSpan (ν : X) : Subalgebra k (End ((pres D Sc).obj (ob D ν []))) :=
  Algebra.adjoin k (bubGens cs ν)

/-- A closed 2-morphism on `1_ν` lies in the image of `β_ν`. -/
def IsBub (ν : X) (f : (pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν [])) : Prop :=
  (f : End ((pres D Sc).obj (ob D ν []))) ∈ bubbleSpan cs ν

theorem isBub_bubLs (i : I) (ν : X) (n : ℤ) : IsBub cs ν (bubLs cs i ν n) :=
  Algebra.subset_adjoin ⟨i, n, rfl⟩

namespace IsBub

variable {cs} {ν : X} {f g : (pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν [])}

theorem zero : IsBub cs ν 0 := (bubbleSpan cs ν).zero_mem

theorem id : IsBub cs ν (𝟙 _) := (bubbleSpan cs ν).one_mem

theorem add (hf : IsBub cs ν f) (hg : IsBub cs ν g) : IsBub cs ν (f + g) :=
  (bubbleSpan cs ν).add_mem hf hg

theorem neg (hf : IsBub cs ν f) : IsBub cs ν (-f) := (bubbleSpan cs ν).neg_mem hf

theorem smul (r : k) (hf : IsBub cs ν f) : IsBub cs ν (r • f) :=
  (bubbleSpan cs ν).smul_mem hf r

/-- The image of `β_ν` is closed under composition. -/
theorem comp (hf : IsBub cs ν f) (hg : IsBub cs ν g) : IsBub cs ν (f ≫ g) :=
  (bubbleSpan cs ν).mul_mem hg hf

theorem sum {ι : Type*} (s : Finset ι)
    {F : ι → ((pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν []))}
    (h : ∀ a ∈ s, IsBub cs ν (F a)) : IsBub cs ν (∑ a ∈ s, F a) :=
  (bubbleSpan cs ν).sum_mem h

end IsBub

theorem id_mem_subalgebra {ν : X} (S : Subalgebra k (End ((pres D Sc).obj (ob D ν [])))) :
    𝟙 ((pres D Sc).obj (ob D ν [])) ∈ S :=
  S.one_mem

theorem comp_mem_subalgebra {ν : X} (S : Subalgebra k (End ((pres D Sc).obj (ob D ν []))))
    {f g : (pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν [])} (hf : (f : End _) ∈ S)
    (hg : (g : End _) ∈ S) :
    (f ≫ g : End _) ∈ S :=
  S.mul_mem (show (g : End _) ∈ S from hg) (show (f : End _) ∈ S from hf)

/-! ## Clockwise and counterclockwise bubbles generate each other -/

/-- A subalgebra containing the counterclockwise bubbles of colour `i` contains the clockwise
ones (the infinite Grassmannian relation, solved for the clockwise bubble). -/
theorem bubRs_mem_of_bubLs {ν : X} (S : Subalgebra k (End ((pres D Sc).obj (ob D ν []))))
    (i : I) (h : ∀ n, (bubLs cs i ν n : End _) ∈ S) (n : ℤ) : (bubRs cs i ν n : End _) ∈ S := by
  rcases lt_or_ge n 0 with hn | hn
  · rw [bubRs_neg cs i ν hn]; exact S.zero_mem
  obtain ⟨t, rfl⟩ := Int.eq_ofNat_of_zero_le hn
  induction t using Nat.strong_induction_on with
  | _ t IH =>
  rcases Nat.eq_zero_or_pos t with rfl | ht
  · rw [Nat.cast_zero, bubRs_zero]; exact S.smul_mem (id_mem_subalgebra S) _
  have K := bubble_key cs i ν t ht
  rw [sum_range_succ', Nat.cast_zero, isg_zero, one_smul, sub_zero, bubLs_zero,
    Linear.comp_smul, Category.comp_id, add_eq_zero_iff_eq_neg] at K
  have hmem : ((cs.c ν i : k) • bubRs cs i ν t : End _) ∈ S := by
    rw [← neg_neg ((cs.c ν i : k) • bubRs cs i ν t), ← K]
    refine S.neg_mem (S.sum_mem fun r hr => S.smul_mem (comp_mem_subalgebra S ?_ (h _)) _)
    rw [mem_range] at hr
    have e : (t : ℤ) - ((r + 1 : ℕ) : ℤ) = ((t - (r + 1) : ℕ) : ℤ) := by push_cast; omega
    rw [e]
    exact IH _ (by omega) (by omega)
  have := S.smul_mem hmem (↑(cs.c ν i)⁻¹ : k)
  rwa [smul_smul, Units.inv_mul, one_smul] at this

/-- A subalgebra containing the clockwise bubbles of colour `i` contains the counterclockwise
ones. -/
theorem bubLs_mem_of_bubRs {ν : X} (S : Subalgebra k (End ((pres D Sc).obj (ob D ν []))))
    (i : I) (h : ∀ n, (bubRs cs i ν n : End _) ∈ S) (n : ℤ) : (bubLs cs i ν n : End _) ∈ S := by
  rcases lt_or_ge n 0 with hn | hn
  · rw [bubLs_neg cs i ν hn]; exact S.zero_mem
  obtain ⟨t, rfl⟩ := Int.eq_ofNat_of_zero_le hn
  induction t using Nat.strong_induction_on with
  | _ t IH =>
  rcases Nat.eq_zero_or_pos t with rfl | ht
  · rw [Nat.cast_zero, bubLs_zero]; exact S.smul_mem (id_mem_subalgebra S) _
  have K := bubble_key cs i ν t ht
  rw [sum_range_succ, sub_self, bubRs_zero, Linear.smul_comp, Category.id_comp, smul_smul,
    add_eq_zero_iff_eq_neg'] at K
  have hmem : ((isg k (D.parity i) t * (↑(cs.c ν i)⁻¹ : k)) • bubLs cs i ν t : End _) ∈ S := by
    rw [K]
    refine S.neg_mem (S.sum_mem fun r hr => S.smul_mem (comp_mem_subalgebra S (h _) ?_) _)
    rw [mem_range] at hr
    exact IH r hr (by omega)
  have := S.smul_mem hmem ((cs.c ν i : k) * isg k (D.parity i) t)
  rwa [smul_smul, show (cs.c ν i : k) * isg k (D.parity i) t *
      (isg k (D.parity i) t * (↑(cs.c ν i)⁻¹ : k)) = 1 by
    rw [mul_assoc, ← mul_assoc (isg k _ _), isg_mul_self, one_mul, Units.mul_inv],
    one_smul] at this

theorem isBub_bubRs (i : I) (ν : X) (n : ℤ) : IsBub cs ν (bubRs cs i ν n) :=
  bubRs_mem_of_bubLs cs _ i (isBub_bubLs cs i ν) n

/-- The clockwise bubbles generate the image of `β_ν` as well. -/
theorem bubbleSpan_eq_adjoin_bubRs (ν : X) :
    bubbleSpan cs ν = Algebra.adjoin k {f : End _ | ∃ i n, f = bubRs cs i ν n} := by
  apply le_antisymm
  · refine Algebra.adjoin_le ?_
    rintro _ ⟨i, n, rfl⟩
    exact bubLs_mem_of_bubRs cs _ i (fun m => Algebra.subset_adjoin
      (show (bubRs cs i ν m : End _) ∈ {f : End _ | ∃ i n, f = bubRs cs i ν n} from ⟨i, m, rfl⟩)) n
  · refine Algebra.adjoin_le ?_
    rintro _ ⟨i, n, rfl⟩
    exact isBub_bubRs cs i ν n

/-- Every dotted counterclockwise bubble, fake bubbles (`n < 0`) included. -/
theorem isBub_bubL (i : I) (ν : X) (n : ℤ) : IsBub cs ν (bubL cs i ν n) := by
  have := isBub_bubLs cs i ν (n - D.h i ν + 1)
  rwa [bubLs, show n - D.h i ν + 1 + D.h i ν - 1 = n by ring] at this

/-- Every dotted clockwise bubble, fake bubbles included. -/
theorem isBub_bubR (i : I) (ν : X) (n : ℤ) : IsBub cs ν (bubR cs i ν n) := by
  have := isBub_bubRs cs i ν (n + D.h i ν + 1)
  rwa [bubRs, show n + D.h i ν + 1 - D.h i ν - 1 = n by ring] at this

/-- The odd bubble (2.18). -/
theorem isBub_oddBubble (i : I) (ν : X) : IsBub cs ν (oddBubble cs i ν) := by
  unfold oddBubble
  split_ifs
  · exact (isBub_bubL cs i ν _).smul _
  · exact (isBub_bubR cs i ν _).smul _

/-! ## The image of `β_ν` -/

theorem zmod2_eq_one_of_ne_zero {a : ZMod 2} (h : a ≠ 0) : a = 1 := by
  revert a; decide

/-- The range of `β_{ν;i}` ((1.19) for even `i`, (1.20) for odd `i`). -/
def betaRange (i : I) (ν : X) : Subalgebra k (End ((pres D Sc).obj (ob D ν []))) :=
  if h : D.parity i = 0 then (beta cs i ν h).range
  else (betaD cs i ν (zmod2_eq_one_of_ne_zero h)).range

theorem isBub_beta (i : I) (ν : X) (hi : D.parity i = 0) (x : Sym k) :
    IsBub cs ν (beta cs i ν hi x) := by
  induction x using MvPolynomial.induction_on with
  | C a => rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]; exact (bubbleSpan cs ν).algebraMap_mem a
  | add p q hp hq => rw [map_add]; exact (bubbleSpan cs ν).add_mem hp hq
  | mul_X p n hp =>
    rw [map_mul, beta_X, betaGen]
    exact (bubbleSpan cs ν).mul_mem hp ((isBub_bubLs cs i ν _).smul _)

theorem isBub_betaD (i : I) (ν : X) (hi : D.parity i = 1) (x : SymD k) :
    IsBub cs ν (betaD cs i ν hi x) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective k _ x
  rw [betaD_mk]
  induction p using MvPolynomial.induction_on with
  | C a => rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]; exact (bubbleSpan cs ν).algebraMap_mem a
  | add p q hp hq => rw [map_add]; exact (bubbleSpan cs ν).add_mem hp hq
  | mul_X p o hp =>
    rw [map_mul, betaDPoly_X]
    refine (bubbleSpan cs ν).mul_mem hp ?_
    rcases o with _ | n
    · exact isBub_oddBubble cs i ν
    · exact (isBub_bubLs cs i ν _).smul _

theorem betaRange_le (i : I) (ν : X) : betaRange cs i ν ≤ bubbleSpan cs ν := by
  unfold betaRange
  split_ifs with h
  · rintro _ ⟨x, rfl⟩; exact isBub_beta cs i ν h x
  · rintro _ ⟨x, rfl⟩; exact isBub_betaD cs i ν _ x

theorem bubLs_mem_betaRange (i : I) (ν : X) (n : ℤ) :
    (bubLs cs i ν n : End _) ∈ betaRange cs i ν := by
  rcases lt_or_ge n 0 with hn | hn
  · rw [bubLs_neg cs i ν hn]; exact (betaRange cs i ν).zero_mem
  obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le hn
  unfold betaRange
  split_ifs with h
  · rw [eq_5_1_even cs i ν h m]
    exact (beta cs i ν h).range.smul_mem (AlgHom.mem_range_self (beta cs i ν h) _) _
  · have h1 := zmod2_eq_one_of_ne_zero h
    obtain ⟨r, rfl | rfl⟩ := Nat.even_or_odd' m
    · rw [show ((2 * r : ℕ) : ℤ) = 2 * (r : ℤ) by push_cast; ring, eq_5_1_odd_even cs i ν h1 r]
      exact (betaD cs i ν _).range.smul_mem (AlgHom.mem_range_self (betaD cs i ν _) _) _
    · rw [show ((2 * r + 1 : ℕ) : ℤ) = 2 * (r : ℤ) + 1 by push_cast; ring,
        eq_5_1_odd_odd cs i ν h1 r]
      exact (betaD cs i ν _).range.smul_mem (AlgHom.mem_range_self (betaD cs i ν _) _) _

/-- **The image of `β_ν`** is the subalgebra generated by the images of the `β_{ν;i}`, and it is
`bubbleSpan`. -/
theorem bubbleSpan_eq_iSup (ν : X) : bubbleSpan cs ν = ⨆ i, betaRange cs i ν := by
  apply le_antisymm
  · refine Algebra.adjoin_le ?_
    rintro _ ⟨i, n, rfl⟩
    exact (le_iSup (fun i => betaRange cs i ν) i) (bubLs_mem_betaRange cs i ν n)
  · exact iSup_le fun i => betaRange_le cs i ν

end OddMath.SKM
