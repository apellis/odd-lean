import OddMath.SKM.SpanLocal
import OddMath.SKM.GrassmannianCor
import OddMath.SKM.SpanBubbles

/-!
# Products of bubbles in the rightmost region

Infrastructure for J. Brundan, A. P. Ellis, *Super Kac–Moody 2-categories*, arXiv:1701.04133v2,
Theorem 8.1, whose proof the paper omits, referring to M. Khovanov, A. Lauda, *A categorification
of quantum `sl(n)`*, arXiv:0807.3250v1, Proposition 3.11. In the spanning argument the closed
crossingless pieces of a diagram are products of dotted bubbles; this file records them as
elements of `End(1_ν)` and places them in the rightmost region of a word.

* `IsBubbleProd cs ν β`: `β` is a composite of the bubbles `bubL`, `bubR` (Definition 2.3, (2.13)–
  (2.16)) and odd bubbles (2.18) at the weight `ν`; they are homogeneous elements of
  `bubbleSpan cs ν` (`IsBubbleProd.isBub`, `OddMath.SKM.SpanBubbles`). Products of
  bubbles are closed under composition (`IsBubbleProd.comp`), homogeneous
  (`IsBubbleProd.exists_mem`) and crossingless (`IsBubbleProd.mem_leL`).
* `bubAt μ v β`: `β ∈ End(1_μ)` placed to the right of the strands `v`. It is compatible with
  composition (`bubAt_comp`) and supercommutes with homogeneous 2-morphisms (`comp_bubAt`,
  the super interchange law (1.3)).
-/

noncomputable section

namespace OddMath.SKM

open CategoryTheory StringDiagrams Presentation

universe u v w

variable {I : Type u} {X : Type v} [AddCommGroup X] {D : Datum I X} {k : Type w} [CommRing k]
  {Sc : Scalars D k} (cs : CScalars Sc)

/-! ## Products of bubbles -/

/-- `β ∈ End(1_ν)` is a composite of dotted bubbles `bubL`, `bubR` and odd bubbles. -/
inductive IsBubbleProd (ν : X) :
    ((pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν [])) → Prop
  | id : IsBubbleProd ν (𝟙 _)
  | bubL {β} (i : I) (n : ℤ) : IsBubbleProd ν β → IsBubbleProd ν (β ≫ bubL cs i ν n)
  | bubR {β} (i : I) (n : ℤ) : IsBubbleProd ν β → IsBubbleProd ν (β ≫ bubR cs i ν n)
  | odd {β} (i : I) : IsBubbleProd ν β → IsBubbleProd ν (β ≫ oddBubble cs i ν)

namespace IsBubbleProd

variable {cs}

theorem comp {ν : X} {β γ : (pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν [])}
    (hβ : IsBubbleProd cs ν β) (hγ : IsBubbleProd cs ν γ) : IsBubbleProd cs ν (β ≫ γ) := by
  induction hγ with
  | id => rwa [Category.comp_id]
  | bubL i n _ ih => rw [← Category.assoc]; exact ih.bubL i n
  | bubR i n _ ih => rw [← Category.assoc]; exact ih.bubR i n
  | odd i _ ih => rw [← Category.assoc]; exact ih.odd i

theorem of_bubL (ν : X) (i : I) (n : ℤ) : IsBubbleProd cs ν (OddMath.SKM.bubL cs i ν n) := by
  simpa using (IsBubbleProd.id (cs := cs) (ν := ν)).bubL i n

theorem of_bubR (ν : X) (i : I) (n : ℤ) : IsBubbleProd cs ν (OddMath.SKM.bubR cs i ν n) := by
  simpa using (IsBubbleProd.id (cs := cs) (ν := ν)).bubR i n

theorem of_oddBubble (ν : X) (i : I) : IsBubbleProd cs ν (oddBubble cs i ν) := by
  simpa using (IsBubbleProd.id (cs := cs) (ν := ν)).odd i

/-- A product of bubbles lies in the subalgebra generated by the bubbles. -/
theorem isBub {ν : X} {β : (pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν [])}
    (hβ : IsBubbleProd cs ν β) : IsBub cs ν β := by
  induction hβ with
  | id => exact IsBub.id
  | bubL i n _ ih => exact ih.comp (isBub_bubL cs i ν n)
  | bubR i n _ ih => exact ih.comp (isBub_bubR cs i ν n)
  | odd i _ ih => exact ih.comp (isBub_oddBubble cs i ν)

/-- A product of bubbles is homogeneous. -/
theorem exists_mem {ν : X} {β : (pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν [])}
    (hβ : IsBubbleProd cs ν β) : ∃ p, β ∈ closedPar D Sc ν p := by
  induction hβ with
  | id => exact ⟨0, by rw [← cl_nil]; exact cl_mem_closedPar (L := []) (show SChain [] [] [] from rfl) rfl⟩
  | bubL i n _ ih =>
    obtain ⟨p, hp⟩ := ih
    exact ⟨_, comp_mem_homPar hp (bubL_mem cs i ν n)⟩
  | bubR i n _ ih =>
    obtain ⟨p, hp⟩ := ih
    exact ⟨_, comp_mem_homPar hp (bubR_mem cs i ν n)⟩
  | odd i _ ih =>
    obtain ⟨p, hp⟩ := ih
    exact ⟨_, comp_mem_homPar hp (oddBubble_mem cs i ν)⟩

/-- A product of bubbles is a combination of crossingless diagrams. -/
theorem mem_leL {ν : X} {β : (pres D Sc).obj (ob D ν []) ⟶ (pres D Sc).obj (ob D ν [])}
    (hβ : IsBubbleProd cs ν β) : β ∈ LeL D Sc cs ν [] [] 0 := by
  induction hβ with
  | id => exact id_mem_leL cs ν [] 0
  | bubL i n _ ih => exact leL_comp0 cs ih (bubL_mem_leL cs ν i n)
  | bubR i n _ ih => exact leL_comp0 cs ih (bubR_mem_leL cs ν i n)
  | odd i _ ih => exact leL_comp0 cs ih (oddBubble_mem_leL cs ν i)

end IsBubbleProd

/-! ## Casts of boundary words -/

theorem wordCast_comp (μ : X) {s s' t t' r r' : List (Letter I)} (hs : s = s') (ht : t = t')
    (hr : r = r') (f : (pres D Sc).obj (ob D μ s) ⟶ (pres D Sc).obj (ob D μ t))
    (g : (pres D Sc).obj (ob D μ t) ⟶ (pres D Sc).obj (ob D μ r)) :
    wordCast μ hs hr (f ≫ g) = wordCast μ hs ht f ≫ wordCast μ ht hr g := by
  subst hs ht hr; rfl

theorem wordCast_xev (ν : X) {s t s' t' : List (Letter I)} (hs : s = s') (ht : t = t')
    (L : List (XLayer I)) : wordCast ν hs ht (xev cs ν s t L) = xev cs ν s' t' L := by
  subst hs ht; rfl

theorem wordCast_mem_leL {ν : X} {s t s' t' : List (Letter I)} (hs : s = s') (ht : t = t') {c : ℕ}
    {f : (pres D Sc).obj (ob D ν s) ⟶ (pres D Sc).obj (ob D ν t)}
    (hf : f ∈ LeL D Sc cs ν s t c) : wordCast ν hs ht f ∈ LeL D Sc cs ν s' t' c := by
  subst hs ht; exact hf

/-! ## Bubbles in the rightmost region -/

variable (D Sc) in
/-- `β ∈ End(1_μ)` placed to the right of the strands `v`. -/
def bubAt (μ : X) (v : List (Letter I)) :
    ((pres D Sc).obj (ob D μ []) ⟶ (pres D Sc).obj (ob D μ [])) →ₗ[k]
      ((pres D Sc).obj (ob D μ v) ⟶ (pres D Sc).obj (ob D μ v)) :=
  (wordCast μ (by simp) (by simp)).comp (plcL D Sc μ v [] [] [])

theorem bubAt_cl (μ : X) (v : List (Letter I)) (M : List (LayerData I)) :
    bubAt D Sc μ v (cl D Sc μ [] [] M) = cl D Sc μ v v (M.map (whL v [])) := by
  dsimp only [bubAt, LinearMap.comp_apply]
  erw [plcL_cl D Sc μ v [] [] [] M, wordCast_cl]

theorem bubAt_id (μ : X) (v : List (Letter I)) : bubAt D Sc μ v (𝟙 _) = 𝟙 _ := by
  rw [← cl_nil, bubAt_cl, List.map_nil, cl_nil]

theorem bubAt_comp (μ : X) (v : List (Letter I))
    (β γ : (pres D Sc).obj (ob D μ []) ⟶ (pres D Sc).obj (ob D μ [])) :
    bubAt D Sc μ v (β ≫ γ) = bubAt D Sc μ v β ≫ bubAt D Sc μ v γ := by
  dsimp only [bubAt, LinearMap.comp_apply]
  erw [plcL_comp μ v [] β γ]
  exact wordCast_comp μ _ _ _ _ _

theorem cl_mem_homPar' (μ : X) (s t : List (Letter I)) (L : List (LayerData I)) :
    cl D Sc μ s t L ∈ homPar D Sc μ s t (parsum D L) := by
  by_cases h : SChain s L t
  · exact cl_mem_homPar h rfl
  · rw [cl_of_not h]; exact Submodule.zero_mem _

/-- **Super interchange with a closed 2-morphism in the rightmost region.** -/
theorem comp_bubAt {μ : X} {s t : List (Letter I)} {p q : ZMod 2}
    {f : (pres D Sc).obj (ob D μ s) ⟶ (pres D Sc).obj (ob D μ t)}
    {β : (pres D Sc).obj (ob D μ []) ⟶ (pres D Sc).obj (ob D μ [])}
    (hf : f ∈ homPar D Sc μ s t p) (hβ : β ∈ closedPar D Sc μ q) :
    f ≫ bubAt D Sc μ t β = zsign k (p * q) • (bubAt D Sc μ s β ≫ f) := by
  rw [closedPar_eq] at hβ
  refine homPar_induction₂ (P := fun f β =>
      f ≫ bubAt D Sc μ t β = zsign k (p * q) • (bubAt D Sc μ s β ≫ f))
    (fun L M hL hp hM hq => ?_) (fun g => by simp) (fun f => by simp)
    (fun f₁ f₂ g h₁ h₂ => by rw [Preadditive.add_comp, Preadditive.comp_add, h₁, h₂, smul_add])
    (fun f g₁ g₂ h₁ h₂ => by
      rw [map_add, map_add, Preadditive.comp_add, Preadditive.add_comp, h₁, h₂, smul_add])
    (fun a f g h => by rw [Linear.smul_comp, Linear.comp_smul, h, smul_comm])
    (fun a f g h => by
      rw [map_smul, map_smul, Linear.comp_smul, Linear.smul_comp, h, smul_comm]) hf hβ
  rw [bubAt_cl, bubAt_cl]
  have hMt : SChain t (M.map (whL t [])) t := by simpa using hM.whisk t []
  have hMs : SChain s (M.map (whL s [])) s := by simpa using hM.whisk s []
  rw [cl_comp hL hMt, cl_comp hMs hL]
  have E := cl_interchange (D := D) (Sc := Sc) (μ := μ) (S := s) (T := t) [] [] hL hM
  simp only [List.nil_append, List.append_nil, map_whL_nil_nil, hp, hq] at E
  exact E

theorem bubAt_mem_leL (μ : X) (v : List (Letter I)) {c : ℕ}
    {β : (pres D Sc).obj (ob D μ []) ⟶ (pres D Sc).obj (ob D μ [])}
    (hβ : β ∈ LeL D Sc cs μ [] [] c) : bubAt D Sc μ v β ∈ LeL D Sc cs μ v v c :=
  wordCast_mem_leL cs _ _ (plcL_leL cs (μ := μ) (u := v) (v := []) hβ)

end OddMath.SKM
