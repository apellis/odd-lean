import OddMath.Frontier.EQFunctorRing
import OddMath.Frontier.EQBorelPresentation
import OddMath.Frontier.EQZabBlocks
import DG.Algebra.TensorProduct

/-!
# `OΛ_{a,b}` is the graded tensor product `OΛ_a ⊗ OΛ_b`

Source: A. P. Ellis, Y. Qi, *The differential graded odd nilHecke algebra*, arXiv:1504.01712v2,
§4.3.1 and §4.4 (printed numbering): `OΛ_{a,b} := OΛ_a ⊗ OΛ_b`, the tensor product of dg superalgebras
(Koszul sign rule for the product, `d(f ⊗ g) = d f ⊗ g + (-1)^{|f|} f ⊗ d g`).

The library models `OΛ_{a,b}` as the dg subring `EQFunctor.osymABDG a b = OΛ_a ⊠ OΛ_b` of `OPol_{a+b}`,
generated by the odd elementary polynomials in the first `a` variables `x` and the last `b`
variables `y`. Here it is identified with the graded tensor product `osymDG a ᵍ⊗[ℤ] osymDG b` of
dg rings of the `DG` library (`DG.GradedTensorProduct`, product
`(f ⊗ g)(f' ⊗ g') = (-1)^{|g||f'|} f f' ⊗ g g'`):

* `inclY_mul_inclX_of_mem`: for `u` of degree `i` in `OPol_a` and `g` of degree `j` in `OPol_b`,
  `g(y) u(x) = (-1)^{ij} u(x) g(y)` in `OPol_{a+b}`;
* `tensorToOsymAB a b : OΛ_a ⊗ OΛ_b →ᵈᵍ+* OΛ_{a,b}`, `f ⊗ g ↦ f(x) g(y)`, a morphism of dg rings;
* `tensorToOsymAB_bijective`, `tensorEquivOsymAB a b : OΛ_a ⊗ OΛ_b ≃ᵈᵍₐ[ℤ] OΛ_{a,b}`: it is an
  isomorphism of dg rings. Injectivity: `OPol_a ⊗ OPol_b → OPol_{a+b}` is bijective on monomials,
  and `OΛ_a ⊗ OΛ_b → OPol_a ⊗ OPol_b` is injective since all these `ℤ`-modules are torsion-free.
-/

namespace OddMath.Frontier.EQFunctor

open OddMath.SkewPolynomial (SkewPolynomial generator monomial)
open OddMath.Frontier.EQSkewDifferential
open OddMath.Frontier.EQZab (osymAB inclX inclY)
open DG
open scoped TensorProduct

noncomputable section

/-- The ring structure of `OPol`, preferred over the pointwise `Finsupp` structure. -/
local instance (priority := high) tensorRingNUNASemiring (m : ℕ) :
    NonUnitalNonAssocSemiring (SkewPolynomial m) :=
  @NonAssocSemiring.toNonUnitalNonAssocSemiring _
    (@Semiring.toNonAssocSemiring _ (OddMath.PbwL3.instSemiring m))
local instance (priority := high) tensorRingNUNARing (m : ℕ) :
    NonUnitalNonAssocRing (SkewPolynomial m) :=
  @NonAssocRing.toNonUnitalNonAssocRing _ (@Ring.toNonAssocRing _ (OddMath.PbwL3.instRing m))

variable {a b : ℕ}

/-! ## Gradings and signs in `OPol_{a+b}` -/

/-- A ring homomorphism `OPol_m → OPol_n` sending each generator to a homogeneous element of degree
`1` preserves the grading. -/
theorem ringHom_mem_grading_of_generator {m n : ℕ} (φ : SkewPolynomial m →+* SkewPolynomial n)
    (hφ : ∀ j, φ (generator j) ∈ grading n 1) {k : ℤ} {f : SkewPolynomial m}
    (hf : f ∈ grading m k) : φ f ∈ grading n k := by
  classical
  have hpow : ∀ (j : Fin m) (e : ℕ), φ (generator j ^ e) ∈ grading n e := by
    intro j e
    induction e with
    | zero => simpa using one_mem_grading' (n := n)
    | succ e ih =>
      rw [pow_succ, map_mul]
      simpa using mul_mem_grading' ih (hφ j)
  have hprod : ∀ {l : ℕ} (v : Fin l → SkewPolynomial m) (e : Fin l → ℤ),
      (∀ i, φ (v i) ∈ grading n (e i)) → φ (List.ofFn v).prod ∈ grading n (∑ i, e i) := by
    intro l
    induction l with
    | zero => intro v e _; simpa using one_mem_grading' (n := n)
    | succ l ih =>
      intro v e h
      rw [List.ofFn_succ, List.prod_cons, map_mul, Fin.sum_univ_succ]
      exact mul_mem_grading' (h 0) (ih _ _ fun i => h _)
  rw [← Finsupp.sum_single f, Finsupp.sum, map_sum]
  refine AddSubgroup.sum_mem _ fun e he => ?_
  have h := OddMath.Frontier.MonomialReversal.monomial_eq_smul_prod e (f e)
  change Finsupp.single e (f e) = _ at h
  rw [h, map_zsmul, ← hf e he]
  exact AddSubgroup.zsmul_mem _ (hprod _ (fun j => (e j : ℤ)) fun j => hpow j (e j)) _

theorem inclX_mem_grading {k : ℤ} {f : SkewPolynomial a} (hf : f ∈ grading a k) :
    inclX a b f ∈ grading (a+b) k :=
  ringHom_mem_grading_of_generator (inclX a b)
    (fun j => by rw [EQZab.inclX_generator]; exact generator_mem_grading _) hf

theorem inclY_mem_grading {k : ℤ} {f : SkewPolynomial b} (hf : f ∈ grading b k) :
    inclY a b f ∈ grading (a+b) k :=
  ringHom_mem_grading_of_generator (inclY a b)
    (fun j => by rw [EQZab.inclY_generator]; exact generator_mem_grading _) hf

theorem pow_parityInv_generator (n : ℕ) (j : Fin b) :
    (parityInv b ^ n) (generator j) = ((-1 : ℤ) ^ n) • generator j := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ']
    change parityInv b ((parityInv b ^ n) (generator j)) = _
    rw [ih, map_zsmul, parityInv_generator, smul_neg, pow_succ', neg_one_mul, neg_smul]

theorem pow_parityInv_of_mem (n : ℕ) {j : ℤ} {g : SkewPolynomial b} (hg : g ∈ grading b j) :
    (parityInv b ^ n) g = ((koszulSign j : ℤ) ^ n) • g := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ']
    change parityInv b ((parityInv b ^ n) g) = _
    rw [ih, map_zsmul, parityInv_of_mem hg, smul_smul, pow_succ]

theorem koszulSign_eq_neg_one_pow_natAbs (i : ℤ) : (koszulSign i : ℤ) = (-1 : ℤ) ^ i.natAbs := by
  rw [← Int.coe_negOnePow_natCast, Int.natCast_natAbs, Int.negOnePow_abs]

/-- For `u` of degree `i`, `g(y) u(x) = u(x) (ι^{|i|} g)(y)` for every `g`. -/
theorem inclY_mul_inclX_pow_parityInv {i : ℤ} {u : SkewPolynomial a} (hu : u ∈ grading a i)
    (g : SkewPolynomial b) :
    inclY a b g * inclX a b u = inclX a b u * inclY a b ((parityInv b ^ i.natAbs) g) := by
  induction g using induction_generator with
  | hgen j =>
    rw [EQBorel.inclY_generator_mul_inclX, parityInv_of_mem hu, pow_parityInv_generator,
      map_zsmul, map_zsmul, smul_mul_assoc, mul_smul_comm, koszulSign_eq_neg_one_pow_natAbs]
  | h0 => rw [map_zero, map_zero, map_zero, EQBorel.sp_zero_mul, EQBorel.sp_mul_zero]
  | h1 => rw [map_one, map_one, map_one, one_mul, mul_one]
  | hadd f g hf hg => rw [map_add, map_add, map_add, add_mul, hf, hg, mul_add]
  | hneg f hf => rw [map_neg, map_neg, map_neg, neg_mul, hf, mul_neg]
  | hmul f g hf hg =>
    rw [map_mul, map_mul, map_mul, EQBorel.sp_mul_assoc, hg, ← EQBorel.sp_mul_assoc, hf,
      EQBorel.sp_mul_assoc]

/-- **Block supercommutation**: for `u ∈ OPol_a` of degree `i` and `g ∈ OPol_b` of degree `j`,
`g(y) u(x) = (-1)^{ij} u(x) g(y)` in `OPol_{a+b}`. -/
theorem inclY_mul_inclX_of_mem {i j : ℤ} {u : SkewPolynomial a} (hu : u ∈ grading a i)
    {g : SkewPolynomial b} (hg : g ∈ grading b j) :
    inclY a b g * inclX a b u = (koszulSign (j * i) : ℤ) • (inclX a b u * inclY a b g) := by
  rw [inclY_mul_inclX_pow_parityInv hu, pow_parityInv_of_mem _ hg, map_zsmul, mul_smul_comm]
  congr 2
  rw [koszulSign_eq_neg_one_pow_natAbs, koszulSign_eq_neg_one_pow_natAbs, Int.natAbs_mul, pow_mul]

/-! ## The dg ring map `OΛ_a ⊗ OΛ_b → OΛ_{a,b}` -/

variable (a b)

/-- `OΛ_a → OPol_{a+b}`, `f ↦ f(x)`, as a ring homomorphism. -/
def osymToX : osymDG a →+* OPol (a+b) :=
  (OPol.equiv (a+b)).toRingHom.comp ((inclX a b).comp
    ((OPol.equiv a).symm.toRingHom.comp (SubringClass.subtype (osymDG a))))

/-- `OΛ_b → OPol_{a+b}`, `g ↦ g(y)`, as a ring homomorphism. -/
def osymToY : osymDG b →+* OPol (a+b) :=
  (OPol.equiv (a+b)).toRingHom.comp ((inclY a b).comp
    ((OPol.equiv b).symm.toRingHom.comp (SubringClass.subtype (osymDG b))))

variable {a b}

theorem osymToX_apply (f : osymDG a) :
    osymToX a b f = OPol.equiv (a+b) (inclX a b ((OPol.equiv a).symm f)) := rfl

theorem osymToY_apply (g : osymDG b) :
    osymToY a b g = OPol.equiv (a+b) (inclY a b ((OPol.equiv b).symm g)) := rfl

theorem osymToX_mem_grading {k : ℤ} {f : osymDG a} (hf : f ∈ DG.grading k) :
    osymToX a b f ∈ DG.grading (M := OPol (a+b)) k :=
  OPol.equiv_mem_grading_iff.mpr (inclX_mem_grading (OPol.equiv_mem_grading_iff.mp
    ((DGSubring.mem_grading_iff _).mp hf)))

theorem osymToY_mem_grading {k : ℤ} {g : osymDG b} (hg : g ∈ DG.grading k) :
    osymToY a b g ∈ DG.grading (M := OPol (a+b)) k :=
  OPol.equiv_mem_grading_iff.mpr (inclY_mem_grading (OPol.equiv_mem_grading_iff.mp
    ((DGSubring.mem_grading_iff _).mp hg)))

/-- The anticommutation hypothesis of `GradedTensorProduct.lift`. -/
theorem osymToX_mul_osymToY {i j : ℤ} (f : DGAlgebra.gradingSubmodule ℤ (osymDG a) i)
    (g : DGAlgebra.gradingSubmodule ℤ (osymDG b) j) :
    (osymToX a b).toIntAlgHom (f : osymDG a) * (osymToY a b).toIntAlgHom (g : osymDG b) =
      (-1 : ℤˣ) ^ (j * i) •
        ((osymToY a b).toIntAlgHom (g : osymDG b) * (osymToX a b).toIntAlgHom (f : osymDG a)) := by
  have hf : ((OPol.equiv a).symm (f : osymDG a) : SkewPolynomial a) ∈ grading a i :=
    OPol.equiv_mem_grading_iff.mp ((DGSubring.mem_grading_iff _).mp f.2)
  have hg : ((OPol.equiv b).symm (g : osymDG b) : SkewPolynomial b) ∈ grading b j :=
    OPol.equiv_mem_grading_iff.mp ((DGSubring.mem_grading_iff _).mp g.2)
  change osymToX a b f * osymToY a b g = koszulSign (j * i) • (osymToY a b g * osymToX a b f)
  rw [osymToX_apply, osymToY_apply, ← map_mul, ← map_mul, inclY_mul_inclX_of_mem hf hg, map_zsmul,
    Units.smul_def, smul_smul, ← Units.val_mul, Int.units_mul_self, Units.val_one, one_smul]

local notation "𝒜" => DGAlgebra.gradingSubmodule ℤ (osymDG a)
local notation "ℬ" => DGAlgebra.gradingSubmodule ℤ (osymDG b)

variable (a b) in
/-- `OΛ_a ⊗ OΛ_b → OPol_{a+b}`, `f ⊗ g ↦ f(x) g(y)`, an algebra map for the signed product. -/
def tensorToOPol : (𝒜 ᵍ⊗[ℤ] ℬ) →ₐ[ℤ] OPol (a+b) :=
  GradedTensorProduct.lift 𝒜 ℬ (osymToX a b).toIntAlgHom (osymToY a b).toIntAlgHom
    fun _ _ f g => osymToX_mul_osymToY f g

theorem tensorToOPol_tmul (f : osymDG a) (g : osymDG b) :
    tensorToOPol a b (f ᵍ⊗ₜ[ℤ] g) = osymToX a b f * osymToY a b g :=
  GradedTensorProduct.lift_tmul _ _ _ _ _ f g

theorem tensorToOPol_mem (x : 𝒜 ᵍ⊗[ℤ] ℬ) : tensorToOPol a b x ∈ osymABDG a b := by
  induction x using GradedTensorProduct.induction_on_tmul with
  | zero => rw [map_zero]; exact zero_mem _
  | tmul _ _ =>
    rename_i f _ g _
    rw [tensorToOPol_tmul]
    refine mul_mem (mem_osymABDG.mpr ?_) (mem_osymABDG.mpr ?_)
    · exact EQZab.inclX_mem (mem_osymDG.mp f.2)
    · exact EQZab.inclY_mem (mem_osymDG.mp g.2)
  | add x y hx hy => rw [map_add]; exact add_mem hx hy

theorem tensorToOPol_mem_grading {n : ℤ} {x : 𝒜 ᵍ⊗[ℤ] ℬ} (hx : x ∈ DG.grading n) :
    tensorToOPol a b x ∈ DG.grading (M := OPol (a+b)) n := by
  refine GradedTensorProduct.grading_induction 𝒜 ℬ hx
    (motive := fun x => tensorToOPol a b x ∈ DG.grading (M := OPol (a+b)) n)
    (by rw [map_zero]; exact zero_mem _) ?_ ?_
  · rintro i j f g rfl
    rw [tensorToOPol_tmul]
    exact DG.mul_mem_grading (osymToX_mem_grading f.2) (osymToY_mem_grading g.2)
  · intro x y hx hy
    rw [map_add]; exact add_mem hx hy

theorem osymToX_d (f : osymDG a) : osymToX a b (DG.d f) = DG.d (osymToX a b f) := by
  rw [osymToX_apply, osymToX_apply, OPol.d_equiv, DGSubring.coe_d, OPol.symm_d, EQZab.d_inclX]

theorem osymToY_d (g : osymDG b) : osymToY a b (DG.d g) = DG.d (osymToY a b g) := by
  rw [osymToY_apply, osymToY_apply, OPol.d_equiv, DGSubring.coe_d, OPol.symm_d, EQZab.d_inclY]

theorem tensorToOPol_d (x : 𝒜 ᵍ⊗[ℤ] ℬ) :
    tensorToOPol a b (DG.d x) = DG.d (tensorToOPol a b x) := by
  induction x using GradedTensorProduct.induction_on_tmul with
  | zero => rw [d_zero, map_zero, d_zero]
  | @tmul i j f hf g hg =>
    rw [GradedTensorProduct.d_tmul hf, map_add, Units.smul_def, map_zsmul, tensorToOPol_tmul,
      tensorToOPol_tmul, osymToX_d, osymToY_d, tensorToOPol_tmul,
      DG.d_mul (osymToX_mem_grading hf), Units.smul_def]
  | add x y hx hy => rw [d_add, map_add, hx, hy, map_add, d_add]

variable (a b) in
/-- **`OΛ_a ⊗ OΛ_b → OΛ_{a,b}`**, `f ⊗ g ↦ f(x) g(y)`, as a morphism of dg rings. -/
def tensorToOsymAB : (𝒜 ᵍ⊗[ℤ] ℬ) →ᵈᵍ+* osymABDG a b where
  __ := (tensorToOPol a b).toRingHom.codRestrict (osymABDG a b) tensorToOPol_mem
  map_mem' hx := (DGSubring.mem_grading_iff _).mpr (tensorToOPol_mem_grading hx)
  map_d' x := Subtype.ext (by
    change tensorToOPol a b (DG.d x) = DG.d (tensorToOPol a b x)
    exact tensorToOPol_d x)

@[simp]
theorem coe_tensorToOsymAB (x : 𝒜 ᵍ⊗[ℤ] ℬ) :
    ((tensorToOsymAB a b x : osymABDG a b) : OPol (a+b)) = tensorToOPol a b x := rfl

theorem coe_tensorToOsymAB_tmul (f : osymDG a) (g : osymDG b) :
    ((tensorToOsymAB a b (f ᵍ⊗ₜ[ℤ] g) : osymABDG a b) : OPol (a+b)) =
      osymToX a b f * osymToY a b g :=
  tensorToOPol_tmul f g

/-! ## Bijectivity -/

theorem tensorToOPol_surjective_onto {F : OPol (a+b)} (hF : F ∈ osymABDG a b) :
    ∃ x : 𝒜 ᵍ⊗[ℤ] ℬ, tensorToOPol a b x = F := by
  have hF' := mem_osymABDG.mp hF
  have key : ∀ G : SkewPolynomial (a+b), G ∈ osymAB a b →
      ∃ x : 𝒜 ᵍ⊗[ℤ] ℬ, tensorToOPol a b x = OPol.equiv (a+b) G := by
    intro G hG
    refine EQZab.osymAB_induction
      (P := fun G => ∃ x : 𝒜 ᵍ⊗[ℤ] ℬ, tensorToOPol a b x = OPol.equiv (a+b) G) ?_ ?_ ?_ ?_ ?_ ?_ ?_ hG
    · intro k
      refine ⟨(⟨OPol.equiv a (elementary a k), elementary_mem_osymDG k⟩ : osymDG a) ᵍ⊗ₜ[ℤ]
        (1 : osymDG b), ?_⟩
      rw [tensorToOPol_tmul, map_one, mul_one, osymToX_apply]
      rfl
    · intro k
      refine ⟨(1 : osymDG a) ᵍ⊗ₜ[ℤ]
        (⟨OPol.equiv b (elementary b k), elementary_mem_osymDG k⟩ : osymDG b), ?_⟩
      rw [tensorToOPol_tmul, map_one, one_mul, osymToY_apply]
      rfl
    · exact ⟨0, by rw [map_zero, map_zero]⟩
    · exact ⟨1, by rw [map_one, map_one]⟩
    · rintro f g ⟨x, hx⟩ ⟨y, hy⟩
      exact ⟨x + y, by rw [map_add, hx, hy, map_add]⟩
    · rintro f ⟨x, hx⟩
      exact ⟨-x, by rw [map_neg, hx, map_neg]⟩
    · rintro f g ⟨x, hx⟩ ⟨y, hy⟩
      exact ⟨x * y, by rw [map_mul, hx, hy, map_mul]⟩
  obtain ⟨x, hx⟩ := key _ hF'
  exact ⟨x, hx.trans (RingEquiv.apply_symm_apply _ F)⟩

theorem tensorToOsymAB_surjective : Function.Surjective (tensorToOsymAB a b) := by
  rintro ⟨F, hF⟩
  obtain ⟨x, hx⟩ := tensorToOPol_surjective_onto hF
  exact ⟨x, Subtype.ext hx⟩

variable (a b) in
/-- `OPol_a → OPol_{a+b}`, `f ↦ f(x)`. -/
def opolToX : OPol a →+* OPol (a+b) :=
  (OPol.equiv (a+b)).toRingHom.comp ((inclX a b).comp (OPol.equiv a).symm.toRingHom)

variable (a b) in
/-- `OPol_b → OPol_{a+b}`, `g ↦ g(y)`. -/
def opolToY : OPol b →+* OPol (a+b) :=
  (OPol.equiv (a+b)).toRingHom.comp ((inclY a b).comp (OPol.equiv b).symm.toRingHom)

variable (a b) in
/-- `OPol_a ⊗ OPol_b → OPol_{a+b}`, `f ⊗ g ↦ f(x) g(y)` (`ℤ`-linear). -/
def opolMul : OPol a ⊗[ℤ] OPol b →ₗ[ℤ] OPol (a+b) :=
  LinearMap.mul' ℤ (OPol (a+b)) ∘ₗ
    TensorProduct.map (opolToX a b).toIntAlgHom.toLinearMap (opolToY a b).toIntAlgHom.toLinearMap

theorem opolMul_tmul (f : OPol a) (g : OPol b) : opolMul a b (f ⊗ₜ g) = opolToX a b f * opolToY a b g :=
  rfl

variable (a b) in
/-- The splitting `OPol_{a+b} → OPol_a ⊗ OPol_b` of a monomial `x^α y^γ` into `x^α ⊗ y^γ`. -/
def opolSplit : OPol (a+b) →+ OPol a ⊗[ℤ] OPol b :=
  (Finsupp.liftAddHom fun δ : Fin (a+b) → ℕ =>
    (smulAddHom ℤ (OPol a ⊗[ℤ] OPol b)).flip
      (OPol.equiv a (monomial (fun i => δ (Fin.castAdd b i)) 1) ⊗ₜ
        OPol.equiv b (monomial (fun j => δ (Fin.natAdd a j)) 1))).comp
    (OPol.equiv (a+b)).symm.toAddMonoidHom

theorem opolSplit_single (δ : Fin (a+b) → ℕ) (c : ℤ) :
    opolSplit a b (OPol.equiv (a+b) (Finsupp.single δ c)) =
      c • (OPol.equiv a (monomial (fun i => δ (Fin.castAdd b i)) 1) ⊗ₜ
        OPol.equiv b (monomial (fun j => δ (Fin.natAdd a j)) 1)) := by
  change Finsupp.liftAddHom _ (Finsupp.single δ c) = _
  rw [Finsupp.liftAddHom_apply_single]
  rfl

theorem opolSplit_opolMul_single (α : Fin a → ℕ) (c : ℤ) (γ : Fin b → ℕ) (c' : ℤ) :
    opolSplit a b (opolMul a b (OPol.equiv a (Finsupp.single α c) ⊗ₜ
      OPol.equiv b (Finsupp.single γ c'))) =
        OPol.equiv a (Finsupp.single α c) ⊗ₜ OPol.equiv b (Finsupp.single γ c') := by
  have hα : (Finsupp.single α c : SkewPolynomial a) = c • monomial α 1 :=
    (Finsupp.smul_single_one α c).symm
  have hγ : (Finsupp.single γ c' : SkewPolynomial b) = c' • monomial γ 1 :=
    (Finsupp.smul_single_one γ c').symm
  have hprod : opolMul a b (OPol.equiv a (Finsupp.single α c) ⊗ₜ OPol.equiv b (Finsupp.single γ c'))
      = OPol.equiv (a+b) (Finsupp.single (Fin.append α γ) (c * c')) := by
    change OPol.equiv (a+b) (inclX a b (Finsupp.single α c)) *
      OPol.equiv (a+b) (inclY a b (Finsupp.single γ c')) = _
    rw [← map_mul, hα, hγ, map_zsmul, map_zsmul, smul_mul_assoc, mul_smul_comm, EQBlocks.inclX_mul_inclY_monomial,
      smul_smul, Finsupp.smul_single_one]
  rw [hprod, opolSplit_single]
  have h1 : (fun i => Fin.append α γ (Fin.castAdd b i)) = α := funext fun i => Fin.append_left α γ i
  have h2 : (fun j => Fin.append α γ (Fin.natAdd a j)) = γ := funext fun j => Fin.append_right α γ j
  rw [h1, h2, mul_smul, hα, hγ, map_zsmul, map_zsmul, ← TensorProduct.smul_tmul',
    TensorProduct.tmul_smul]

theorem opolSplit_opolMul (t : OPol a ⊗[ℤ] OPol b) : opolSplit a b (opolMul a b t) = t := by
  induction t using TensorProduct.inductionOn with
  | add x y hx hy => rw [map_add, map_add, hx, hy]
  | tmul f g =>
    obtain ⟨f, rfl⟩ := (OPol.equiv a).surjective f
    obtain ⟨g, rfl⟩ := (OPol.equiv b).surjective g
    induction f using Finsupp.induction_linear with
    | zero => rw [map_zero, TensorProduct.zero_tmul, map_zero, map_zero]
    | add f f' hf hf' => rw [map_add, TensorProduct.add_tmul, map_add, map_add, hf, hf']
    | single α c =>
      induction g using Finsupp.induction_linear with
      | zero => rw [map_zero, TensorProduct.tmul_zero, map_zero, map_zero]
      | add g g' hg hg' => rw [map_add, TensorProduct.tmul_add, map_add, map_add, hg, hg']
      | single γ c' => exact opolSplit_opolMul_single α c γ c'

theorem opolMul_injective : Function.Injective (opolMul a b) :=
  Function.LeftInverse.injective (g := opolSplit a b) opolSplit_opolMul

instance opol_isAddTorsionFree (n : ℕ) : IsAddTorsionFree (OPol n) where
  nsmul_right_injective k hk f g h := by
    refine (OPol.equiv n).symm.injective (Finsupp.ext fun δ => ?_)
    have := congrArg (fun F : OPol n => ((OPol.equiv n).symm F : SkewPolynomial n) δ) h
    rw [map_nsmul, map_nsmul, Finsupp.smul_apply, Finsupp.smul_apply, nsmul_eq_mul,
      nsmul_eq_mul] at this
    exact mul_left_cancel₀ (Int.natCast_ne_zero.mpr hk) this

instance osymDG_isAddTorsionFree (n : ℕ) : IsAddTorsionFree (osymDG n) where
  nsmul_right_injective _k hk _f _g h :=
    Subtype.ext (IsAddTorsionFree.nsmul_right_injective hk (congrArg Subtype.val h))

theorem tensorToOPol_eq (x : 𝒜 ᵍ⊗[ℤ] ℬ) :
    tensorToOPol a b x = opolMul a b (TensorProduct.map
      (SubringClass.subtype (osymDG a)).toAddMonoidHom.toIntLinearMap
      (SubringClass.subtype (osymDG b)).toAddMonoidHom.toIntLinearMap
      ((GradedTensorProduct.of ℤ 𝒜 ℬ).symm x)) := by
  induction x using GradedTensorProduct.induction_on_tmul with
  | zero => rw [map_zero, map_zero, map_zero, map_zero]
  | tmul _ _ =>
    rename_i f _ g _
    rw [tensorToOPol_tmul]
    rfl
  | add x y hx hy => rw [map_add, hx, hy, map_add, map_add, map_add]

theorem tensorToOPol_injective : Function.Injective (tensorToOPol a b) := by
  intro x y h
  rw [tensorToOPol_eq, tensorToOPol_eq] at h
  have hinj := TensorProduct.map_injective_of_flat_flat
    (SubringClass.subtype (osymDG a)).toAddMonoidHom.toIntLinearMap
    (SubringClass.subtype (osymDG b)).toAddMonoidHom.toIntLinearMap
    Subtype.val_injective Subtype.val_injective
  exact (GradedTensorProduct.of ℤ 𝒜 ℬ).symm.injective (hinj (opolMul_injective h))

theorem tensorToOsymAB_injective : Function.Injective (tensorToOsymAB a b) := fun _ _ h =>
  tensorToOPol_injective (congrArg Subtype.val h)

/-- **`OΛ_a ⊗ OΛ_b → OΛ_{a,b}` is bijective.** -/
theorem tensorToOsymAB_bijective : Function.Bijective (tensorToOsymAB a b) :=
  ⟨tensorToOsymAB_injective, tensorToOsymAB_surjective⟩

variable (a b) in
/-- **`OΛ_{a,b} ≅ OΛ_a ⊗ OΛ_b` as dg rings** (Ellis–Qi §4.3.1, §4.4): the graded tensor product of
dg rings `osymDG a ᵍ⊗[ℤ] osymDG b` is isomorphic to `OΛ_a ⊠ OΛ_b ⊆ OPol_{a+b}` by
`f ⊗ g ↦ f(x) g(y)`. -/
def tensorEquivOsymAB : (𝒜 ᵍ⊗[ℤ] ℬ) ≃ᵈᵍₐ[ℤ] osymABDG a b :=
  DGAlgEquiv.ofAlgEquiv
    (AlgEquiv.ofRingEquiv (f := RingEquiv.ofBijective (tensorToOsymAB a b).toRingHom
      tensorToOsymAB_bijective) fun m => by
        rw [eq_intCast (algebraMap ℤ (𝒜 ᵍ⊗[ℤ] ℬ)), eq_intCast (algebraMap ℤ (osymABDG a b)),
          map_intCast])
    (fun hx => (tensorToOsymAB a b).map_mem hx) (fun x => (tensorToOsymAB a b).map_d x)

theorem tensorEquivOsymAB_apply (x : 𝒜 ᵍ⊗[ℤ] ℬ) :
    tensorEquivOsymAB a b x = tensorToOsymAB a b x := rfl

end

