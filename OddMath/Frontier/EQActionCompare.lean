  simp only [map_add, map_neg, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12] at hk
  norm_num at hk

set_option linter.unusedSimpArgs false in
/-- **No isomorphism** (`a = b = 2`) for `OΛ_2 ⊗ OΛ_2` acting on `Z_{2,2}` through `1 × w₀`. -/
theorem no_indEquiv_yRev :
    ¬ ∃ e : TensorProductOver (Λ2 ᵍ⊗[ℤ] Λ2) (ZZ 0 0) (ZabT 0 0 (osymABEndo (yRevPerm (0 + 2) (0 + 2)) yRev_mem)) ≃ᵈᵍ[𝒪2 ᵍ⊗[ℤ] 𝒪2]
