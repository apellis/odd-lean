/-- The grade involution `x_i ↦ -x_i` does not commute with `d` (`d x = x²`): sign twists of the variables
do not give dg ring endomorphisms. -/
theorem parityInv_not_dg {N : ℕ} (j : Fin N) :
    d N (parityInv N (generator j)) ≠ parityInv N (d N (generator j)) := by
  rw [parityInv_generator, map_neg, d_generator, map_mul, parityInv_generator, neg_mul_neg]
  intro h
  apply OddMath.SkewPolynomial.generator_square_ne_zero j
  have h2 : (2 : ℤ) • (generator j * generator j : SkewPolynomial N) = (2 : ℤ) • 0 := by
    rw [smul_zero, two_smul]
    nth_rewrite 1 [← h]
    exact neg_add_cancel _
  exact eq_of_zsmul_eq two_ne_zero h2

end Witness

