theorem bigCheck_f102 : bigCheck 89 f102Lower [true, false, true, true, false, false, true] cert102 = true := by decide +kernel

/-- **The printed degree-102 polynomial is irreducible over `ℚ`.** -/
theorem f102_irreducible : Irreducible (f102.map (Int.castRingHom ℚ)) := by
  haveI : Fact (Nat.Prime 89) := ⟨by norm_num⟩
  rw [f102_split]
  exact irreducible_of_bigCheck 89 f102Lower [true, false, true, true, false, false, true] cert102 (by decide) (by decide +kernel)
    (by decide +kernel) (by unfold Bw; decide +kernel) bigCheck_f102

/-- **No complex root of the printed degree-102 polynomial is a root of unity.** -/
theorem f102_no_root_of_unity (z : ℂ) (hz : (f102.map (Int.castRingHom ℂ)).IsRoot z) :
    ¬ ∃ m, 0 < m ∧ z ^ m = 1 := by
  rintro ⟨m, hm0, hzm⟩
  obtain ⟨N, hN, hE⟩ := eq_cyclotomic_of_root_of_unity f102
    (by rw [f102_split]; exact monic_ofList_one _) f102_irreducible z hz m hm0 hzm
  have hv : eval 1 (f102.map (Int.castRingHom ℚ)) = 100320 := by
    rw [f102, eval_one_map_ofList]
    have : hornerL 1 f102L = 100320 := by decide +kernel
    rw [this]; norm_num
  rw [hE] at hv
  rcases cyclotomic_eval_one_cases N hN with ⟨-, h⟩ | ⟨ℓ, k, hℓ, rfl, h⟩ | h
  · rw [h] at hv; norm_num at hv
  · rw [h] at hv
    have hℓv : ℓ = 100320 := by exact_mod_cast hv
    subst hℓv
    norm_num at hℓ
  · rw [h] at hv; norm_num at hv

