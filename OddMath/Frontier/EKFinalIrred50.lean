set_option maxRecDepth 100000 in
theorem bigCheck_f50 : bigCheck 269 f50Lower [true, false, false, false, false, true, true, false, true] cert50 = true := by decide +kernel

/-- **The printed degree-50 polynomial is irreducible over `ℚ`.** -/
theorem f50_irreducible : Irreducible (f50.map (Int.castRingHom ℚ)) := by
  haveI : Fact (Nat.Prime 269) := ⟨by norm_num⟩
  rw [f50_split]
  exact irreducible_of_bigCheck 269 f50Lower [true, false, false, false, false, true, true, false, true] cert50 (by decide) (by decide +kernel)
    (by decide +kernel) (by unfold Bw; decide +kernel) bigCheck_f50

/-- **No complex root of the printed degree-50 polynomial is a root of unity.** -/
theorem f50_no_root_of_unity (z : ℂ) (hz : (f50.map (Int.castRingHom ℂ)).IsRoot z) :
    ¬ ∃ m, 0 < m ∧ z ^ m = 1 := by
  rintro ⟨m, hm0, hzm⟩
  obtain ⟨N, hN, hE⟩ := eq_cyclotomic_of_root_of_unity f50
    (by rw [f50_split]; exact monic_ofList_one _) f50_irreducible z hz m hm0 hzm
  have hv : eval 1 (f50.map (Int.castRingHom ℚ)) = 924 := by
    rw [f50, eval_one_map_ofList]
    have : hornerL 1 f50L = 924 := by decide +kernel
    rw [this]; norm_num
  rw [hE] at hv
  rcases cyclotomic_eval_one_cases N hN with ⟨-, h⟩ | ⟨ℓ, k, hℓ, rfl, h⟩ | h
  · rw [h] at hv; norm_num at hv
  · rw [h] at hv
    have hℓv : ℓ = 924 := by exact_mod_cast hv
    subst hℓv
    norm_num at hℓ
  · rw [h] at hv; norm_num at hv

