import OddMath.QuiverHecke.EnvelopeAlgebra
import OddMath.QuiverHecke.PairingRadical
import OddMath.QuiverHecke.GrothendieckPresentation
import OddMath.CoveringQuantum.Nondegenerate
import OddMath.CoveringQuantum.UDot.BaseChange

/-!
# Brundan–Ellis, Theorem 11.3: `γ̄ : f_𝒜 ≅ K₀(Ḣ_{q,π})`

Brundan–Ellis, arXiv:1701.04133v2, Theorem 11.3: the `ℒ`-algebra homomorphism
`γ̄ : f_𝒜 → K₀(Ḣ_{q,π})`, `θ_i^{(n)} ↦ [P(i^{(n)})]`, is an isomorphism. Here
`ℒ = ℤ[q, q⁻¹, π]/(π² - 1)`, `f_𝒜` is the `ℒ`-subalgebra of `f` over `𝕃 = ℚ(q)[π]/(π² - 1)`
generated by the divided powers `θ_i^{(n)} = θ_iⁿ / [n]^!_{q_i,π_i}` (`fA`), and `K₀(Ḣ_{q,π})`
carries the induction product (`KHop`, an `ℒ`-algebra by `KHop.algebra`).

The proof follows the paper and Khovanov–Lauda, arXiv:0803.4121v2, §3:

* `θ_i ↦ 1 ⊗ [i]` defines `γ̄_𝕃 : f_𝕃 → 𝕃 ⊗_ℒ K₀(Ḣ_{q,π})` (`gammaL`), since the classes of
  words satisfy the quantum Serre relations (`serre_words`); by Lemma 11.1
  (`wordCls_rep_dpCls`) it sends `θ_i^{(n)}` to `1 ⊗ [P(i^{(n)})]` (`gammaL_dpF`);
* `x ↦ 1 ⊗ x` is injective on `K₀(Ḣ_{q,π})` (`KHop.tmul_injective`), so `γ̄_𝕃` restricts to
  `γ̄ : f_𝒜 → K₀(Ḣ_{q,π})` (`gammaBar`);
* surjectivity: the image contains the shifted products of divided powers, which span
  (`gammaBar_surjective`, from `dpSpan_eq_top`);
* injectivity: after clearing denominators, a relation `∑ c_t [t] = 0` with `c_t ∈ ℒ` puts
  `∑ c_t θ_t` in the radical of the form (`mem_radical_of_wordSum_eq_zero`, Hill–Wang
  Proposition 6.8), which is the Serre ideal (`Coefficients.serreIdeal_eq_radical`)
  (`gammaL_injective`).

The last step uses the current proof of nondegeneracy (Theorem 10.1 in the form
`serreIdeal_eq_radical`), which assumes `I` finite and the datum bar-consistent; these are the
extra hypotheses of `theorem_11_3`. BE2's `K₀(Ḣ_{q,π})` is `⨁_n K₀(H_n)` via (11.2); here it is
`K₀` of `Ḣ_{q,π}` itself (`OddMath.QuiverHecke.Envelope`).
-/

noncomputable section

open CategoryTheory StringDiagrams LaurentPolynomial TensorProduct
open CategoryTheory.Idempotents OddMath.SKM.Summands
open OddMath.CoveringQuantum (RootDatum)

namespace OddMath.QuiverHecke

universe u v w

variable {I : Type u} {X : Type v} [AddCommGroup X] {K : Type w} [Field K]
  (Q : RootDatum I X) (Sc : SKM.Scalars Q.toSKM K) (hc : Sc.Homogeneous)

local notation "𝕃" => CoveringQuantum.Coefficients.Ring
local notation "ℒ" => LaurentPolynomial Zπ
local notation "KQ" => KHop Q.toSKM Sc Q.skmSymmetrizer hc

/-- `𝕃` as an `ℒ`-module through `Coefficients.algebraLaurent` (instance search does not find it,
since the two semiring structures on `ℒ` agree only up to unfolding). -/
@[reducible] def moduleRing : Module ℒ 𝕃 :=
  @Algebra.toModule _ _ _ _ CoveringQuantum.Coefficients.algebraLaurent

attribute [local instance high] moduleRing

/-- `f` over `𝕃 = ℚ(q)[π]/(π² - 1)`. -/
abbrev fL := Q.toSuperCartanDatum.serreF CoveringQuantum.Coefficients.q
  CoveringQuantum.Coefficients.pi

theorem wordCls_pow (i : I) (a : ℕ) :
    wordCls Q.toSKM Sc Q.skmSymmetrizer hc [i] ^ a =
      wordCls Q.toSKM Sc Q.skmSymmetrizer hc (List.replicate a i) := by
  induction a with
  | zero => exact (wordCls_nil _ _ _ _).symm
  | succ a ih => rw [pow_succ, ih, wordCls_mul, List.replicate_succ']

theorem ofLaurentHom_qUnit :
    CoveringQuantum.Coefficients.ofLaurentHom (SKM.K0Relations.qUnit 1 : ℒ) =
      (CoveringQuantum.Coefficients.q : 𝕃) := by
  change CoveringQuantum.Coefficients.ofLaurent (T 1) = _
  rw [CoveringQuantum.Coefficients.ofLaurent, eval₂_T, zpow_one]

/-- The images of the generators: `θ_i ↦ 1 ⊗ [i]`. -/
def gammaFreeL : CoveringQuantum.PreF 𝕃 I →ₐ[𝕃] 𝕃 ⊗[ℒ] KQ :=
  FreeAlgebra.lift 𝕃 fun i => (1 : 𝕃) ⊗ₜ wordCls Q.toSKM Sc Q.skmSymmetrizer hc [i]

theorem gammaFreeL_θ (i : I) :
    gammaFreeL Q Sc hc (CoveringQuantum.PreF.θ 𝕃 i) =
      (1 : 𝕃) ⊗ₜ wordCls Q.toSKM Sc Q.skmSymmetrizer hc [i] :=
  FreeAlgebra.lift_ι_apply _ _

theorem gammaFreeL_θ_pow (i : I) (a : ℕ) :
    gammaFreeL Q Sc hc (CoveringQuantum.PreF.θ 𝕃 i ^ a) =
      (1 : 𝕃) ⊗ₜ wordCls Q.toSKM Sc Q.skmSymmetrizer hc (List.replicate a i) := by
  rw [map_pow, gammaFreeL_θ]
  rw [Algebra.TensorProduct.tmul_pow]
  rw [one_pow, wordCls_pow]

theorem one_tmul_mul_one_tmul (x y : KQ) :
    ((1 : 𝕃) ⊗ₜ[ℒ] x) * ((1 : 𝕃) ⊗ₜ y) = (1 : 𝕃) ⊗ₜ (x * y) := by
  rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]

theorem gammaFreeL_serreTerm (i j : I) (a b : ℕ) :
    gammaFreeL Q Sc hc (CoveringQuantum.PreF.θ 𝕃 i ^ a * CoveringQuantum.PreF.θ 𝕃 j *
        CoveringQuantum.PreF.θ 𝕃 i ^ b) =
      (1 : 𝕃) ⊗ₜ wordCls Q.toSKM Sc Q.skmSymmetrizer hc
        (List.replicate a i ++ [j] ++ List.replicate b i) := by
  rw [map_mul, map_mul]
  simp only [gammaFreeL_θ_pow, gammaFreeL_θ, one_tmul_mul_one_tmul, wordCls_mul]

theorem ofLaurentHom_serreCoeff (i j : I) (r : ℕ) :
    CoveringQuantum.Coefficients.ofLaurentHom
        (Q.serreCoeff (SKM.K0Relations.qUnit 1) (C Zπ.π) i j r) =
      Q.serreCoeff CoveringQuantum.Coefficients.q CoveringQuantum.Coefficients.pi i j r :=
  CoveringQuantum.UDot.map_serreCoeff_eq CoveringQuantum.Coefficients.ofLaurentHom
    Q.toSuperCartanDatum (q := SKM.K0Relations.qUnit 1) (π := C Zπ.π) ofLaurentHom_qUnit
    CoveringQuantum.Coefficients.ofLaurent_C_pi i j r

theorem ofLaurent_smul_one_tmul (c : ℒ) (w : KQ) :
    CoveringQuantum.Coefficients.ofLaurentHom c • ((1 : 𝕃) ⊗ₜ[ℒ] w) = (1 : 𝕃) ⊗ₜ (c • w) := by
  calc _ = (CoveringQuantum.Coefficients.ofLaurentHom c • (1 : 𝕃)) ⊗ₜ[ℒ] w := rfl
    _ = (c • (1 : 𝕃)) ⊗ₜ[ℒ] w := by
      rw [smul_eq_mul, mul_one, CoveringQuantum.Coefficients.smul_one_eq_ofLaurent]
      rfl
    _ = _ := smul_tmul _ _ _

/-- **The quantum Serre relations hold in `𝕃 ⊗_ℒ K₀(Ḣ_{q,π})`** (`serre_words`). -/
theorem gammaFreeL_serreElt {i j : I} (h : i ≠ j) :
    gammaFreeL Q Sc hc (Q.serreElt CoveringQuantum.Coefficients.q
      CoveringQuantum.Coefficients.pi i j) = 0 := by
  have hM := SerreComplex.serreDeg_eq Q h
  have hw := serre_words (k := K) (D := Q.toSKM) (Sc := Sc) (sy := Q.skmSymmetrizer)
    (hc := hc) (i := i) (j := j) (M := Q.serreDeg i j) h hM
  rw [CoveringQuantum.SuperCartanDatum.serreElt, map_sum]
  calc _ = ∑ r ∈ Finset.range (Q.serreDeg i j + 1), (1 : 𝕃) ⊗ₜ[ℒ]
        (SerreComplex.serreC Q.skmSymmetrizer i j (Q.serreDeg i j) r •
          wordCls Q.toSKM Sc Q.skmSymmetrizer hc
            (List.replicate (Q.serreDeg i j - r) i ++ [j] ++ List.replicate r i)) := by
        refine Finset.sum_congr rfl fun r _ => ?_
        have hcr : Q.serreCoeff CoveringQuantum.Coefficients.q CoveringQuantum.Coefficients.pi
            i j r = CoveringQuantum.Coefficients.ofLaurentHom
              (SerreComplex.serreC Q.skmSymmetrizer i j (Q.serreDeg i j) r) := by
          rw [← SerreComplex.serreCoeff_eq, ofLaurentHom_serreCoeff]
        simp only [map_smul]
        simp only [gammaFreeL_serreTerm, hcr]
        exact ofLaurent_smul_one_tmul Q Sc hc _ _
    _ = 0 := (tmul_sum _ _ _).symm.trans ((congrArg _ hw).trans (tmul_zero _ _))

/-- `f_𝕃 → 𝕃 ⊗_ℒ K₀(Ḣ_{q,π})`, `θ_i ↦ 1 ⊗ [i]`. -/
def gammaL : fL Q →ₐ[𝕃] 𝕃 ⊗[ℒ] KQ :=
  RingQuot.liftAlgHom 𝕃 ⟨gammaFreeL Q Sc hc, fun _ _ h => by
    cases h with
    | serre i j hij => rw [gammaFreeL_serreElt Q Sc hc hij, map_zero]⟩

theorem gammaL_toSerreF (x : CoveringQuantum.PreF 𝕃 I) :
    gammaL Q Sc hc (Q.toSerreF CoveringQuantum.Coefficients.q CoveringQuantum.Coefficients.pi x) =
      gammaFreeL Q Sc hc x :=
  RingQuot.liftAlgHom_mkAlgHom_apply _ _ _ _

/-- The divided power `θ_i^{(n)} = θ_iⁿ / [n]^!_{q_i,π_i}` in `f_𝕃`. -/
def dpF (i : I) (n : ℕ) : fL Q :=
  Ring.inverse (CoveringQuantum.qpFact (Q.qi CoveringQuantum.Coefficients.q i)
    (Q.pii CoveringQuantum.Coefficients.pi i) n) •
    Q.toSerreF CoveringQuantum.Coefficients.q CoveringQuantum.Coefficients.pi
      (CoveringQuantum.PreF.θ 𝕃 i ^ n)

/-- **BE2 §11: `f_𝒜`**, the `ℒ`-subalgebra of `f_𝕃` generated by the divided powers. -/
def fA : Subalgebra ℒ (fL Q) := Algebra.adjoin ℒ (Set.range fun p : I × ℕ => dpF Q p.1 p.2)

theorem dpF_mem_fA (i : I) (n : ℕ) : dpF Q i n ∈ fA Q :=
  Algebra.subset_adjoin ⟨(i, n), rfl⟩

theorem ofLaurentHom_qpFact (i : I) (n : ℕ) :
    CoveringQuantum.Coefficients.ofLaurentHom
        (CoveringQuantum.qpFact (Q.qi (SKM.K0Relations.qUnit 1) i) (Q.pii (C Zπ.π) i) n) =
      CoveringQuantum.qpFact (Q.qi CoveringQuantum.Coefficients.q i)
        (Q.pii CoveringQuantum.Coefficients.pi i) n := by
  refine (CoveringQuantum.map_qpFact (q := Q.qi (SKM.K0Relations.qUnit 1) i) (π := Q.pii (C Zπ.π) i)
    CoveringQuantum.Coefficients.ofLaurentHom n).trans ?_
  congr 1
  · rw [CoveringQuantum.SuperCartanDatum.qi, CoveringQuantum.SuperCartanDatum.qi, map_pow]
    exact congrArg (· ^ Q.d i) (Units.ext ofLaurentHom_qUnit)
  · simp only [CoveringQuantum.SuperCartanDatum.pii, map_pow]
    exact congrArg (· ^ (Q.parity i).val) CoveringQuantum.Coefficients.ofLaurent_C_pi

variable (i : I) (n : ℕ)

/-- The class `[P(i^{(n)})]` in `K₀(Ḣ_{q,π})`. -/
abbrev dpCls : KQ := MulOpposite.op (hKarToKH Q.toSKM Sc Q.skmSymmetrizer hc
  (K₀.mk (dpObj Q.toSKM Sc Q.skmSymmetrizer hc i n)))

/-- **Lemma 11.1**: `[iⁿ] = [n]^!_{q_i,π_i} [P(i^{(n)})]`. -/
theorem wordCls_rep_dpCls :
    wordCls Q.toSKM Sc Q.skmSymmetrizer hc (List.replicate n i) =
      CoveringQuantum.qpFact (Q.qi (SKM.K0Relations.qUnit 1) i) (Q.pii (C Zπ.π) i) n •
        dpCls Q Sc hc i n := by
  rw [wordCls, ← hKarToKH_word, class_word_rep, hKarToKH_smul, SKM.K0Relations.root_qi]
  rfl

/-- `γ̄(θ_i^{(n)}) = 1 ⊗ [P(i^{(n)})]`. -/
theorem gammaL_dpF : gammaL Q Sc hc (dpF Q i n) = (1 : 𝕃) ⊗ₜ dpCls Q Sc hc i n := by
  set F := CoveringQuantum.qpFact (Q.qi CoveringQuantum.Coefficients.q i)
    (Q.pii CoveringQuantum.Coefficients.pi i) n
  have h1 : gammaL Q Sc hc (Q.toSerreF CoveringQuantum.Coefficients.q
      CoveringQuantum.Coefficients.pi (CoveringQuantum.PreF.θ 𝕃 i ^ n)) =
      F • ((1 : 𝕃) ⊗ₜ dpCls Q Sc hc i n) := by
    refine (gammaL_toSerreF Q Sc hc _).trans ((gammaFreeL_θ_pow Q Sc hc i n).trans ?_)
    refine (congrArg (TensorProduct.tmul ℒ (1 : 𝕃)) (wordCls_rep_dpCls Q Sc hc i n)).trans ?_
    refine (ofLaurent_smul_one_tmul Q Sc hc _ _).symm.trans ?_
    exact congrArg (· • ((1 : 𝕃) ⊗ₜ[ℒ] dpCls Q Sc hc i n)) (ofLaurentHom_qpFact Q i n)
  calc gammaL Q Sc hc (dpF Q i n) = Ring.inverse F • (F • ((1 : 𝕃) ⊗ₜ dpCls Q Sc hc i n)) :=
        (map_smul _ _ _).trans (congrArg _ h1)
    _ = _ := by
      have hF : Ring.inverse F * F = 1 := Ring.inverse_mul_cancel _
        (CoveringQuantum.Coefficients.qpFact_isUnit Q.toSuperCartanDatum i n)
      rw [smul_smul, hF]
      exact one_smul _ _

instance : IsScalarTower ℒ 𝕃 (𝕃 ⊗[ℒ] KQ) := TensorProduct.isScalarTower_left

theorem includeRight_injective :
    Function.Injective (Algebra.TensorProduct.includeRight : KQ →ₐ[ℒ] 𝕃 ⊗[ℒ] KQ) :=
  fun _ _ h => KHop.tmul_injective Q.toSKM Sc Q.skmSymmetrizer hc h

theorem fA_le_comap :
    fA Q ≤ Subalgebra.comap ((gammaL Q Sc hc).restrictScalars ℒ)
      (Algebra.TensorProduct.includeRight : KQ →ₐ[ℒ] 𝕃 ⊗[ℒ] KQ).range := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨⟨i, n⟩, rfl⟩
  exact ⟨dpCls Q Sc hc i n, (gammaL_dpF Q Sc hc i n).symm⟩

/-- **BE2 Theorem 11.3: `γ̄ : f_𝒜 → K₀(Ḣ_{q,π})`**, the `ℒ`-algebra homomorphism with
`1 ⊗ γ̄(x) = γ̄_𝕃(x)`. -/
def gammaBar : fA Q →ₐ[ℒ] KQ :=
  (AlgEquiv.ofInjective _ (includeRight_injective Q Sc hc)).symm.toAlgHom.comp
    ((((gammaL Q Sc hc).restrictScalars ℒ).comp (fA Q).val).codRestrict _
      fun x => fA_le_comap Q Sc hc x.2)

theorem one_tmul_gammaBar (x : fA Q) :
    (1 : 𝕃) ⊗ₜ[ℒ] gammaBar Q Sc hc x = gammaL Q Sc hc x := by
  have h := (AlgEquiv.ofInjective _ (includeRight_injective Q Sc hc)).apply_symm_apply
    ⟨_, fA_le_comap Q Sc hc x.2⟩
  exact congrArg Subtype.val h

theorem gammaFreeL_monomial (t : List I) :
    gammaFreeL Q Sc hc (CoveringQuantum.PreF.monomial 𝕃 t) =
      (1 : 𝕃) ⊗ₜ wordCls Q.toSKM Sc Q.skmSymmetrizer hc t := by
  induction t with
  | nil =>
    rw [CoveringQuantum.PreF.monomial_nil, map_one, wordCls_nil]
    rfl
  | cons a t ih =>
    simp only [CoveringQuantum.PreF.monomial_cons, map_mul, ih, gammaFreeL_θ,
      one_tmul_mul_one_tmul, wordCls_mul]
    rfl

theorem gammaL_wordSum (a : List I →₀ ℒ) :
    gammaL Q Sc hc (Q.toSerreF CoveringQuantum.Coefficients.q CoveringQuantum.Coefficients.pi
      (a.sum fun t r => CoveringQuantum.Coefficients.ofLaurentHom r •
        CoveringQuantum.PreF.monomial 𝕃 t)) =
      (1 : 𝕃) ⊗ₜ (a.sum fun t r => r • wordCls Q.toSKM Sc Q.skmSymmetrizer hc t) := by
  simp only [Finsupp.sum, map_sum, map_smul, gammaL_toSerreF, gammaFreeL_monomial,
    ofLaurent_smul_one_tmul]
  exact (tmul_sum _ _ _).symm

/-- Clearing denominators: every `𝕃`-combination of monomials is, up to a unit `β` of `𝕃` coming
from a nonzero element of `ℤ[q, q⁻¹]`, an `ℒ`-combination. -/
theorem exists_wordSum (c : List I →₀ 𝕃) :
    ∃ (b : ℒ) (_ : b ∈ CoveringQuantum.Coefficients.intDenominators) (a : List I →₀ ℒ),
      (a.sum fun t r => CoveringQuantum.Coefficients.ofLaurentHom r •
        CoveringQuantum.PreF.monomial 𝕃 t) =
      CoveringQuantum.Coefficients.ofLaurentHom b •
        (c.sum fun t r => r • CoveringQuantum.PreF.monomial 𝕃 t) := by
  have := CoveringQuantum.Coefficients.isLocalization
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (R := ℒ) (S := 𝕃)
    CoveringQuantum.Coefficients.intDenominators c.support c
  set β := CoveringQuantum.Coefficients.ofLaurentHom (b : ℒ)
  have hb' : ∀ t, ∃ r : ℒ, CoveringQuantum.Coefficients.ofLaurentHom r = β * c t := by
    intro t
    by_cases ht : t ∈ c.support
    · obtain ⟨r, hr⟩ := hb t ht
      exact ⟨r, hr.trans (Algebra.smul_def (R := ℒ) (A := 𝕃) _ _)⟩
    · refine ⟨0, ?_⟩
      rw [Finsupp.notMem_support_iff.1 ht, mul_zero, map_zero]
  choose a ha using hb'
  have ha0 : ∀ t, a t ≠ 0 → t ∈ c.support := by
    intro t h
    by_contra ht
    apply h
    apply CoveringQuantum.Coefficients.ofLaurent_injective
    rw [map_zero]
    exact (ha t).trans (by rw [Finsupp.notMem_support_iff.1 ht, mul_zero])
  refine ⟨b, b.2, Finsupp.onFinset c.support a ha0, ?_⟩
  rw [Finsupp.onFinset_sum _ (fun t => by rw [map_zero, zero_smul]), Finsupp.sum,
    Finset.smul_sum]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [ha t, mul_smul]

theorem wordSum_eq_zero {a : List I →₀ ℒ}
    (h : (a.sum fun t r => r • wordCls Q.toSKM Sc Q.skmSymmetrizer hc t) = 0) :
    (letI := GSKar.moduleLaurent K (HGr Q.toSKM Sc Q.skmSymmetrizer hc);
      (a.sum fun t r => r • K₀.mk (GSKar.of K (hObj Q.toSKM Sc Q.skmSymmetrizer hc t) 0 0))) =
      0 := by
  have h1 : MulOpposite.op (hKarToKH Q.toSKM Sc Q.skmSymmetrizer hc
      (letI := K₀.moduleLaurent K (HKar Q.toSKM Sc Q.skmSymmetrizer hc);
        a.sum fun t r => r • K₀.mk (word Q.toSKM Sc Q.skmSymmetrizer hc t))) =
      a.sum fun t r => r • wordCls Q.toSKM Sc Q.skmSymmetrizer hc t := by
    simp only [Finsupp.sum, map_sum, Finset.op_sum, hKarToKH_smul, hKarToKH_word]
    rfl
  have h2 := hKarToKH_injective (MulOpposite.op_injective (h1.trans (h.trans (by
    rw [map_zero, MulOpposite.op_zero]))))
  exact h2

theorem wordCls_sum_eq_zero {c : List I →₀ 𝕃} {β : 𝕃} {a : List I →₀ ℒ}
    (hsum : (a.sum fun t r => CoveringQuantum.Coefficients.ofLaurentHom r •
        CoveringQuantum.PreF.monomial 𝕃 t) =
      β • (c.sum fun t r => r • CoveringQuantum.PreF.monomial 𝕃 t))
    (hx : gammaL Q Sc hc (Q.toSerreF CoveringQuantum.Coefficients.q
      CoveringQuantum.Coefficients.pi (c.sum fun t r => r • CoveringQuantum.PreF.monomial 𝕃 t)) =
      0) :
    (a.sum fun t r => r • wordCls Q.toSKM Sc Q.skmSymmetrizer hc t) = 0 := by
  refine includeRight_injective Q Sc hc ((gammaL_wordSum Q Sc hc a).symm.trans ?_)
  refine (congrArg (fun z => gammaL Q Sc hc (Q.toSerreF CoveringQuantum.Coefficients.q
    CoveringQuantum.Coefficients.pi z)) hsum).trans ?_
  refine (congrArg (gammaL Q Sc hc) (map_smul _ _ _)).trans ((map_smul _ _ _).trans ?_)
  exact (congrArg (β • ·) hx).trans ((smul_zero _).trans (map_zero _).symm)

theorem eq_zero_of_ofLaurent_smul {b : ℒ} (hb : b ∈ CoveringQuantum.Coefficients.intDenominators)
    {x : fL Q} (h : CoveringQuantum.Coefficients.ofLaurentHom b • x = 0) : x = 0 := by
  have hu : IsUnit (CoveringQuantum.Coefficients.ofLaurentHom b) := by
    obtain ⟨p, hp, rfl⟩ := hb
    change IsUnit (CoveringQuantum.Coefficients.ofLaurent
      (CoveringQuantum.Coefficients.intToLaurent p))
    rw [CoveringQuantum.Coefficients.ofLaurent_intToLaurent]
    exact (IsUnit.mk0 _ (nonZeroDivisors.ne_zero (Submonoid.mem_comap.mp hp))).map _
  exact hu.smul_left_cancel.1 (h.trans (smul_zero _).symm)

theorem gammaBar_dpF :
    gammaBar Q Sc hc ⟨dpF Q i n, dpF_mem_fA Q i n⟩ = dpCls Q Sc hc i n :=
  includeRight_injective Q Sc hc ((one_tmul_gammaBar Q Sc hc _).trans (gammaL_dpF Q Sc hc i n))

/-- Homomorphisms out of `f_𝒜` are determined by their values on the divided powers. -/
theorem fA_algHom_ext {B : Type*} [Semiring B] [Algebra ℒ B] {φ ψ : fA Q →ₐ[ℒ] B}
    (h : ∀ i n, φ ⟨dpF Q i n, dpF_mem_fA Q i n⟩ = ψ ⟨dpF Q i n, dpF_mem_fA Q i n⟩) : φ = ψ := by
  ext ⟨x, hx⟩
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨⟨i, n⟩, rfl⟩ := hx
    exact h i n
  | algebraMap r => exact (φ.commutes r).trans (ψ.commutes r).symm
  | add x y hx' hy' hx hy =>
    change φ (⟨x, hx'⟩ + ⟨y, hy'⟩) = ψ (⟨x, hx'⟩ + ⟨y, hy'⟩)
    rw [map_add, map_add, hx, hy]
  | mul x y hx' hy' hx hy =>
    change φ (⟨x, hx'⟩ * ⟨y, hy'⟩) = ψ (⟨x, hx'⟩ * ⟨y, hy'⟩)
    rw [map_mul, map_mul, hx, hy]

section Surjective

omit [AddCommGroup X] in
theorem shift_inv_mul (m : ℤ) (s : ZMod 2) :
    (T (-m) * SKM.K0Relations.piCoeff s * (T m * SKM.K0Relations.piCoeff s) : ℒ) = 1 := by
  calc _ = (T (-m) * T m) * SKM.K0Relations.piCoeff s ^ 2 := by ring
    _ = 1 := by rw [← T_add, neg_add_cancel, T_zero, SKM.K0Relations.piCoeff_sq, one_mul]

variable {t : List I} {e : HEnd Q.toSKM Sc Q.skmSymmetrizer hc t} (he : e ≫ e = e)
  (hd : e ∈ GradedSupercategory.degree (R := K) _ _ 0)
  (hp : e ∈ Supercategory.parity (R := K) _ _ 0)

theorem hcls_eq_smul (m : ℤ) (s : ZMod 2) :
    hcls he hd hp m s = (T m * SKM.K0Relations.piCoeff s) • hcls he hd hp 0 0 := by
  rw [hcls, mk_raw_eq_smul, hcls_smul]

theorem hcls_mem_iff (S : Subalgebra ℒ KQ) (m : ℤ) (s : ZMod 2) :
    hcls he hd hp m s ∈ S ↔ hcls he hd hp 0 0 ∈ S := by
  refine ⟨fun h => ?_, fun h => (hcls_eq_smul Q Sc hc he hd hp m s).symm ▸ S.smul_mem h _⟩
  have h1 := S.smul_mem h (T (-m) * SKM.K0Relations.piCoeff s)
  rwa [hcls_eq_smul Q Sc hc he hd hp m s, smul_smul,
    shift_inv_mul m s, one_smul] at h1

omit he hd hp in
theorem hcls_dpIdem_mem :
    hcls (dpIdem_idem Q.toSKM Sc Q.skmSymmetrizer hc i n)
      (dpIdem_mem Q.toSKM Sc Q.skmSymmetrizer hc i n).1
      (dpIdem_mem Q.toSKM Sc Q.skmSymmetrizer hc i n).2 0 0 ∈ (gammaBar Q Sc hc).range :=
  (hcls_mem_iff Q Sc hc _ _ _ _ _ _).1 ⟨_, gammaBar_dpF Q Sc hc i n⟩

omit he hd hp in
/-- The classes of products of divided powers lie in the image of `γ̄`. -/
theorem hcls_dpProduct_mem (h : IsDPProduct t e) :
    hcls h.mem_idem.2 h.mem_idem.1.1 h.mem_idem.1.2 0 0 ∈ (gammaBar Q Sc hc).range := by
  induction h with
  | nil =>
    have h1 : hcls (D := Q.toSKM) (Sc := Sc) (sy := Q.skmSymmetrizer) (hc := hc) (t := [])
        (Category.id_comp _) (GradedSupercategory.id_mem_degree (R := K) _)
        (Supercategory.id_mem (R := K) _) 0 0 = 1 := by
      rw [← wordCls_nil Q.toSKM Sc Q.skmSymmetrizer hc, wordCls, ← hKarToKH_word]
      exact congrArg (fun x => MulOpposite.op (hKarToKH Q.toSKM Sc Q.skmSymmetrizer hc (K₀.mk x)))
        (SerreComplex.raw_id (k := K) (hObj Q.toSKM Sc Q.skmSymmetrizer hc []) 0 0)
    exact h1 ▸ one_mem _
  | snoc i r h ih =>
    have h1 := congrArg MulOpposite.op (hKarToKH_raw_tailT
      (dpIdem_idem Q.toSKM Sc Q.skmSymmetrizer hc i r)
      (dpIdem_mem Q.toSKM Sc Q.skmSymmetrizer hc i r)
      h.mem_idem.2 h.mem_idem.1 0 0)
    rw [MulOpposite.op_mul] at h1
    exact (congrArg (· ∈ (gammaBar Q Sc hc).range) h1).mpr
      (mul_mem ih (hcls_dpIdem_mem Q Sc hc i r))

omit he hd hp in
/-- **BE2 Theorem 11.3, surjectivity**: the image of `γ̄` contains the shifted products of
divided powers, which span `K₀(Ḣ_{q,π})` (`dpSpan_eq_top`). -/
theorem gammaBar_surjective : Function.Surjective (gammaBar Q Sc hc) := by
  have key : ∀ y, MulOpposite.op (hKarToKH Q.toSKM Sc Q.skmSymmetrizer hc y) ∈
      (gammaBar Q Sc hc).range := by
    intro y
    have hy : y ∈ dpSpan Q.toSKM Sc Q.skmSymmetrizer hc := by
      rw [dpSpan_eq_top]; trivial
    induction hy using AddSubgroup.closure_induction with
    | mem y hy =>
      obtain ⟨t, e, h, n, p, rfl⟩ := hy
      exact (hcls_mem_iff Q Sc hc _ _ _ _ n p).2 (hcls_dpProduct_mem Q Sc hc h)
    | zero => rw [map_zero, MulOpposite.op_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [map_add, MulOpposite.op_add]; exact add_mem hy hz
    | neg y _ hy =>
      rw [map_neg, MulOpposite.op_neg, ← neg_one_smul ℒ]
      exact Subalgebra.smul_mem _ hy _
  intro x
  obtain ⟨y, hy⟩ := hKarToKH_surjective Q.toSKM Sc Q.skmSymmetrizer hc x.unop
  obtain ⟨z, hz⟩ := key y
  exact ⟨z, hz.trans (by rw [hy]; rfl)⟩

end Surjective

section Injective

variable [Finite I] [DecidableEq I] (hC : Q.BarConsistent)

include hC in
theorem toSerreF_wordSum_eq_zero {a : List I →₀ ℒ}
    (hK : (a.sum fun t r => r • wordCls Q.toSKM Sc Q.skmSymmetrizer hc t) = 0) :
    Q.toSerreF CoveringQuantum.Coefficients.q CoveringQuantum.Coefficients.pi
      (a.sum fun t r => CoveringQuantum.Coefficients.ofLaurentHom r •
        CoveringQuantum.PreF.monomial 𝕃 t) = 0 := by
  have hrad := mem_radical_of_wordSum_eq_zero Q Sc hc a (wordSum_eq_zero Q Sc hc hK)
  rw [← CoveringQuantum.Coefficients.serreIdeal_eq_radical Q.toSuperCartanDatum hC] at hrad
  exact (TwoSidedIdeal.mem_ker _).1 hrad

include hC in
/-- **BE2 Theorem 11.3, injectivity** (over `𝕃`): `γ̄ : f_𝕃 → 𝕃 ⊗_ℒ K₀(Ḣ_{q,π})` is injective.
Clearing denominators, a relation `∑ c_t [t] = 0` among word classes with `c_t ∈ ℒ` puts
`∑ c_t θ_t` in the radical of the form (`mem_radical_of_wordSum_eq_zero`), which is the Serre
ideal for finite bar-consistent data (`Coefficients.serreIdeal_eq_radical`). -/
theorem gammaL_injective : Function.Injective (gammaL Q Sc hc) := by
  refine (injective_iff_map_eq_zero _).2 fun x hx => ?_
  obtain ⟨y, rfl⟩ := Q.toSerreF_surjective CoveringQuantum.Coefficients.q
    CoveringQuantum.Coefficients.pi x
  have hy : y ∈ Submodule.span 𝕃 (Set.range (CoveringQuantum.PreF.monomial 𝕃 (I := I))) := by
    rw [CoveringQuantum.PreF.span_monomial]; trivial
  obtain ⟨c, rfl⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).1 hy
  obtain ⟨b, hb, a, hsum⟩ := exists_wordSum c
  have hK := wordCls_sum_eq_zero Q Sc hc hsum hx
  have h0 := toSerreF_wordSum_eq_zero Q Sc hc hC hK
  exact eq_zero_of_ofLaurent_smul Q hb
    ((map_smul _ _ _).symm.trans ((congrArg _ hsum).symm.trans h0))

include hC in
theorem gammaBar_injective : Function.Injective (gammaBar Q Sc hc) := fun x y h =>
  Subtype.ext (gammaL_injective Q Sc hc hC ((one_tmul_gammaBar Q Sc hc x).symm.trans
    ((congrArg _ h).trans (one_tmul_gammaBar Q Sc hc y))))

/-- **Brundan–Ellis, Theorem 11.3.** For a finite bar-consistent Cartan datum, over a field with
homogeneous scalars, `γ̄ : f_𝒜 → K₀(Ḣ_{q,π})` is an isomorphism of `ℒ`-algebras with
`θ_i^{(n)} ↦ [P(i^{(n)})]` (`theorem_11_3_dpF`). The finiteness and bar-consistency hypotheses
come from the current proof of nondegeneracy (`Coefficients.serreIdeal_eq_radical`). -/
def theorem_11_3 : fA Q ≃ₐ[ℒ] KQ :=
  AlgEquiv.ofBijective (gammaBar Q Sc hc)
    ⟨gammaBar_injective Q Sc hc hC, gammaBar_surjective Q Sc hc⟩

theorem theorem_11_3_dpF :
    theorem_11_3 Q Sc hc hC ⟨dpF Q i n, dpF_mem_fA Q i n⟩ = dpCls Q Sc hc i n :=
  gammaBar_dpF Q Sc hc i n

end Injective

