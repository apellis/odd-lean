import OddMath.QuiverHecke.KaroubiFunctor

/-!
# Finitely generated graded projective modules and the graded Karoubi envelope

Brundan–Ellis, arXiv:1701.04133v2, §11, (11.2): the graded super Karoubi envelope of a graded
supercategory `C` is equivalent to the category of finitely generated graded projective right
supermodules over the Hom-matrix algebra `Mat` of all objects of `C`. The functor
`gsKarFunctor` of `OddMath.QuiverHecke.KaroubiFunctor` is fully faithful; here we prove that its
essential image consists exactly of the finitely generated projective modules
(`gsKarFunctor_essImage_iff`), so that it is an equivalence onto that full subcategory
(`gsKarEquivEssImage`).

## Main results

* `GSMod.FG.of_surjective`, `GSMod.fg_biproduct`, `GSMod.isProjective_biproduct`: finite
  generation passes to quotients, and finite generation and projectivity to finite biproducts.
* `GSMod.fg_rowModule`: the shifted row modules `Q^m Π^a (1_λ · Mat)` are cyclic.
* `gsKarFunctor_essImage_iff`: a module is in the essential image of `gsKarFunctor` if and only
  if it is finitely generated and projective.
-/

@[expose] public noncomputable section

open scoped Classical
open CategoryTheory CategoryTheory.Limits CategoryTheory.Idempotents StringDiagrams
  GradedSupercategory

namespace OddMath.FiniteHomMatrix

universe u v w t z

namespace GSMod

variable {k : Type u} [CommRing k] {C : Type v} [Category.{w} C] [Preadditive C] [Linear k C]
  [Supercategory k C] [GradedSupercategory k C] {J : Type t} {obj : J → C}

section Generation

variable {M N : GSMod.{u, v, w, t, z} k obj}

/-- The submodule generated by `S` is contained in any `Mat`-stable subspace containing `S`. -/
theorem span_le {S : Set M} {V : Submodule k M} (hS : S ⊆ V)
    (hV : ∀ a m, m ∈ V → M.act a m ∈ V) : span S ≤ V :=
  Submodule.span_le.2 fun _ ⟨a, m, hm, hx⟩ => hx ▸ hV a m (hS hm)

/-- A morphism maps the submodule generated by `S` into the submodule generated by any set
containing the image of `S`. -/
theorem map_mem_span (f : M ⟶ N) {S : Set M} {T : Set N} (hST : ∀ m ∈ S, f.toLinearMap m ∈ T)
    {x : M} (hx : x ∈ span S) : f.toLinearMap x ∈ span T := by
  have : span S ≤ (span T).comap f.toLinearMap :=
    span_le (fun m hm => subset_span T (hST m hm)) fun a m hm => by
      simpa [Submodule.mem_comap, f.map_act] using act_mem_span (S := T) a hm
  exact this hx

/-- A quotient of a finitely generated module is finitely generated. -/
theorem FG.of_surjective (f : M ⟶ N) (hf : Function.Surjective f.toLinearMap) (hM : FG M) :
    FG N := by
  obtain ⟨S, hS⟩ := hM
  refine ⟨S.image f.toLinearMap, eq_top_iff.2 fun y _ => ?_⟩
  obtain ⟨x, rfl⟩ := hf y
  exact map_mem_span f (fun m hm => by simpa using ⟨m, hm, rfl⟩) (hS ▸ Submodule.mem_top : x ∈ span (S : Set M))

/-- Finite generation is invariant under isomorphism. -/
theorem FG.of_iso (hM : FG M) (i : M ≅ N) : FG N :=
  hM.of_surjective i.hom fun y => ⟨i.inv.toLinearMap y, by
    rw [← comp_apply, Iso.inv_hom_id, id_apply]⟩

end Generation

section Biproducts

variable {ι : Type} [Fintype ι] (F : ι → GSMod.{u, v, w, t, z} k obj)

theorem biproduct_apply_eq_sum (x : (⨁ F : GSMod.{u, v, w, t, z} k obj)) :
    x = ∑ i, (biproduct.ι F i).toLinearMap ((biproduct.π F i).toLinearMap x) := by
  conv_lhs => rw [← id_apply x, ← biproduct.total]
  rw [finset_sum_toLinearMap_apply]
  rfl

/-- A finite biproduct of finitely generated modules is finitely generated. -/
theorem fg_biproduct (hF : ∀ i, FG (F i)) : FG (⨁ F) := by
  choose S hS using hF
  refine ⟨Finset.univ.biUnion fun i => (S i).image (biproduct.ι F i).toLinearMap,
    eq_top_iff.2 fun x _ => ?_⟩
  rw [biproduct_apply_eq_sum F x]
  refine Submodule.sum_mem _ fun i _ => map_mem_span (biproduct.ι F i) (fun m hm => ?_)
    ((hS i).symm ▸ Submodule.mem_top)
  simp only [Finset.coe_biUnion, Finset.coe_univ, Set.mem_univ, Set.iUnion_true,
    Set.mem_iUnion, Finset.coe_image, Set.mem_image, Finset.mem_coe]
  exact ⟨i, m, hm, rfl⟩

/-- A finite biproduct of projective modules is projective. -/
theorem isProjective_biproduct (hF : ∀ i, IsProjective (F i)) : IsProjective (⨁ F) := by
  intro E X e he f
  choose g hg using fun i => hF i e he (biproduct.ι F i ≫ f)
  refine ⟨∑ i, biproduct.π F i ≫ g i, ?_⟩
  simp only [Preadditive.sum_comp, Category.assoc, hg]
  simp only [← Category.assoc, ← Preadditive.sum_comp, biproduct.total, Category.id_comp]

end Biproducts

section Rows

/-- The shifted row module `Q^m Π^a (1_j · Mat)` is generated by `1_j`. -/
theorem fg_rowModule (s : ℤ × ZMod 2) (j : J) :
    FG (GSMod.shift s (rowModule (k := k) (obj := obj) j)) := by
  refine ⟨{rowGen j}, eq_top_iff.2 fun v _ => ?_⟩
  rw [← rowAct_rowGen (k := k) j v]
  exact act_mem_span (M := GSMod.shift s (rowModule (k := k) (obj := obj) j)) _
    (subset_span _ (by simp))

end Rows

/-- A finitely generated module is generated by finitely many vectors `m · 1_j` with `m`
homogeneous. -/
theorem FG.exists_homogeneous {M : GSMod.{u, v, w, t, z} k obj} (hM : FG M) :
    ∃ (n : ℕ) (d : Fin n → ℤ × ZMod 2) (j : Fin n → J) (m : Fin n → M),
      (∀ i, m i ∈ M.piece (d i)) ∧
        span (Set.range fun i => M.act (idem (j i)) (m i)) = ⊤ := by
  obtain ⟨S, hS⟩ := hM
  choose D hD using fun x : M => M.exists_finset_sum_proj x
  choose F hF using fun y : M => M.exists_localUnit y
  let T : Finset ((ℤ × ZMod 2) × J × M) :=
    S.biUnion fun x => (D x).biUnion fun d => (F (M.proj d x)).image fun j => (d, j, x)
  let e := T.equivFin
  refine ⟨T.card, fun i => (e.symm i).1.1, fun i => (e.symm i).1.2.1,
    fun i => M.proj (e.symm i).1.1 (e.symm i).1.2.2, fun i => M.proj_mem _ _, ?_⟩
  refine eq_top_iff.2 (hS ▸ span_le (fun x hx => ?_) fun a m hm => act_mem_span a hm)
  rw [← hD x]
  refine Submodule.sum_mem _ fun d hd => ?_
  rw [← hF (M.proj d x), localUnit, map_sum, LinearMap.sum_apply]
  refine Submodule.sum_mem _ fun j hj => subset_span _ ⟨e ⟨(d, j, x), ?_⟩, by simp⟩
  simp only [T, Finset.mem_biUnion, Finset.mem_image]
  exact ⟨x, hx, d, hd, j, hj, rfl⟩

end GSMod

/-! ## The essential image -/

variable {k : Type u} [CommRing k] {C : Type v} [Category.{w} C] [Preadditive C] [Linear k C]
  [Supercategory k C] [GradedSupercategory k C]

variable (k) in
/-- The object `Q^m Π^a λ` of the underlying category of the `(Q, Π)`-envelope. -/
def qpiObj (s : ℤ × ZMod 2) (X : C) : QPiUnderlying k C := ⟨⟨⟨s.2, ⟨s.1, X⟩⟩⟩⟩

/-- **BE2 §11, (11.2).** Every module in the image of the graded Karoubi envelope is finitely
generated and projective: it is a summand of a finite direct sum of shifted row modules. -/
theorem gsKarFunctor_obj_fg_isProjective (P : GSKar k C) :
    ((gsKarFunctor k C).obj P).FG ∧ ((gsKarFunctor k C).obj P).IsProjective := by
  let G := matLift (rowFunctor k C)
  have hfg : (G.obj P.X).FG :=
    GSMod.fg_biproduct _ fun _ => GSMod.fg_rowModule _ _
  have hpr : (G.obj P.X).IsProjective :=
    GSMod.isProjective_biproduct _ fun _ => GSMod.isProjective_rowModule _ _
  have h := karoubiLiftι_π G P
  refine ⟨hfg.of_surjective (karoubiLiftπ G P) fun y =>
    ⟨(karoubiLiftι G P).toLinearMap y, ?_⟩, hpr.of_retract _ _ h⟩
  change (karoubiLiftι G P ≫ karoubiLiftπ G P).toLinearMap y = y
  rw [h]
  rfl

/-- **BE2 §11, (11.2).** Every finitely generated projective module is in the image of the
graded Karoubi envelope: it is the image of an idempotent on a finite direct sum of shifted row
modules. -/
theorem exists_gsKarFunctor_obj_iso (M : GSMod.{u, v, w, v, max v w} k (fun X : C => X))
    (hfg : M.FG) (hpr : M.IsProjective) :
    ∃ P : GSKar k C, Nonempty ((gsKarFunctor k C).obj P ≅ M) := by
  obtain ⟨n, d, j, m, hm, hspan⟩ := hfg.exists_homogeneous
  let X : Mat_ (QPiUnderlying k C) := ⟨Fin n, fun i => qpiObj k (d i) (j i)⟩
  let G := matLift (rowFunctor k C)
  let π : G.obj X ⟶ M := biproduct.desc fun i =>
    (GSMod.rowHom (d i) (j i) (m i) (hm i) : (rowFunctor k C).obj (X.X i) ⟶ M)
  have hsurj : Function.Surjective π.toLinearMap := by
    rw [← LinearMap.range_eq_top, eq_top_iff, ← hspan]
    refine GSMod.span_le ?_ fun a y hy => ?_
    · rintro _ ⟨i, rfl⟩
      refine ⟨(biproduct.ι (fun i => (rowFunctor k C).obj (X.X i)) i).toLinearMap
        (rowGen (j i)), ?_⟩
      change (biproduct.ι (fun i => (rowFunctor k C).obj (X.X i)) i ≫ π).toLinearMap
        (rowGen (j i)) = M.act (idem (j i)) (m i)
      rw [biproduct.ι_desc]
      exact congrArg (fun a => M.act a (m i)) (rowToMat_rowGen (k := k) (j i))
    · obtain ⟨x, rfl⟩ := hy
      exact ⟨(G.obj X).act a x, π.map_act a x⟩
  obtain ⟨σ, hσ⟩ := hpr π hsurj (𝟙 M)
  let hG := matLiftFullyFaithful _ (rowFunctorFullyFaithful (k := k) (C := C))
  let e := hG.preimage (π ≫ σ)
  have he : G.map e = π ≫ σ := hG.map_preimage _
  have hidem : e ≫ e = e := hG.map_injective (by
    rw [G.map_comp, he, Category.assoc, reassoc_of% hσ])
  let P : GSKar k C := ⟨X, e, hidem⟩
  refine ⟨P, ⟨karoubiLiftObjIso G P M
    { hom := ⟨π, ?_⟩
      inv := ⟨σ, ?_⟩
      hom_inv_id := ?_
      inv_hom_id := ?_ }⟩⟩
  · change G.map e ≫ π ≫ 𝟙 M = π
    rw [he, Category.comp_id, Category.assoc, hσ, Category.comp_id]
  · change 𝟙 M ≫ σ ≫ G.map e = σ
    rw [he, Category.id_comp, reassoc_of% hσ]
  · exact Karoubi.hom_ext _ _ he.symm
  · exact Karoubi.hom_ext _ _ hσ

/-- **BE2 §11, (11.2).** A graded right supermodule over the Hom-matrix algebra of all objects of
`C` is in the essential image of the graded super Karoubi envelope if and only if it is finitely
generated and projective. -/
theorem gsKarFunctor_essImage_iff (M : GSMod.{u, v, w, v, max v w} k (fun X : C => X)) :
    (gsKarFunctor k C).essImage M ↔ M.FG ∧ M.IsProjective := by
  constructor
  · rintro ⟨P, ⟨i⟩⟩
    obtain ⟨h₁, h₂⟩ := gsKarFunctor_obj_fg_isProjective P
    exact ⟨h₁.of_iso i, h₂.of_iso i⟩
  · rintro ⟨h₁, h₂⟩
    exact exists_gsKarFunctor_obj_iso M h₁ h₂

variable (k C) in
/-- **BE2 §11, (11.2).** The graded super Karoubi envelope of `C` is equivalent to the full
subcategory of finitely generated graded projective right supermodules over the Hom-matrix
algebra of all objects of `C` (the essential image of `gsKarFunctor`, identified by
`gsKarFunctor_essImage_iff`). -/
def gsKarEquivEssImage : GSKar k C ≌ (gsKarFunctor k C).EssImageSubcategory :=
  (gsKarFunctor k C).toEssImage.asEquivalence

end OddMath.FiniteHomMatrix
