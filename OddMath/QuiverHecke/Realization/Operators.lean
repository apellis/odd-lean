import OddMath.QuiverHecke.Realization.Twisted

/-!
# Coloured operators on the twisted module

Kang–Kashiwara–Tsuchioka, arXiv:1107.1039v2, §3.4: the algebra `SK_n` generated by the
coefficient algebra `MK_n` (localized polynomials, Clifford generators and colour idempotents
`e(ν)`) and the twisted transpositions `s̃_a` of Proposition 3.3.

Colours are recorded by *colour sequences* `ν : ℕ → Option I`; a word `t` gives the sequence
`p ↦ t[p]?`, which is `none` beyond the end of the word. The module is
`V = (ℕ → Option I) → (Perm ℕ →₀ Coeff)`, whose component at `ν` stands for
`e(ν) MK ⊗ ℤ[S_∞]`. Since sequences have every position, exchanging two positions is
composition with a transposition and needs no length conditions.

The operators are

* `diag F`: the coefficient operator `F ν` on the component `ν` (for instance `mulK g`, left
  multiplication by `g ν`, and `clif par p`, left multiplication by `c_p` at positions of odd
  colour and zero at positions of even colour, as in KKT's corner `RCP_n` of Definition 3.10);
* `tw a r`: KKT's `s̃_a` with the central element `r ν` at the component `ν`, carrying the
  component `ν ∘ s_a` to `ν`.

We prove the relations of `SK_n` used in Theorem 3.8 for these operators, as identities in the
ring of `k`-linear endomorphisms of `V`.
-/

noncomputable section
open scoped TensorProduct
namespace OddMath.QuiverHecke.Realization

variable {I : Type*} {k : Type*} [CommRing k]

/-- Colour sequences: the colour at each position, `none` beyond the end of a word. -/
abbrev Seq (I : Type*) := ℕ → Option I

/-- The ambient module: a copy of `Perm ℕ →₀ Coeff` for every colour sequence. -/
abbrev V (k : Type*) [CommRing k] (I : Type*) := Seq I → M k

/-! ## Diagonal operators -/

@[simp] theorem mapRange_linearMap_zero :
    Finsupp.mapRange.linearMap (0 : Module.End k (Coeff k)) = (0 : M k →ₗ[k] M k) :=
  LinearMap.ext fun x => Finsupp.ext fun w => by simp

/-- The operator acting by `F ν` on the coefficients of the component `ν`. -/
def diag (F : Seq I → Module.End k (Coeff k)) : Module.End k (V k I) :=
  LinearMap.pi fun ν => Finsupp.mapRange.linearMap (F ν) ∘ₗ LinearMap.proj ν

@[simp] theorem diag_apply (F : Seq I → Module.End k (Coeff k)) (x : V k I) (ν : Seq I) :
    diag F x ν = Finsupp.mapRange.linearMap (F ν) (x ν) := rfl

theorem diag_mul (F G : Seq I → Module.End k (Coeff k)) :
    diag (F * G) = diag F * diag G := by
  ext x ν w : 3
  simp [Finsupp.mapRange_apply]

theorem diag_mul' (F G : Seq I → Module.End k (Coeff k)) :
    diag (fun ν => F ν * G ν) = diag F * diag G := diag_mul F G

theorem diag_add (F G : Seq I → Module.End k (Coeff k)) :
    diag (fun ν => F ν + G ν) = diag F + diag G := by
  ext x ν w : 3
  simp [Finsupp.mapRange_apply]

theorem diag_sub (F G : Seq I → Module.End k (Coeff k)) :
    diag (fun ν => F ν - G ν) = diag F - diag G := by
  ext x ν w : 3
  simp [Finsupp.mapRange_apply]

theorem diag_neg (F : Seq I → Module.End k (Coeff k)) :
    diag (fun ν => -F ν) = -diag F := by
  ext x ν w : 3
  simp [Finsupp.mapRange_apply]

@[simp] theorem diag_one :
    diag (fun _ => (1 : Module.End k (Coeff k))) = (1 : Module.End k (V k I)) := by
  ext x ν w : 3
  simp [Finsupp.mapRange_apply]

@[simp] theorem diag_zero :
    diag (fun _ => (0 : Module.End k (Coeff k))) = (0 : Module.End k (V k I)) := by
  ext x ν w : 3
  simp

/-- Left multiplication by the scalar `g ν` on the component `ν`. -/
def mulK (g : Seq I → K k) : Module.End k (V k I) := diag fun ν => scalar (g ν)

/-- Whether position `p` of `ν` carries an odd colour for the parity `par`. -/
def oddAt (par : I → ZMod 2) (ν : Seq I) (p : ℕ) : Prop := ∃ i, ν p = some i ∧ par i = 1

instance (par : I → ZMod 2) (ν : Seq I) (p : ℕ) : Decidable (oddAt par ν p) :=
  match h : ν p with
  | none => isFalse fun ⟨_, hi, _⟩ => by simp [h] at hi
  | some i => if hi : par i = 1 then isTrue ⟨i, h, hi⟩ else
      isFalse fun ⟨j, hj, hj'⟩ => hi (by rw [h] at hj; cases hj; exact hj')

theorem oddAt_comp (par : I → ZMod 2) (ν : Seq I) (σ : ℕ → ℕ) (p : ℕ) :
    oddAt par (ν ∘ σ) p ↔ oddAt par ν (σ p) := Iff.rfl

/-- Left multiplication by `c_p` on components where position `p` has odd colour; zero on the
others. -/
def clif (par : I → ZMod 2) (p : ℕ) : Module.End k (V k I) :=
  diag fun ν => if oddAt par ν p then cliff p else 0

variable (par : I → ZMod 2)

theorem mulK_mul (f g : Seq I → K k) : mulK (f * g) = mulK f * mulK (I := I) g := by
  rw [mulK, mulK, mulK, ← diag_mul]
  congr 1
  ext1 ν
  exact scalar_mul _ _

theorem mulK_mul' (f g : Seq I → K k) : mulK (fun ν => f ν * g ν) = mulK f * mulK (I := I) g :=
  mulK_mul f g

theorem mulK_add (f g : Seq I → K k) : mulK (f + g) = mulK f + mulK (I := I) g := by
  rw [mulK, mulK, mulK, ← diag_add]
  congr 1
  ext1 ν
  exact scalar_add _ _

theorem mulK_sub (f g : Seq I → K k) : mulK (f - g) = mulK f - mulK (I := I) g := by
  rw [mulK, mulK, mulK, ← diag_sub]
  congr 1
  ext1 ν
  exact scalar_sub _ _

theorem mulK_neg (f : Seq I → K k) : mulK (-f) = -mulK (I := I) f := by
  rw [mulK, mulK, ← diag_neg]
  congr 1
  ext1 ν
  exact scalar_neg _

@[simp] theorem mulK_one : mulK (fun _ => (1 : K k)) = (1 : Module.End k (V k I)) := by
  simp [mulK]

@[simp] theorem mulK_zero : mulK (fun _ => (0 : K k)) = (0 : Module.End k (V k I)) := by
  simp [mulK]

theorem mulK_comm (f g : Seq I → K k) : mulK f * mulK (I := I) g = mulK g * mulK f := by
  rw [← mulK_mul, ← mulK_mul, mul_comm]

theorem clif_mulK (p : ℕ) (g : Seq I → K k) :
    clif par p * mulK g = mulK (fun ν => reflect p (g ν)) * clif (k := k) par p := by
  rw [clif, mulK, mulK, ← diag_mul, ← diag_mul]
  congr 1
  ext1 ν
  simp only [Pi.mul_apply]
  split_ifs
  · exact cliff_scalar _ _
  · simp

/-- Scalars even in `y_p` at the odd positions `p` commute with `c_p`. -/
theorem clif_mulK_comm (p : ℕ) (g : Seq I → K k)
    (hg : ∀ ν, oddAt par ν p → reflect p (g ν) = g ν) :
    clif par p * mulK g = mulK g * clif (k := k) par p := by
  rw [clif, mulK, ← diag_mul, ← diag_mul]
  congr 1
  ext1 ν
  simp only [Pi.mul_apply]
  split_ifs with h
  · rw [cliff_scalar, hg ν h]
  · simp

/-- `c_p² = 1` at odd positions. -/
theorem clif_mul_self (p : ℕ) :
    clif par p * clif par p =
      mulK (fun ν => if oddAt par ν p then (1 : K k) else 0) := by
  rw [clif, mulK, ← diag_mul]
  congr 1
  ext1 ν
  simp only [Pi.mul_apply]
  split_ifs
  · rw [cliff_mul_self, scalar_one]
  · simp

theorem clif_anticomm {p q : ℕ} (h : p ≠ q) :
    clif par p * clif par q = -(clif (k := k) (I := I) par q * clif par p) := by
  rw [clif, clif, ← diag_mul, ← diag_mul, ← diag_neg]
  congr 1
  ext1 ν
  simp only [Pi.mul_apply]
  split_ifs
  · exact cliff_anticomm h
  all_goals simp

/-! ## Twisted transpositions -/

/-- KKT's `s̃_a` with central element `r`: the component `ν ∘ s_a` is carried to `ν` by
`twist a (r ν)`. -/
def tw (a : ℕ) (r : Seq I → K k) : Module.End k (V k I) :=
  LinearMap.pi fun ν => twist a (r ν) ∘ₗ LinearMap.proj (ν ∘ sw a)

@[simp] theorem tw_apply (a : ℕ) (r : Seq I → K k) (x : V k I) (ν : Seq I) :
    tw a r x ν = twist a (r ν) (x (ν ∘ sw a)) := rfl

@[simp] theorem comp_sw_sw (ν : Seq I) (a : ℕ) : (ν ∘ sw a) ∘ sw a = ν := by
  ext1 p
  simp

theorem tw_mulK (a : ℕ) (r g : Seq I → K k) :
    tw a r * mulK g = mulK (fun ν => permK (sw a) (g (ν ∘ sw a))) * tw a r := by
  ext x ν : 2
  simp only [Module.End.mul_apply, tw_apply, mulK, diag_apply]
  exact LinearMap.congr_fun (twist_mr a (r ν) (g (ν ∘ sw a))) _

theorem tw_clif (a : ℕ) (r : Seq I → K k) (p : ℕ)
    (hr : ∀ ν, oddAt par ν (sw a p) → reflect (sw a p) (r ν) = r ν) :
    tw a r * clif par p = clif par (sw a p) * tw a r := by
  ext x ν : 2
  simp only [Module.End.mul_apply, tw_apply, clif, diag_apply]
  by_cases h : oddAt par ν (sw a p)
  · have h' : oddAt par (ν ∘ sw a) p := h
    simp only [h, h', ite_true]
    exact LinearMap.congr_fun (twist_mc a (r ν) p (hr ν h)) _
  · have h' : ¬ oddAt par (ν ∘ sw a) p := h
    simp [h, h']

theorem tw_mul_self (a : ℕ) (r : Seq I → K k)
    (hr : ∀ ν, permK (sw a) (r (ν ∘ sw a)) = r ν) :
    tw a r * tw a r = mulK r := by
  ext x ν : 2
  simp only [Module.End.mul_apply, tw_apply, comp_sw_sw, mulK, diag_apply]
  exact LinearMap.congr_fun (twist_twist a (r ν) (r (ν ∘ sw a)) (hr ν)) _

theorem tw_comm {a b : ℕ} (hab : a + 1 < b ∨ b + 1 < a) (r r' : Seq I → K k)
    (hr : ∀ ν, permK (sw b) (r (ν ∘ sw b)) = r ν)
    (hr' : ∀ ν, permK (sw a) (r' (ν ∘ sw a)) = r' ν) :
    tw a r * tw b r' = tw b r' * tw a r := by
  ext x ν : 2
  simp only [Module.End.mul_apply, tw_apply]
  have hν : (ν ∘ sw a) ∘ sw b = (ν ∘ sw b) ∘ sw a := by
    rw [Function.comp_assoc, Function.comp_assoc, ← Equiv.Perm.coe_mul, ← Equiv.Perm.coe_mul,
      sw_comm hab]
  rw [hν]
  exact LinearMap.congr_fun (twist_comm hab (r ν) (r' (ν ∘ sw a)) (r' ν) (r (ν ∘ sw b))
    (hr' ν) (hr ν)) _

theorem tw_braid (a : ℕ) (r r' : Seq I → K k)
    (h₁ : ∀ ν, r ν = permK (sw (a + 1) * sw a) (r' (ν ∘ ⇑(sw (a + 1) * sw a))))
    (h₂ : ∀ ν, permK (sw a) (r' (ν ∘ sw a)) = permK (sw (a + 1)) (r (ν ∘ sw (a + 1))))
    (h₃ : ∀ ν, permK (sw a * sw (a + 1)) (r (ν ∘ ⇑(sw a * sw (a + 1)))) = r' ν) :
    tw a r * tw (a + 1) r' * tw a r = tw (a + 1) r' * tw a r * tw (a + 1) r' := by
  ext x ν : 2
  simp only [Module.End.mul_apply, tw_apply]
  have hν : ((ν ∘ sw a) ∘ sw (a + 1)) ∘ sw a = ((ν ∘ sw (a + 1)) ∘ sw a) ∘ sw (a + 1) := by
    simp only [Function.comp_assoc, ← Equiv.Perm.coe_mul, sw_braid]
  rw [hν]
  have := LinearMap.congr_fun (twist_braid a (r ν) (r' (ν ∘ sw a))
    (r ((ν ∘ sw a) ∘ sw (a + 1))) (r' ν) (r (ν ∘ sw (a + 1)))
    (r' ((ν ∘ sw (a + 1)) ∘ sw a)) ?_ (h₂ ν) ?_) (x (((ν ∘ sw (a + 1)) ∘ sw a) ∘ sw (a + 1)))
  · simpa only [LinearMap.comp_apply] using this
  · rw [h₁ ν]; rfl
  · rw [← h₃ ν]; rfl

end OddMath.QuiverHecke.Realization
