import OddMath.QuiverHecke.Algebra
import OddMath.QuiverHecke.MixedRelations
import Mathlib.Data.Fintype.Vector
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Cyclotomic quotients at fixed strand number

Ports the quotient-algebra input to
`Categorification/KLR/CyclotomicAbsentColour.lean`. The algebra is the existing
finite-support Hom algebra `Hn`, not a second presentation. Finitely many
colours provide a unit. The construction here concerns the underlying algebra;
a super grading on its quotient additionally requires homogeneous relations.
-/

noncomputable section
open CategoryTheory StringDiagrams
open scoped Classical
namespace OddMath.FiniteHomMatrix
universe u v w t
variable {k : Type u} [CommRing k] {C : Type v} [Category.{w} C]
  [Preadditive C] [Linear k C] {J : Type t} [Fintype J] (obj : J → C)

instance : One (Mat obj) := ⟨localUnit Finset.univ⟩

private theorem finite_one_mul (a : Mat obj) : 1 * a = a := by
  induction a using induction with
  | hz => exact mul_zero _
  | ha a b ha hb => rw [mul_add, ha, hb]
  | hs i j f => exact localUnit_mul_single _ _ _ _ (Finset.mem_univ _)

private theorem finite_mul_one (a : Mat obj) : a * 1 = a := by
  induction a using induction with
  | hz => exact zero_mul _
  | ha a b ha hb => rw [add_mul, ha, hb]
  | hs i j f => exact single_mul_localUnit _ _ _ _ (Finset.mem_univ _)

instance : Ring (Mat obj) where
  __ := (inferInstance : NonUnitalRing (Mat obj))
  one := localUnit Finset.univ
  one_mul := finite_one_mul obj
  mul_one := finite_mul_one obj
  natCast n := n • (1 : Mat obj)
  natCast_zero := zero_nsmul _
  natCast_succ n := succ_nsmul _ _
  intCast n := n • (1 : Mat obj)
  intCast_ofNat n := natCast_zsmul _ _
  intCast_negSucc n := by
    change Int.negSucc n • (1 : Mat obj) = -((n + 1 : ℕ) • (1 : Mat obj))
    simp only [Int.negSucc_eq, neg_zsmul, ← Int.natCast_succ, natCast_zsmul]

instance : Algebra k (Mat obj) :=
  Algebra.ofModule (fun c x y => smul_mul_assoc c x y)
    (fun c x y => by rw [mul_smul_comm])

end OddMath.FiniteHomMatrix

namespace OddMath.QuiverHecke
universe u v w
variable {I : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  {k : Type w} [CommRing k] (Sc : SKM.Scalars D k) [Fintype I]

instance wordFintype (n : ℕ) : Fintype (Word I n) :=
  inferInstanceAs (Fintype (List.Vector I n))

/-- A first-dot relation in its actual diagonal word corner. -/
def cyclotomicGenerator (a : I → _root_.Polynomial k) {n : ℕ} (w : Word I (n + 1)) :
    Hn D Sc (n + 1) :=
  FiniteHomMatrix.single w w
    (_root_.Polynomial.aeval (dotE D Sc w.1 0)
      (a (w.1.get ⟨0, by rw [w.2]; omega⟩)))

/-- The two-sided ideal generated by all first-dot polynomial relations. -/
def cyclotomicIdeal (a : I → _root_.Polynomial k) (n : ℕ) : Ideal (Hn D Sc (n + 1)) :=
  Ideal.span {z | ∃ (w : Word I (n + 1)) (b : Hn D Sc (n + 1)),
    z = cyclotomicGenerator D Sc a w * b}

instance cyclotomicIdeal_twoSided (a : I → _root_.Polynomial k) (n : ℕ) :
    (cyclotomicIdeal D Sc a n).IsTwoSided where
  mul_mem_of_left b hz := by
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨w, c, rfl⟩ := hz
      exact Submodule.subset_span ⟨w, c * b, mul_assoc _ _ _⟩
    | zero => simp
    | add x y _ _ hx hy =>
      rw [add_mul]
      exact Submodule.add_mem _ hx hy
    | smul c x _ hx =>
      change (c * x) * b ∈ _
      rw [mul_assoc]
      exact Ideal.mul_mem_left _ c hx

/-- Cyclotomic quotient of the existing affine Hom algebra at positive height. -/
abbrev CyclotomicAlgebra (a : I → _root_.Polynomial k) (n : ℕ) :=
  Hn D Sc (n + 1) ⧸ cyclotomicIdeal D Sc a n

/-- The quotient map retains the original affine algebra as its source. -/
def cyclotomicMk (a : I → _root_.Polynomial k) (n : ℕ) :
    Hn D Sc (n + 1) →ₐ[k] CyclotomicAlgebra D Sc a n :=
  Ideal.Quotient.mkₐ k _

@[simp] theorem cyclotomicMk_generator (a : I → _root_.Polynomial k) {n : ℕ}
    (w : Word I (n + 1)) :
    cyclotomicMk D Sc a n (cyclotomicGenerator D Sc a w) = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact Submodule.subset_span ⟨w, 1, (mul_one _).symm⟩

end OddMath.QuiverHecke
