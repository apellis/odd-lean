import OddMath.QuiverHecke.CyclotomicAction.PrefixQPRepeated
import OddMath.QuiverHecke.CyclotomicAction.PrefixQPDistinct
import OddMath.QuiverHecke.CyclotomicAction.LinearDotCancellation

/-!
# Annihilators in the prescribed prepend target

`PrependKills z` says that the right ideal generated by `z` acts by zero on the
balanced target `B φ(1) ⊗ q`. It is closed under left multiplication, right
multiplication by the prepend image and by the first dot, and contains the
prepend images of the cyclotomic kernel. The square cancellation
`prependKills_of_sq_sub` removes a right factor `x₁² − φ(c)` for every old
element `c`; the even linear cancellation removes `φ(c) − x₁` when `p(i) = 0`.
These are the algebraic steps of the QP induction in `DeformedGlobalQP.md`.
-/

noncomputable section
open CategoryTheory StringDiagrams Categorification MulOpposite MonoidalCategory
namespace OddMath.QuiverHecke
universe u v
variable {I k : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  [CommRing k] (Sc : SKM.Scalars D k) [Fintype I]
variable (i : I) (β : Multiset I) (a : I → _root_.Polynomial k)
  (ha : CyclotomicPolynomialParity D a) (n : ℕ)

/-- The right ideal generated by `z` acts by zero on the prescribed target. -/
def PrependKills (z : Hn D Sc (n + 1 + 1)) : Prop :=
  ∀ (r : Hn D Sc (n + 1 + 1)) (b : (qCoefficient D Sc i β a ha n).toSVec),
    InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen
      (prependAlgebra D Sc i (n + 1) : Hn D Sc (n + 1) →ₙ+* Hn D Sc (n + 1 + 1))) b = 0

variable {D Sc i β a ha n}

theorem PrependKills.zero : PrependKills D Sc i β a ha n 0 := by
  intro r b
  rw [mul_zero, zero_smul]
  exact InductionAlong.Ind.zero_tmul b

theorem PrependKills.add {z w : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (hw : PrependKills D Sc i β a ha n w) : PrependKills D Sc i β a ha n (z + w) := by
  intro r b
  rw [mul_add, add_smul, InductionAlong.Ind.add_tmul, hz r b, hw r b, add_zero]

theorem PrependKills.mul_left {z : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (y : Hn D Sc (n + 1 + 1)) : PrependKills D Sc i β a ha n (y * z) := by
  intro r b
  rw [← mul_assoc]
  exact hz _ b

theorem PrependKills.neg {z : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z) :
    PrependKills D Sc i β a ha n (-z) := by
  intro r b
  rw [mul_neg, ← neg_mul]
  exact hz _ b

theorem PrependKills.sub {z w : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (hw : PrependKills D Sc i β a ha n w) : PrependKills D Sc i β a ha n (z - w) := by
  rw [sub_eq_add_neg]
  exact hz.add hw.neg

theorem PrependKills.smul {z : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (c : k) : PrependKills D Sc i β a ha n (c • z) := by
  intro r b
  rw [mul_smul_comm, ← smul_mul_assoc]
  exact hz _ b

theorem PrependKills.of_eq {z w : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (h : z = w) : PrependKills D Sc i β a ha n w := h ▸ hz

/-- Prepend images of the cyclotomic kernel act by zero. -/
theorem prependKills_of_cyclotomicMk {z : Hn D Sc (n + 1)}
    (hz : cyclotomicMk D Sc a n z = 0) :
    PrependKills D Sc i β a ha n (prependAlgebra D Sc i (n + 1) z) :=
  fun r b => prepend_kernel_tmul_zero D Sc i β a ha n z hz r b

/-- Right multiplication by a prepend image. -/
theorem PrependKills.mul_prepend {z : Hn D Sc (n + 1 + 1)}
    (hz : PrependKills D Sc i β a ha n z) (x : Hn D Sc (n + 1)) :
    PrependKills D Sc i β a ha n (z * prependAlgebra D Sc i (n + 1) x) := by
  intro r b
  let φ := (prependAlgebra D Sc i (n + 1) : Hn D Sc (n + 1) →ₙ+* Hn D Sc (n + 1 + 1))
  have he : (r * (z * φ x)) • InductionAlong.unitGen φ =
      op x • ((r * z) • InductionAlong.unitGen φ) := by
    apply Subtype.ext
    change (r * (z * φ x)) * φ 1 = ((r * z) * φ 1) * φ x
    rw [mul_assoc, mul_assoc, ← map_mul, mul_one, mul_assoc, mul_assoc, ← map_mul, one_mul]
  change InductionAlong.Ind.tmul ((r * (z * φ x)) • InductionAlong.unitGen φ) b = 0
  rw [he, InductionAlong.Ind.op_smul_tmul]
  exact hz r _

theorem prepend_one_mul_affineFirstDot (n : ℕ) :
    prependAlgebra D Sc i n 1 * affineFirstDot D Sc i n = affineFirstDot D Sc i n := by
  rw [affineFirstDot_twist_comm, homMatrixTwist_one, affineFirstDot_mul_prepend_one]

/-- Right multiplication by the first dot. -/
theorem PrependKills.mul_firstDot {z : Hn D Sc (n + 1 + 1)}
    (hz : PrependKills D Sc i β a ha n z) :
    PrependKills D Sc i β a ha n (z * affineFirstDot D Sc i (n + 1)) := by
  intro r b
  let φ := (prependAlgebra D Sc i (n + 1) : Hn D Sc (n + 1) →ₙ+* Hn D Sc (n + 1 + 1))
  have he : (r * (z * affineFirstDot D Sc i (n + 1))) • InductionAlong.unitGen φ =
      targetDotCorner D Sc i (n + 1) ((r * z) • InductionAlong.unitGen φ) := by
    apply Subtype.ext
    change (r * (z * affineFirstDot D Sc i (n + 1))) * φ 1 =
      ((r * z) * φ 1) * affineFirstDot D Sc i (n + 1)
    have h1 : φ 1 * affineFirstDot D Sc i (n + 1) = affineFirstDot D Sc i (n + 1) :=
      prepend_one_mul_affineFirstDot (n + 1)
    have h2 : affineFirstDot D Sc i (n + 1) * φ 1 = affineFirstDot D Sc i (n + 1) :=
      affineFirstDot_mul_prepend_one D Sc i (n + 1)
    simp only [mul_assoc, h1, h2]
  change InductionAlong.Ind.tmul _ b = 0
  rw [he, ← SVec.sgn_sgn_apply _ (D.parity i) b, ← targetRightDot_tmul, hz r _, map_zero]

theorem cyclotomic_smul_eq (x : Hn D Sc (n + 1)) (e : CyclotomicAlgebra D Sc a n) :
    x • e = cyclotomicMk D Sc a n x * e := by
  obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective e
  rfl

/-- Square cancellation: a right factor `x₁² − φ(c)` can be removed, for every `c`. -/
theorem PrependKills.of_sq_sub {z : Hn D Sc (n + 1 + 1)} (c : Hn D Sc (n + 1))
    (hz : PrependKills D Sc i β a ha n
      (z * (affineFirstDot D Sc i (n + 1) ^ 2 - prependAlgebra D Sc i (n + 1) c))) :
    PrependKills D Sc i β a ha n z := by
  let φ := (prependAlgebra D Sc i (n + 1) : Hn D Sc (n + 1) →ₙ+* Hn D Sc (n + 1 + 1))
  let V := qCoefficient D Sc i β a ha n
  let ins := qCoefficientInsert D Sc i β a ha n
  let p := D.parity i * contentSumParity D β
  have hone : ∀ r : Hn D Sc (n + 1 + 1),
      InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen φ) (ins 1) = 0 := by
    intro r
    apply targetRightDot_sq_sub_coefficient_injective D Sc i β a ha n
      (cyclotomicMk D Sc a n (homMatrixTwist D Sc (n + 1) p c))
    have hsq : (targetRightDot D Sc i β a ha n ^ 2)
        (InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen φ) (ins 1)) =
        InductionAlong.Ind.tmul ((r * (z * affineFirstDot D Sc i (n + 1) ^ 2)) •
          InductionAlong.unitGen φ) (ins 1) := by
      rw [targetRightDot_sq_tmul]
      congr 1
      apply Subtype.ext
      rw [targetDotCorner_twice_val]
      change ((r * z) * φ 1) * affineFirstDot D Sc i (n + 1) ^ 2 =
        (r * (z * affineFirstDot D Sc i (n + 1) ^ 2)) * φ 1
      have h1 : ∀ x, φ 1 * (affineFirstDot D Sc i (n + 1) * x) =
          affineFirstDot D Sc i (n + 1) * x := fun x => by
        rw [← mul_assoc]
        exact congrArg (· * x) (prepend_one_mul_affineFirstDot (n + 1))
      have h2 : affineFirstDot D Sc i (n + 1) * φ 1 = affineFirstDot D Sc i (n + 1) :=
        affineFirstDot_mul_prepend_one D Sc i (n + 1)
      simp only [pow_two, mul_assoc, h1, h2]
    have hc : InductionAlong.Ind.tmul ((r * (z * φ c)) • InductionAlong.unitGen φ) (ins 1) =
        targetRightCoefficient D Sc i β a ha n
          (cyclotomicMk D Sc a n (homMatrixTwist D Sc (n + 1) p c))
          (InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen φ) (ins 1)) := by
      have he : (r * (z * φ c)) • InductionAlong.unitGen φ =
          op c • ((r * z) • InductionAlong.unitGen φ) := by
        apply Subtype.ext
        change (r * (z * φ c)) * φ 1 = ((r * z) * φ 1) * φ c
        rw [mul_assoc, mul_assoc, ← map_mul, mul_one, mul_assoc, mul_assoc, ← map_mul,
          one_mul]
      rw [he, InductionAlong.Ind.op_smul_tmul, targetRightCoefficient_tmul]
      congr 1
      have h1 := qCoefficientInsert_smul D Sc i β a ha n (homMatrixTwist D Sc (n + 1) p c) 1
      rw [homMatrixTwist_twice] at h1
      change c • ins 1 = _
      rw [← h1, cyclotomic_smul_eq, mul_one, ← qCoefficientInsert_mul, one_mul]
    have h := hz r (ins 1)
    rw [mul_sub, mul_sub, sub_smul, sub_eq_add_neg, InductionAlong.Ind.add_tmul,
      InductionAlong.Ind.neg_tmul, ← sub_eq_add_neg, ← hsq] at h
    erw [hc] at h
    simpa only [map_zero, sub_zero] using h
  intro r b
  obtain ⟨e, rfl⟩ := qCoefficientInsert_surjective D Sc i β a ha n b
  change InductionAlong.Ind.tmul _ (ins e) = 0
  rw [← one_mul e, qCoefficientInsert_mul]
  change targetRightCoefficient D Sc i β a ha n e
    (InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen φ) (ins 1)) = 0
  rw [hone r, map_zero]

end OddMath.QuiverHecke
