import OddMath.QuiverHecke.CyclotomicAction.PrefixQPRepeated
import OddMath.QuiverHecke.CyclotomicAction.PrefixQPDistinct
import OddMath.QuiverHecke.CyclotomicAction.LinearDotCancellation

/-!
# Annihilators in the prescribed prepend target

`PrependKills z` says that the right ideal generated by `z` acts by zero on the
balanced target `B φ(1) ⊗ q`. It is closed under left multiplication, right
multiplication by the prepend image and by the first dot, and contains the
prepend images of the cyclotomic kernel. The square cancellation
`prependKills_of_sq_sub` removes a right factor `x₁² − φ(c)` for every old
element `c`; the even linear cancellation removes `φ(c) − x₁` when `p(i) = 0`.
These are the algebraic steps of the QP induction in `DeformedGlobalQP.md`.
-/

noncomputable section
open CategoryTheory StringDiagrams Categorification MulOpposite MonoidalCategory
namespace OddMath.QuiverHecke
universe u v
variable {I k : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  [CommRing k] (Sc : SKM.Scalars D k) [Fintype I]
variable (i : I) (β : Multiset I) (a : I → _root_.Polynomial k)
  (ha : CyclotomicPolynomialParity D a) (n : ℕ)

/-- The right ideal generated by `z` acts by zero on the prescribed target. -/
def PrependKills (z : Hn D Sc (n + 1 + 1)) : Prop :=
  ∀ (r : Hn D Sc (n + 1 + 1)) (b : (qCoefficient D Sc i β a ha n).toSVec),
    InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen
      (prependAlgebra D Sc i (n + 1) : Hn D Sc (n + 1) →ₙ+* Hn D Sc (n + 1 + 1))) b = 0

variable {D Sc i β a ha n}

theorem PrependKills.zero : PrependKills D Sc i β a ha n 0 := by
  intro r b
  rw [mul_zero, zero_smul]
  exact InductionAlong.Ind.zero_tmul b

theorem PrependKills.add {z w : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (hw : PrependKills D Sc i β a ha n w) : PrependKills D Sc i β a ha n (z + w) := by
  intro r b
  rw [mul_add, add_smul, InductionAlong.Ind.add_tmul, hz r b, hw r b, add_zero]

theorem PrependKills.mul_left {z : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (y : Hn D Sc (n + 1 + 1)) : PrependKills D Sc i β a ha n (y * z) := by
  intro r b
  rw [← mul_assoc]
  exact hz _ b

theorem PrependKills.neg {z : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z) :
    PrependKills D Sc i β a ha n (-z) := by
  intro r b
  rw [mul_neg, ← neg_mul]
  exact hz _ b

theorem PrependKills.sub {z w : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (hw : PrependKills D Sc i β a ha n w) : PrependKills D Sc i β a ha n (z - w) := by
  rw [sub_eq_add_neg]
  exact hz.add hw.neg

theorem PrependKills.smul {z : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (c : k) : PrependKills D Sc i β a ha n (c • z) := by
  intro r b
  rw [mul_smul_comm, ← smul_mul_assoc]
  exact hz _ b

theorem PrependKills.of_eq {z w : Hn D Sc (n + 1 + 1)} (hz : PrependKills D Sc i β a ha n z)
    (h : z = w) : PrependKills D Sc i β a ha n w := h ▸ hz

/-- Prepend images of the cyclotomic kernel act by zero. -/
theorem prependKills_of_cyclotomicMk {z : Hn D Sc (n + 1)}
    (hz : cyclotomicMk D Sc a n z = 0) :
    PrependKills D Sc i β a ha n (prependAlgebra D Sc i (n + 1) z) :=
  fun r b => prepend_kernel_tmul_zero D Sc i β a ha n z hz r b

/-- Right multiplication by a prepend image. -/
theorem PrependKills.mul_prepend {z : Hn D Sc (n + 1 + 1)}
    (hz : PrependKills D Sc i β a ha n z) (x : Hn D Sc (n + 1)) :
    PrependKills D Sc i β a ha n (z * prependAlgebra D Sc i (n + 1) x) := by
  intro r b
  let φ := (prependAlgebra D Sc i (n + 1) : Hn D Sc (n + 1) →ₙ+* Hn D Sc (n + 1 + 1))
  have he : (r * (z * φ x)) • InductionAlong.unitGen φ =
      op x • ((r * z) • InductionAlong.unitGen φ) := by
    apply Subtype.ext
    change (r * (z * φ x)) * φ 1 = ((r * z) * φ 1) * φ x
    rw [mul_assoc, mul_assoc, ← map_mul, mul_one, mul_assoc, mul_assoc, ← map_mul, one_mul]
  change InductionAlong.Ind.tmul ((r * (z * φ x)) • InductionAlong.unitGen φ) b = 0
  rw [he, InductionAlong.Ind.op_smul_tmul]
  exact hz r _

theorem prepend_one_mul_affineFirstDot (n : ℕ) :
    prependAlgebra D Sc i n 1 * affineFirstDot D Sc i n = affineFirstDot D Sc i n := by
  rw [affineFirstDot_twist_comm, homMatrixTwist_one, affineFirstDot_mul_prepend_one]

/-- Right multiplication by the first dot. -/
theorem PrependKills.mul_firstDot {z : Hn D Sc (n + 1 + 1)}
    (hz : PrependKills D Sc i β a ha n z) :
    PrependKills D Sc i β a ha n (z * affineFirstDot D Sc i (n + 1)) := by
  intro r b
  let φ := (prependAlgebra D Sc i (n + 1) : Hn D Sc (n + 1) →ₙ+* Hn D Sc (n + 1 + 1))
  have he : (r * (z * affineFirstDot D Sc i (n + 1))) • InductionAlong.unitGen φ =
      targetDotCorner D Sc i (n + 1) ((r * z) • InductionAlong.unitGen φ) := by
    apply Subtype.ext
    change (r * (z * affineFirstDot D Sc i (n + 1))) * φ 1 =
      ((r * z) * φ 1) * affineFirstDot D Sc i (n + 1)
    have h1 : φ 1 * affineFirstDot D Sc i (n + 1) = affineFirstDot D Sc i (n + 1) :=
      prepend_one_mul_affineFirstDot (n + 1)
    have h2 : affineFirstDot D Sc i (n + 1) * φ 1 = affineFirstDot D Sc i (n + 1) :=
      affineFirstDot_mul_prepend_one D Sc i (n + 1)
    simp only [mul_assoc, h1, h2]
  change InductionAlong.Ind.tmul _ b = 0
  rw [he, ← SVec.sgn_sgn_apply _ (D.parity i) b, ← targetRightDot_tmul, hz r _, map_zero]

theorem cyclotomic_smul_eq (x : Hn D Sc (n + 1)) (e : CyclotomicAlgebra D Sc a n) :
    x • e = cyclotomicMk D Sc a n x * e := by
  obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective e
  rfl

/-- Square cancellation: a right factor `x₁² − φ(c)` can be removed, for every `c`. -/
theorem PrependKills.of_sq_sub {z : Hn D Sc (n + 1 + 1)} (c : Hn D Sc (n + 1))
    (hz : PrependKills D Sc i β a ha n
      (z * (affineFirstDot D Sc i (n + 1) ^ 2 - prependAlgebra D Sc i (n + 1) c))) :
    PrependKills D Sc i β a ha n z := by
  let φ := (prependAlgebra D Sc i (n + 1) : Hn D Sc (n + 1) →ₙ+* Hn D Sc (n + 1 + 1))
  let V := qCoefficient D Sc i β a ha n
  let ins := qCoefficientInsert D Sc i β a ha n
  let p := D.parity i * contentSumParity D β
  have hone : ∀ r : Hn D Sc (n + 1 + 1),
      InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen φ) (ins 1) = 0 := by
    intro r
    apply targetRightDot_sq_sub_coefficient_injective D Sc i β a ha n
      (cyclotomicMk D Sc a n (homMatrixTwist D Sc (n + 1) p c))
    have hsq : (targetRightDot D Sc i β a ha n ^ 2)
        (InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen φ) (ins 1)) =
        InductionAlong.Ind.tmul ((r * (z * affineFirstDot D Sc i (n + 1) ^ 2)) •
          InductionAlong.unitGen φ) (ins 1) := by
      rw [targetRightDot_sq_tmul]
      congr 1
      apply Subtype.ext
      rw [targetDotCorner_twice_val]
      change ((r * z) * φ 1) * affineFirstDot D Sc i (n + 1) ^ 2 =
        (r * (z * affineFirstDot D Sc i (n + 1) ^ 2)) * φ 1
      have h1 : ∀ x, φ 1 * (affineFirstDot D Sc i (n + 1) * x) =
          affineFirstDot D Sc i (n + 1) * x := fun x => by
        rw [← mul_assoc]
        exact congrArg (· * x) (prepend_one_mul_affineFirstDot (n + 1))
      have h2 : affineFirstDot D Sc i (n + 1) * φ 1 = affineFirstDot D Sc i (n + 1) :=
        affineFirstDot_mul_prepend_one D Sc i (n + 1)
      simp only [pow_two, mul_assoc, h1, h2]
    have hc : InductionAlong.Ind.tmul ((r * (z * φ c)) • InductionAlong.unitGen φ) (ins 1) =
        targetRightCoefficient D Sc i β a ha n
          (cyclotomicMk D Sc a n (homMatrixTwist D Sc (n + 1) p c))
          (InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen φ) (ins 1)) := by
      have he : (r * (z * φ c)) • InductionAlong.unitGen φ =
          op c • ((r * z) • InductionAlong.unitGen φ) := by
        apply Subtype.ext
        change (r * (z * φ c)) * φ 1 = ((r * z) * φ 1) * φ c
        rw [mul_assoc, mul_assoc, ← map_mul, mul_one, mul_assoc, mul_assoc, ← map_mul,
          one_mul]
      rw [he, InductionAlong.Ind.op_smul_tmul, targetRightCoefficient_tmul]
      congr 1
      have h1 := qCoefficientInsert_smul D Sc i β a ha n (homMatrixTwist D Sc (n + 1) p c) 1
      rw [homMatrixTwist_twice] at h1
      change c • ins 1 = _
      rw [← h1, cyclotomic_smul_eq, mul_one, ← qCoefficientInsert_mul, one_mul]
    have h := hz r (ins 1)
    rw [mul_sub, mul_sub, sub_smul, sub_eq_add_neg, InductionAlong.Ind.add_tmul,
      InductionAlong.Ind.neg_tmul, ← sub_eq_add_neg, ← hsq] at h
    erw [hc] at h
    simpa only [map_zero, sub_zero] using h
  intro r b
  obtain ⟨e, rfl⟩ := qCoefficientInsert_surjective D Sc i β a ha n b
  change InductionAlong.Ind.tmul _ (ins e) = 0
  rw [← one_mul e, qCoefficientInsert_mul]
  change targetRightCoefficient D Sc i β a ha n e
    (InductionAlong.Ind.tmul ((r * z) • InductionAlong.unitGen φ) (ins 1)) = 0
  rw [hone r, map_zero]

omit [Fintype I] in
theorem homMatrixTwist_zero_parity (m : ℕ) (z : Hn D Sc m) : homMatrixTwist D Sc m 0 z = z := by
  induction z using FiniteHomMatrix.induction with
  | hz => simp
  | ha a b ha hb => simp [ha, hb]
  | hs s t f => simp

/-- Even linear cancellation: for `p(i) = 0` a right factor `φ(c) − x₁` can be removed. -/
theorem PrependKills.of_linear_even (hp : D.parity i = 0) {z : Hn D Sc (n + 1 + 1)}
    (c : Hn D Sc (n + 1))
    (hz : PrependKills D Sc i β a ha n
      (z * (prependAlgebra D Sc i (n + 1) c - affineFirstDot D Sc i (n + 1)))) :
    PrependKills D Sc i β a ha n z := by
  set u := prependAlgebra D Sc i (n + 1) c
  set f := affineFirstDot D Sc i (n + 1)
  have huf : u * f = f * u := by
    simp only [u, f]
    rw [affineFirstDot_twist_comm, hp, homMatrixTwist_zero_parity]
  have h2 : PrependKills D Sc i β a ha n (z * (u - f) * (u + f)) := by
    rw [mul_add]
    exact (hz.mul_prepend c).add hz.mul_firstDot
  refine PrependKills.of_sq_sub (c * c) ?_
  have he : z * (f ^ 2 - prependAlgebra D Sc i (n + 1) (c * c)) = -(z * (u - f) * (u + f)) := by
    rw [map_mul]
    change z * (f ^ 2 - u * u) = _
    rw [pow_two, mul_assoc, sub_mul, mul_add, mul_add, huf]
    noncomm_ring
  rw [he]
  exact h2.neg

section Morphism

variable (D Sc i β a ha n) in
/-- The endomorphism `Y` of `i :: w`, placed in its corner, generates a right ideal
acting by zero on the prescribed target. -/
def KillE (w : Word I (n + 1)) (Y : End (wordObj D Sc (prependWord i w))) : Prop :=
  PrependKills D Sc i β a ha n (FiniteHomMatrix.cornerMap (prependWord i w) Y)

variable {w : Word I (n + 1)}

theorem KillE.comp {Y : End (wordObj D Sc (prependWord i w))}
    (hY : KillE D Sc i β a ha n w Y) (g : End (wordObj D Sc (prependWord i w))) :
    KillE D Sc i β a ha n w (Y ≫ g) := by
  unfold KillE
  rw [← End.mul_def, map_mul]
  exact PrependKills.mul_left hY _

theorem KillE.add {Y Z : End (wordObj D Sc (prependWord i w))}
    (hY : KillE D Sc i β a ha n w Y) (hZ : KillE D Sc i β a ha n w Z) :
    KillE D Sc i β a ha n w (Y + Z) := by
  unfold KillE
  rw [map_add]
  exact PrependKills.add hY hZ

theorem KillE.neg {Y : End (wordObj D Sc (prependWord i w))}
    (hY : KillE D Sc i β a ha n w Y) : KillE D Sc i β a ha n w (-Y) := by
  unfold KillE
  rw [map_neg]
  exact PrependKills.neg hY

theorem KillE.sub {Y Z : End (wordObj D Sc (prependWord i w))}
    (hY : KillE D Sc i β a ha n w Y) (hZ : KillE D Sc i β a ha n w Z) :
    KillE D Sc i β a ha n w (Y - Z) := by
  rw [sub_eq_add_neg]
  exact KillE.add hY (KillE.neg hZ)

theorem KillE.smul {Y : End (wordObj D Sc (prependWord i w))}
    (hY : KillE D Sc i β a ha n w Y) (c : k) : KillE D Sc i β a ha n w (c • Y) := by
  unfold KillE
  change PrependKills D Sc i β a ha n (FiniteHomMatrix.single _ _ (c • Y))
  rw [FiniteHomMatrix.single_smul]
  exact PrependKills.smul hY c

theorem KillE.of_eq {Y Z : End (wordObj D Sc (prependWord i w))}
    (hY : KillE D Sc i β a ha n w Y) (h : Y = Z) : KillE D Sc i β a ha n w Z := h ▸ hY

theorem killE_zero : KillE D Sc i β a ha n w 0 := by
  unfold KillE
  rw [map_zero]
  exact PrependKills.zero

/-- Transport along an equality of words. -/
theorem KillE.transport {w' : Word I (n + 1)} (e : w = w')
    {Y : End (wordObj D Sc (prependWord i w))} (hY : KillE D Sc i β a ha n w Y) :
    KillE D Sc i β a ha n w' (eqToHom (by rw [e]) ≫ Y ≫ eqToHom (by rw [e])) := by
  subst e
  simpa using hY

omit [Fintype I] in
theorem cornerMap_whiskerLeft (f : End (wordObj D Sc w)) :
    FiniteHomMatrix.cornerMap (prependWord i w)
        ((pres D Sc).obj (ob D [i]) ◁ f : End (wordObj D Sc (prependWord i w))) =
      prependAlgebra D Sc i (n + 1) (FiniteHomMatrix.cornerMap w f) := by
  change _ = prependLinear D Sc i (n + 1) (FiniteHomMatrix.single w w f)
  rw [prependLinear_single]
  rfl

variable (D Sc i) in
/-- The prepend image of the corner unit. -/
abbrev cornerUnit (w : Word I (n + 1)) : Hn D Sc (n + 1 + 1) :=
  prependAlgebra D Sc i (n + 1) (FiniteHomMatrix.cornerMap w 1)

omit [Fintype I] in
theorem cornerMap_one_prepend :
    FiniteHomMatrix.cornerMap (prependWord i w) (1 : End (wordObj D Sc (prependWord i w))) =
      cornerUnit D Sc i w := by
  show _ = prependAlgebra D Sc i (n + 1) (FiniteHomMatrix.cornerMap w 1)
  rw [← cornerMap_whiskerLeft]
  congr 1
  exact (MonoidalSupercategory.whiskerLeft_id (R := k) ((pres D Sc).obj (ob D [i]))
    (wordObj D Sc w)).symm

theorem cornerMap_dotZero :
    FiniteHomMatrix.cornerMap (prependWord i w) (dotE D Sc (i :: w.1) 0) =
      affineFirstDot D Sc i (n + 1) * cornerUnit D Sc i w := by
  rw [← cornerMap_one_prepend]
  change _ = affineFirstDot D Sc i (n + 1) *
    FiniteHomMatrix.single (prependWord i w) (prependWord i w) (𝟙 _)
  rw [affineFirstDot_mul_single, Category.id_comp, inductionFirstDot_eq_dotE]
  rfl

theorem cornerUnit_comm_firstDot :
    cornerUnit D Sc i w * affineFirstDot D Sc i (n + 1) =
      affineFirstDot D Sc i (n + 1) * cornerUnit D Sc i w := by
  have ht : homMatrixTwist D Sc (n + 1) (D.parity i)
      (FiniteHomMatrix.cornerMap w (1 : End (wordObj D Sc w))) =
      FiniteHomMatrix.cornerMap w (1 : End (wordObj D Sc w)) := by
    change homMatrixTwist D Sc (n + 1) (D.parity i)
      (FiniteHomMatrix.single w w (𝟙 (wordObj D Sc w))) =
      FiniteHomMatrix.single w w (𝟙 (wordObj D Sc w))
    rw [homMatrixTwist_single, Supercategory.twist_id]
  rw [affineFirstDot_twist_comm, ht]

omit [Fintype I] in
theorem cornerMap_mul_cornerUnit (Y : End (wordObj D Sc (prependWord i w))) :
    FiniteHomMatrix.cornerMap (prependWord i w) Y * cornerUnit D Sc i w =
      FiniteHomMatrix.cornerMap (prependWord i w) Y := by
  rw [← cornerMap_one_prepend, ← map_mul, mul_one]

variable (D Sc i β a ha n) in
/-- Precomposition by `g` preserves killing endomorphisms. -/
def GoodE (w : Word I (n + 1)) (g : End (wordObj D Sc (prependWord i w))) : Prop :=
  ∀ Y, KillE D Sc i β a ha n w Y → KillE D Sc i β a ha n w (g ≫ Y)

theorem goodE_whiskerLeft (f : End (wordObj D Sc w)) :
    GoodE D Sc i β a ha n w ((pres D Sc).obj (ob D [i]) ◁ f) := by
  intro Y hY
  unfold KillE at hY ⊢
  rw [← End.mul_def, map_mul, cornerMap_whiskerLeft]
  exact hY.mul_prepend _

theorem goodE_dotZero : GoodE D Sc i β a ha n w (dotE D Sc (i :: w.1) 0) := by
  intro Y hY
  unfold KillE at hY ⊢
  rw [← End.mul_def, map_mul, cornerMap_dotZero, ← mul_assoc]
  exact hY.mul_firstDot.mul_prepend _

variable (D Sc i β a ha n) in
/-- The good precompositions form a subalgebra. -/
def goodSubalgebra (w : Word I (n + 1)) : Subalgebra k (End (wordObj D Sc (prependWord i w))) where
  carrier := {g | GoodE D Sc i β a ha n w g}
  mul_mem' {g h} hg hh Y hY := by
    change KillE D Sc i β a ha n w ((h ≫ g) ≫ Y)
    rw [Category.assoc]
    exact hh _ (hg _ hY)
  add_mem' {g h} hg hh Y hY := by
    change KillE D Sc i β a ha n w ((g + h) ≫ Y)
    rw [Preadditive.add_comp]
    exact KillE.add (hg _ hY) (hh _ hY)
  algebraMap_mem' c Y hY := by
    rw [Algebra.algebraMap_eq_smul_one]
    change KillE D Sc i β a ha n w ((c • 𝟙 _) ≫ Y)
    rw [Linear.smul_comp, Category.id_comp]
    exact KillE.smul hY c

theorem mem_goodSubalgebra {g : End (wordObj D Sc (prependWord i w))} :
    g ∈ goodSubalgebra D Sc i β a ha n w ↔ GoodE D Sc i β a ha n w g := Iff.rfl

/-- Morphism-level square cancellation. -/
theorem KillE.of_sq_sub (c : End (wordObj D Sc w)) {Y : End (wordObj D Sc (prependWord i w))}
    (h : KillE D Sc i β a ha n w
      ((dotE D Sc (i :: w.1) 0 ^ 2 - (show End ((pres D Sc).obj (ob D (i :: w.1))) from
        (pres D Sc).obj (ob D [i]) ◁ c)) ≫ Y)) :
    KillE D Sc i β a ha n w Y := by
  unfold KillE at h ⊢
  rw [← End.mul_def, map_mul, map_sub, cornerMap_whiskerLeft, pow_two, map_mul,
    cornerMap_dotZero] at h
  refine PrependKills.of_sq_sub (FiniteHomMatrix.cornerMap w c) (h.of_eq ?_)
  set e := cornerUnit D Sc i w
  set f := affineFirstDot D Sc i (n + 1)
  have hee : e * e = e := by
    simp only [e, cornerUnit]
    rw [← map_mul, ← map_mul, one_mul]
  have hsq : e * f ^ 2 = f ^ 2 * e := (affineFirstDot_sq_comm D Sc i (n + 1) _)
  have hz := cornerMap_mul_cornerUnit (D := D) (Sc := Sc) (i := i) Y
  rw [mul_sub, mul_sub]
  congr 1
  calc FiniteHomMatrix.cornerMap (prependWord i w) Y * (f * e * (f * e))
      = FiniteHomMatrix.cornerMap (prependWord i w) Y * (f * (e * f) * e) := by
        simp only [mul_assoc]
    _ = FiniteHomMatrix.cornerMap (prependWord i w) Y * (f ^ 2 * e) := by
        have hef : e * f = f * e := cornerUnit_comm_firstDot
        rw [hef, pow_two]
        simp only [mul_assoc, hee]
    _ = FiniteHomMatrix.cornerMap (prependWord i w) Y * f ^ 2 := by
        rw [← hsq, ← mul_assoc, hz]

end Morphism

end OddMath.QuiverHecke
