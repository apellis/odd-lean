/-!
# The cyclotomic corner pairing

Ports the multiplication pairing underlying
`Categorification/TwoRep/CyclotomicRouqAdjunction.lean` to the actual
cyclotomic superbimodules. The evaluation is an even superbimodule map;
its balanced-tensor source retains the signs of odd morphisms.
-/

noncomputable section
open CategoryTheory StringDiagrams
open SuperBimodule
namespace OddMath.QuiverHecke
universe u v
variable {I k : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  [CommRing k] (Sc : SKM.Scalars D k) [Fintype I]
variable (i : I) (a : I → _root_.Polynomial k) (ha : CyclotomicPolynomialParity D a) (n : ℕ)

local notation "A" => CyclotomicAlgebra D Sc a n
local notation "B" => CyclotomicAlgebra D Sc a (n + 1)
local notation "GA" => cyclotomicParity D Sc a ha n
local notation "GB" => cyclotomicParity D Sc a ha (n + 1)
local notation "φ" => cyclotomicAppend D Sc i a n
local notation "P" => inductionCorner D Sc i a ha n
local notation "Q" => restrictionCorner D Sc i a ha n

/-- Homogeneity in the induction corner is inherited from the algebra. -/
theorem inductionCorner_mem_part_iff {p : ZMod 2} {x : (P).toSVec} :
    x ∈ (P).toSVec.part p ↔ x.1 ∈ GB p := by
  change x ∈ (SVec.sub _ _ _).part p ↔ _
  rw [SVec.mem_sub_part_iff, mem_regularSVec_part_iff]

/-- Homogeneity in the restriction corner is inherited from the algebra. -/
theorem restrictionCorner_mem_part_iff {p : ZMod 2} {x : (Q).toSVec} :
    x ∈ (Q).toSVec.part p ↔ x.1 ∈ GB p := by
  change x ∈ (SVec.sub _ _ _).part p ↔ _
  rw [SVec.mem_sub_part_iff, mem_regularSVec_part_iff]

/-- Multiplication of an induction element with a restriction element. -/
def cornerPairingBi : (P).toSVec →ₗ[k] (Q).toSVec →ₗ[k] B where
  toFun x :=
    { toFun := fun y => x.1 * y.1
      map_add' := fun y z => mul_add x.1 y.1 z.1
      map_smul' := fun c y => mul_smul_comm c x.1 y.1 }
  map_add' x y := by ext z; exact add_mul x.1 y.1 z.1
  map_smul' c x := by ext y; exact smul_mul_assoc c x.1 y.1

/-- The pairing descends through balancing over the lower cyclotomic algebra. -/
def cornerPairingLinear : (tensor P Q).toSVec →ₗ[k] B :=
  tensorLift (cornerPairingBi D Sc i a ha n) (fun x r y => mul_assoc x.1 (φ r) y.1)

@[simp] theorem cornerPairingLinear_btmul (x : (P).toSVec) (y : (Q).toSVec) :
    cornerPairingLinear D Sc i a ha n (btmul P Q x y) = x.1 * y.1 :=
  tensorLift_btmul _ _ x y

/-- The even colour-cut idempotent in the induction bimodule. -/
def inductionCornerIdempotent : (P).toSVec :=
  ⟨φ 1, by change φ 1 * φ 1 = φ 1; rw [← map_mul, mul_one]⟩

/-- The lower algebra maps into the restriction bimodule. -/
def restrictionCornerOf : A →ₗ[k] (Q).toSVec where
  toFun r := ⟨φ r, by change φ 1 * φ r = φ r; rw [← map_mul, one_mul]⟩
  map_add' r s := Subtype.ext (map_add φ r s)
  map_smul' c r := Subtype.ext (map_smul φ c r)

theorem inductionCornerIdempotent_mem :
    inductionCornerIdempotent D Sc i a ha n ∈ (P).toSVec.part 0 :=
  (inductionCorner_mem_part_iff D Sc i a ha n).mpr
    (cyclotomicAppend_parity D Sc i a ha n (SetLike.one_mem_graded GA))

/-- The linear coevaluation `a ↦ φ(a) ⊗ e`. -/
def cornerUnitLinear : A →ₗ[k] (tensor Q P).toSVec where
  toFun r := btmul Q P (restrictionCornerOf D Sc i a ha n r)
    (inductionCornerIdempotent D Sc i a ha n)
  map_add' r s := by rw [map_add, btmul_add_left]
  map_smul' c r := by rw [map_smul, btmul_smul_left]; rfl

@[simp] theorem cornerUnitLinear_apply (r : A) :
    cornerUnitLinear D Sc i a ha n r = btmul Q P (restrictionCornerOf D Sc i a ha n r)
      (inductionCornerIdempotent D Sc i a ha n) := rfl

/-- The first elementary triangular identity for the corner pairing. -/
@[simp] theorem cornerPairing_right_unit (x : (P).toSVec) :
    cornerPairingLinear D Sc i a ha n
      (btmul P Q x (restrictionCornerOf D Sc i a ha n 1)) = x.1 := by
  rw [cornerPairingLinear_btmul]
  exact x.2

/-- The second elementary triangular identity for the corner pairing. -/
@[simp] theorem cornerPairing_left_unit (y : (Q).toSVec) :
    cornerPairingLinear D Sc i a ha n
      (btmul P Q (inductionCornerIdempotent D Sc i a ha n) y) = y.1 := by
  rw [cornerPairingLinear_btmul]
  exact y.2

end OddMath.QuiverHecke
end

end

section

/-!
# Content idempotents in cyclotomic quotients

The content decomposition underlying BE2 §11 is formed in the finite-support
Hom algebra and descends along its cyclotomic quotient map. Multiplication
is composition with the right factor first. Content is an unordered multiset
of colours; no weight is assigned using strand number alone.
-/

noncomputable section
open CategoryTheory StringDiagrams
open scoped Classical
namespace OddMath.QuiverHecke
universe u v w
variable {I : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  {k : Type w} [CommRing k] (Sc : SKM.Scalars D k)

/-- The unordered colour content of a word. -/
def wordContent {n : ℕ} (s : Word I n) : Multiset I := s.1

private theorem content_act (g : PG) (t : List I) :
    (g.act t : Multiset I) = (t : Multiset I) := by
  cases g with
  | dot p => rfl
  | cross p =>
    simp only [PG.act]
    split
    · next x y r h =>
      have ht : t = t.take p ++ x :: y :: r := by
        rw [← h, List.take_append_drop]
      apply Quot.sound
      conv_rhs => rw [ht]
      exact (List.Perm.swap x y r).append_left (t.take p)
    · rfl

private theorem content_tgt (t : List I) (gs : List PG) :
    (tgt t gs : Multiset I) = (t : Multiset I) := by
  induction gs generalizing t with
  | nil => rfl
  | cons g gs ih => exact (ih (g.act t)).trans (content_act g t)

/-- Morphisms cannot change unordered colour content. -/
theorem hom_eq_zero_of_content_ne {s t : List I}
    (h : (s : Multiset I) ≠ (t : Multiset I))
    (f : (pres D Sc).obj (ob D s) ⟶ (pres D Sc).obj (ob D t)) : f = 0 := by
  induction f using (pres D Sc).hom_induction with
  | diag d =>
    obtain ⟨ls, hc, rfl⟩ := exists_mkD d
    have he := tgt_eq ((exists_pl hc).symm ▸ hc)
    exact (h ((content_tgt s (ls.map LayerData.pg)).symm.trans
      (congrArg (fun l : List I => (l : Multiset I)) he))).elim
  | zero => rfl
  | add f g hf hg => rw [hf, hg, add_zero]
  | smul c f hf => rw [hf, smul_zero]

variable [Fintype I]

/-- Sum of the word identities of a given content. -/
def contentIdempotent (n : ℕ) (β : Multiset I) : Hn D Sc n :=
  FiniteHomMatrix.localUnit (Finset.univ.filter (fun s => wordContent s = β))

@[simp] theorem contentIdempotent_sq (n : ℕ) (β : Multiset I) :
    contentIdempotent D Sc n β * contentIdempotent D Sc n β =
      contentIdempotent D Sc n β := FiniteHomMatrix.localUnit_sq _

private theorem content_mul_single {n : ℕ} (β : Multiset I) (s t : Word I n)
    (f : wordObj D Sc t ⟶ wordObj D Sc s) :
    contentIdempotent D Sc n β * FiniteHomMatrix.single s t f =
      if wordContent s = β then FiniteHomMatrix.single s t f else 0 := by
  split_ifs with h
  · exact FiniteHomMatrix.localUnit_mul_single _ _ _ _ (by simp [h])
  · unfold contentIdempotent FiniteHomMatrix.localUnit
    rw [Finset.sum_mul]
    apply Finset.sum_eq_zero
    intro b hb
    apply FiniteHomMatrix.single_mul_single_of_ne
    intro e
    subst b
    exact h (Finset.mem_filter.mp hb).2

private theorem single_mul_content {n : ℕ} (β : Multiset I) (s t : Word I n)
    (f : wordObj D Sc t ⟶ wordObj D Sc s) :
    FiniteHomMatrix.single s t f * contentIdempotent D Sc n β =
      if wordContent t = β then FiniteHomMatrix.single s t f else 0 := by
  split_ifs with h
  · exact FiniteHomMatrix.single_mul_localUnit _ _ _ _ (by simp [h])
  · unfold contentIdempotent FiniteHomMatrix.localUnit
    rw [Finset.mul_sum]
    apply Finset.sum_eq_zero
    intro b hb
    apply FiniteHomMatrix.single_mul_single_of_ne
    intro e
    subst b
    exact h (Finset.mem_filter.mp hb).2

/-- Content identities commute with every affine element, including odd ones. -/
theorem contentIdempotent_central (n : ℕ) (β : Multiset I) (z : Hn D Sc n) :
    contentIdempotent D Sc n β * z = z * contentIdempotent D Sc n β := by
  induction z using FiniteHomMatrix.induction with
  | hz => simp
  | ha a b ha hb => simp [mul_add, add_mul, ha, hb]
  | hs s t f =>
    rw [content_mul_single, single_mul_content]
    by_cases h : wordContent t = wordContent s
    · rw [h]
    · have hf := hom_eq_zero_of_content_ne D Sc h f
      simp [hf]

/-- Content idempotent in the specified cyclotomic quotient. -/
def cyclotomicContentIdempotent (a : I → _root_.Polynomial k) (n : ℕ)
    (β : Multiset I) : CyclotomicAlgebra D Sc a n :=
  cyclotomicMk D Sc a n (contentIdempotent D Sc (n + 1) β)

@[simp] theorem cyclotomicContentIdempotent_sq (a : I → _root_.Polynomial k)
    (n : ℕ) (β : Multiset I) :
    cyclotomicContentIdempotent D Sc a n β * cyclotomicContentIdempotent D Sc a n β =
      cyclotomicContentIdempotent D Sc a n β := by
  simp [cyclotomicContentIdempotent, ← map_mul]

theorem cyclotomicContentIdempotent_central (a : I → _root_.Polynomial k)
    (n : ℕ) (β : Multiset I) (z : CyclotomicAlgebra D Sc a n) :
    cyclotomicContentIdempotent D Sc a n β * z =
      z * cyclotomicContentIdempotent D Sc a n β := by
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact congrArg (cyclotomicMk D Sc a n) (contentIdempotent_central D Sc (n + 1) β z)

omit [Fintype I] in
/-- Rightmost strand insertion adds exactly its colour to content. -/
@[simp] theorem wordContent_append (i : I) {n : ℕ} (s : Word I n) :
    wordContent (appendWord i s) = {i} + wordContent s := by
  simp only [wordContent, appendWord, ← Multiset.coe_add, Multiset.coe_singleton,
    Multiset.add_comm]

/-- The affine inclusion shifts the content projector by the appended colour. -/
theorem contentIdempotent_appendAlgebra (i : I) (n : ℕ) (β : Multiset I)
    (z : Hn D Sc n) :
    contentIdempotent D Sc (n + 1) ({i} + β) * appendAlgebra D Sc i n z =
      appendAlgebra D Sc i n (contentIdempotent D Sc n β * z) := by
  induction z using FiniteHomMatrix.induction with
  | hz => simp
  | ha x y hx hy => simp only [map_add, mul_add, hx, hy]
  | hs s t f =>
    rw [content_mul_single]
    change contentIdempotent D Sc (n + 1) ({i} + β) *
      appendLinear D Sc i n (FiniteHomMatrix.single s t f) = _
    rw [appendLinear_single, content_mul_single, wordContent_append]
    simp only [add_right_inj]
    split_ifs
    · exact (appendLinear_single D Sc i t s f).symm
    · exact (map_zero (appendAlgebra D Sc i n)).symm

/-- The same projector identity holds on the cyclotomic quotient itself. -/
theorem cyclotomicContentIdempotent_append (i : I) (a : I → _root_.Polynomial k)
    (n : ℕ) (β : Multiset I) (z : CyclotomicAlgebra D Sc a n) :
    cyclotomicContentIdempotent D Sc a (n + 1) ({i} + β) *
        cyclotomicAppend D Sc i a n z =
      cyclotomicAppend D Sc i a n (cyclotomicContentIdempotent D Sc a n β * z) := by
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact congrArg (cyclotomicMk D Sc a (n + 1))
    (contentIdempotent_appendAlgebra D Sc i (n + 1) β z)

end OddMath.QuiverHecke
end

end

section

/-! # Content support of cyclotomic superinduction

The content blocks needed for BE2 §11 are full subcategories of the existing
cyclotomic supermodules. Their objects are modules on which the corresponding
central idempotent acts as the identity. Balanced-tensor induction adds its
colour to the content. This construction still has positive-height indexing.
-/

noncomputable section
open CategoryTheory StringDiagrams
namespace OddMath.QuiverHecke
universe u v
variable {I k : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  [CommRing k] (Sc : SKM.Scalars D k) [Fintype I]
variable (a : I → _root_.Polynomial k) (ha : CyclotomicPolynomialParity D a)

/-- A supermodule supported on the specified content block. -/
def ContentSupported (n : ℕ) (β : Multiset I)
    (M : CyclotomicSupermodules D Sc a ha n) : Prop :=
  ∀ m : M.toSVec, M.lact (cyclotomicContentIdempotent D Sc a n β) m = m

/-- The full subcategory retains all even and odd module morphisms. -/
abbrev CyclotomicContentModules (n : ℕ) (β : Multiset I) :=
  ObjectProperty.FullSubcategory (ContentSupported D Sc a ha n β)

/-- On the induction corner, the target content projector equals the right
source projector. Both sides use the actual cyclotomic multiplication. -/
theorem inductionCorner_content (i : I) (n : ℕ) (β : Multiset I)
    (x : (inductionCorner D Sc i a ha n).toSVec) :
    (inductionCorner D Sc i a ha n).lact
        (cyclotomicContentIdempotent D Sc a (n + 1) ({i} + β)) x =
      (inductionCorner D Sc i a ha n).ract
        (cyclotomicContentIdempotent D Sc a n β) x := by
  apply Subtype.ext
  change cyclotomicContentIdempotent D Sc a (n + 1) ({i} + β) * x.1 =
    x.1 * cyclotomicAppend D Sc i a n (cyclotomicContentIdempotent D Sc a n β)
  have he := cyclotomicContentIdempotent_append D Sc i a n β 1
  rw [mul_one] at he
  rw [cyclotomicContentIdempotent_central, ← he]
  rw [cyclotomicContentIdempotent_central D Sc a (n + 1) ({i} + β)
    (cyclotomicAppend D Sc i a n 1), ← mul_assoc, x.2]

/-- Balanced-tensor superinduction carries content `β` to `{i} + β`. -/
theorem contentSupported_induction (i : I) (n : ℕ) (β : Multiset I)
    (M : CyclotomicSupermodules D Sc a ha n) (hM : ContentSupported D Sc a ha n β M) :
    ContentSupported D Sc a ha (n + 1) ({i} + β)
      ((cyclotomicSuperInduction D Sc i a ha n).obj M) := by
  intro z
  change (SuperBimodule.tensor (inductionCorner D Sc i a ha n) M).lact _ z = z
  induction z using SuperBimodule.tensor_induction_on with
  | zero => exact map_zero _
  | add x y hx hy => rw [map_add, hx, hy]
  | btmul x m =>
    rw [SuperBimodule.lact_btmul, inductionCorner_content,
      SuperBimodule.btmul_ract_lact, hM m]

/-- Restriction of the existing induction functor to its content blocks. -/
def cyclotomicContentInduction (i : I) (n : ℕ) (β : Multiset I) :
    CyclotomicContentModules D Sc a ha n β ⥤
      CyclotomicContentModules D Sc a ha (n + 1) ({i} + β) where
  obj M := ⟨(cyclotomicSuperInduction D Sc i a ha n).obj M.obj,
    contentSupported_induction D Sc a ha i n β M.obj M.property⟩
  map f := ⟨(cyclotomicSuperInduction D Sc i a ha n).map f.hom⟩
  map_id M := InducedCategory.hom_ext ((cyclotomicSuperInduction D Sc i a ha n).map_id M.obj)
  map_comp f g := InducedCategory.hom_ext
    ((cyclotomicSuperInduction D Sc i a ha n).map_comp f.hom g.hom)

end OddMath.QuiverHecke
end

end
