/-!
# Super quotient

Part of the categorical action of the quiver Hecke 2-supercategory on deformed
cyclotomic quotients. Each section below was a separate file; its docstring describes it.
-/

section

/-!
# Cyclotomic quotients at fixed strand number

Ports the quotient-algebra input to
`Categorification/KLR/CyclotomicAbsentColour.lean`. The algebra is the existing
finite-support Hom algebra `Hn`, not a second presentation. Finitely many
colours provide a unit. The construction here concerns the underlying algebra;
a super grading on its quotient additionally requires homogeneous relations.
-/

noncomputable section
open CategoryTheory StringDiagrams
open scoped Classical
namespace OddMath.FiniteHomMatrix
universe u v w t
variable {k : Type u} [CommRing k] {C : Type v} [Category.{w} C]
  [Preadditive C] [Linear k C] {J : Type t} [Fintype J] (obj : J → C)

instance : One (Mat obj) := ⟨localUnit Finset.univ⟩

private theorem finite_one_mul (a : Mat obj) : 1 * a = a := by
  induction a using induction with
  | hz => exact mul_zero _
  | ha a b ha hb => rw [mul_add, ha, hb]
  | hs i j f => exact localUnit_mul_single _ _ _ _ (Finset.mem_univ _)

private theorem finite_mul_one (a : Mat obj) : a * 1 = a := by
  induction a using induction with
  | hz => exact zero_mul _
  | ha a b ha hb => rw [add_mul, ha, hb]
  | hs i j f => exact single_mul_localUnit _ _ _ _ (Finset.mem_univ _)

instance : Ring (Mat obj) where
  __ := (inferInstance : NonUnitalRing (Mat obj))
  one := localUnit Finset.univ
  one_mul := finite_one_mul obj
  mul_one := finite_mul_one obj
  natCast n := n • (1 : Mat obj)
  natCast_zero := zero_nsmul _
  natCast_succ n := succ_nsmul _ _
  intCast n := n • (1 : Mat obj)
  intCast_ofNat n := natCast_zsmul _ _
  intCast_negSucc n := by
    change Int.negSucc n • (1 : Mat obj) = -((n + 1 : ℕ) • (1 : Mat obj))
    simp only [Int.negSucc_eq, neg_zsmul, ← Int.natCast_succ, natCast_zsmul]

instance : Algebra k (Mat obj) :=
  Algebra.ofModule (fun c x y => smul_mul_assoc c x y)
    (fun c x y => by rw [mul_smul_comm])

end OddMath.FiniteHomMatrix

namespace OddMath.QuiverHecke
universe u v w
variable {I : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  {k : Type w} [CommRing k] (Sc : SKM.Scalars D k) [Fintype I]

instance wordFintype (n : ℕ) : Fintype (Word I n) :=
  inferInstanceAs (Fintype (List.Vector I n))

/-- A first-dot relation in its actual diagonal word corner. -/
def cyclotomicGenerator (a : I → _root_.Polynomial k) {n : ℕ} (w : Word I (n + 1)) :
    Hn D Sc (n + 1) :=
  FiniteHomMatrix.single w w
    (_root_.Polynomial.aeval (dotE D Sc w.1 0)
      (a (w.1.get ⟨0, by rw [w.2]; omega⟩)))

/-- The two-sided ideal generated by all first-dot polynomial relations. -/
def cyclotomicIdeal (a : I → _root_.Polynomial k) (n : ℕ) : Ideal (Hn D Sc (n + 1)) :=
  Ideal.span {z | ∃ (w : Word I (n + 1)) (b : Hn D Sc (n + 1)),
    z = cyclotomicGenerator D Sc a w * b}

instance cyclotomicIdeal_twoSided (a : I → _root_.Polynomial k) (n : ℕ) :
    (cyclotomicIdeal D Sc a n).IsTwoSided where
  mul_mem_of_left b hz := by
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨w, c, rfl⟩ := hz
      exact Submodule.subset_span ⟨w, c * b, mul_assoc _ _ _⟩
    | zero => simp
    | add x y _ _ hx hy =>
      rw [add_mul]
      exact Submodule.add_mem _ hx hy
    | smul c x _ hx =>
      change (c * x) * b ∈ _
      rw [mul_assoc]
      exact Ideal.mul_mem_left _ c hx

/-- Cyclotomic quotient of the existing affine Hom algebra at positive height. -/
abbrev CyclotomicAlgebra (a : I → _root_.Polynomial k) (n : ℕ) :=
  Hn D Sc (n + 1) ⧸ cyclotomicIdeal D Sc a n

/-- The quotient map retains the original affine algebra as its source. -/
def cyclotomicMk (a : I → _root_.Polynomial k) (n : ℕ) :
    Hn D Sc (n + 1) →ₐ[k] CyclotomicAlgebra D Sc a n :=
  Ideal.Quotient.mkₐ k _

@[simp] theorem cyclotomicMk_generator (a : I → _root_.Polynomial k) {n : ℕ}
    (w : Word I (n + 1)) :
    cyclotomicMk D Sc a n (cyclotomicGenerator D Sc a w) = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact Submodule.subset_span ⟨w, 1, (mul_one _).symm⟩

end OddMath.QuiverHecke
end

end

section

/-!
# Strand inclusion for cyclotomic induction

Ports the strand-inclusion input from
`Categorification/KLR/CyclotomicAbsentColour.lean` and
`Categorification/KLR/CyclotomicAction/Induction.lean`. The map adds a rightmost
strand to the existing Hom algebra. Its image of the identity is a colour-cut
idempotent, so it is not asserted to be unital.
-/

noncomputable section
open CategoryTheory StringDiagrams MonoidalCategory
open scoped Classical
namespace OddMath.QuiverHecke
universe u v w
variable {I : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  {k : Type w} [CommRing k] (Sc : SKM.Scalars D k)

/-- Append the induction colour to a word. -/
def appendWord (i : I) {n : ℕ} (w : Word I n) : Word I (n + 1) :=
  ⟨w.1 ++ [i], by simp [w.2]⟩

theorem appendWord_injective (i : I) (n : ℕ) : Function.Injective (appendWord i (n := n)) := by
  intro a b h
  apply Subtype.ext
  exact List.append_cancel_right (congrArg Subtype.val h)

/-- Appending an identity strand to an individual Hom entry. -/
def appendHom (i : I) {n : ℕ} (s t : Word I n) :
    (wordObj D Sc s ⟶ wordObj D Sc t) →ₗ[k]
      (wordObj D Sc (appendWord i s) ⟶ wordObj D Sc (appendWord i t)) where
  toFun f := f ▷ (pres D Sc).obj (ob D [i])
  map_add' f g := MonoidalSupercategory.add_whiskerRight (R := k) f g _
  map_smul' c f := MonoidalSupercategory.smul_whiskerRight (R := k) c f _

@[simp] theorem appendHom_comp (i : I) {n : ℕ} (r s t : Word I n)
    (f : wordObj D Sc r ⟶ wordObj D Sc s) (g : wordObj D Sc s ⟶ wordObj D Sc t) :
    appendHom D Sc i r t (f ≫ g) = appendHom D Sc i r s f ≫ appendHom D Sc i s t g :=
  MonoidalSupercategory.comp_whiskerRight (R := k) f g ((pres D Sc).obj (ob D [i]))

/-- The single-entry linear inclusion. -/
def appendEntry (i : I) {n : ℕ} (s t : Word I n) :
    (wordObj D Sc s ⟶ wordObj D Sc t) →ₗ[k] Hn D Sc (n + 1) where
  toFun f := FiniteHomMatrix.single (appendWord i t) (appendWord i s)
    (appendHom D Sc i s t f)
  map_add' := by intros; simp [FiniteHomMatrix.single, DFinsupp.single_add]
  map_smul' := by intros; simp [FiniteHomMatrix.single, DFinsupp.single_smul]

/-- The affine nonunital inclusion, extended entrywise and linearly. -/
def appendLinear (i : I) (n : ℕ) : Hn D Sc n →ₗ[k] Hn D Sc (n + 1) :=
  DFinsupp.lsum k fun p => appendEntry D Sc i p.2 p.1

@[simp] theorem appendLinear_single (i : I) {n : ℕ} (s t : Word I n)
    (f : wordObj D Sc s ⟶ wordObj D Sc t) :
    appendLinear D Sc i n (FiniteHomMatrix.single t s f) =
      FiniteHomMatrix.single (appendWord i t) (appendWord i s) (appendHom D Sc i s t f) := by
  let : DecidableEq (Word I n) := Classical.decEq _
  let : DecidableEq (Word I (n + 1)) := Classical.decEq _
  exact DFinsupp.lsum_single (S := k)
    (fun p : Word I n × Word I n => appendEntry D Sc i p.2 p.1) (t, s) f

theorem appendLinear_mul (i : I) (n : ℕ) (a b : Hn D Sc n) :
    appendLinear D Sc i n (a * b) = appendLinear D Sc i n a * appendLinear D Sc i n b := by
  induction a using FiniteHomMatrix.induction with
  | hz => simp
  | ha a b ha hb => simp [add_mul, ha, hb]
  | hs s t f =>
    induction b using FiniteHomMatrix.induction with
    | hz => simp
    | ha a b ha hb => simp [mul_add, ha, hb]
    | hs r q g =>
      by_cases h : t = r
      · subst r
        simp
      · have h' : appendWord i t ≠ appendWord i r := fun e => h (appendWord_injective i n e)
        simp [FiniteHomMatrix.single_mul_single_of_ne, h, h']

/-- The multiplication law is inherited from actual whiskering of diagrams. -/
def appendAlgebra (i : I) (n : ℕ) : Hn D Sc n →ₙₐ[k] Hn D Sc (n + 1) where
  toFun := appendLinear D Sc i n
  map_zero' := map_zero _
  map_add' := map_add _
  map_smul' := map_smul _
  map_mul' := appendLinear_mul D Sc i n

/-- Right whiskering is unital on each individual endomorphism ring. -/
def appendEnd (i : I) {n : ℕ} (w : Word I n) :
    End (wordObj D Sc w) →ₐ[k] End (wordObj D Sc (appendWord i w)) :=
  AlgHom.ofLinearMap (appendHom D Sc i w w)
    (MonoidalSupercategory.id_whiskerRight (R := k) (wordObj D Sc w)
      ((pres D Sc).obj (ob D [i])))
    (fun x y => appendHom_comp D Sc i w w w y x)

@[simp] theorem appendEnd_dot (i : I) {n : ℕ} (w : Word I (n + 1)) :
    appendEnd D Sc i w (dotE D Sc w.1 0) = dotE D Sc (appendWord i w).1 0 := by
  change dotE D Sc w.1 0 ▷ (pres D Sc).obj (ob D [i]) = _
  simp only [dotE_eq]
  erw [cl_whiskerRight]
  · rfl
  · intro g hg
    simp only [List.mem_singleton] at hg
    subst g
    simp [PG.pos, PG.width, w.2]

variable [Fintype I]

omit [Fintype I] in
@[simp] theorem appendAlgebra_generator (i : I) (a : I → _root_.Polynomial k)
    {n : ℕ} (w : Word I (n + 1)) :
    appendAlgebra D Sc i (n + 1) (cyclotomicGenerator D Sc a w) =
      cyclotomicGenerator D Sc a (appendWord i w) := by
  change appendLinear D Sc i (n + 1) (FiniteHomMatrix.single w w _) = _
  rw [appendLinear_single]
  change FiniteHomMatrix.single _ _ (appendEnd D Sc i w
    (_root_.Polynomial.aeval (R := k) (dotE D Sc w.1 0) _)) = _
  erw [← _root_.Polynomial.aeval_algHom_apply, appendEnd_dot]
  congr 2
  apply congrArg a
  simp [appendWord, List.get_eq_getElem, List.getElem_append_left, w.2]

/-- The affine inclusion preserves the actual two-sided cyclotomic ideal. -/
theorem appendAlgebra_mem_ideal (i : I) (a : I → _root_.Polynomial k) (n : ℕ)
    {z : Hn D Sc (n + 1)} (hz : z ∈ cyclotomicIdeal D Sc a n) :
    appendAlgebra D Sc i (n + 1) z ∈ cyclotomicIdeal D Sc a (n + 1) := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨w, b, rfl⟩ := hz
    rw [map_mul, appendAlgebra_generator]
    exact Submodule.subset_span ⟨appendWord i w, appendAlgebra D Sc i (n + 1) b, rfl⟩
  | zero => simp
  | add x y _ _ hx hy =>
    rw [map_add]
    exact Submodule.add_mem _ hx hy
  | smul c x _ hx =>
    change appendAlgebra D Sc i (n + 1) (c * x) ∈ _
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ hx

/-- Strand inclusion descends to the actual cyclotomic quotients. -/
def cyclotomicAppendLinear (i : I) (a : I → _root_.Polynomial k) (n : ℕ) :
    CyclotomicAlgebra D Sc a n →ₗ[k] CyclotomicAlgebra D Sc a (n + 1) :=
  (cyclotomicIdeal D Sc a n).restrictScalars k |>.mapQ
    ((cyclotomicIdeal D Sc a (n + 1)).restrictScalars k)
    (appendLinear D Sc i (n + 1)) (fun _ hz => appendAlgebra_mem_ideal D Sc i a n hz)

@[simp] theorem cyclotomicAppendLinear_mk (i : I) (a : I → _root_.Polynomial k)
    (n : ℕ) (z : Hn D Sc (n + 1)) :
    cyclotomicAppendLinear D Sc i a n (cyclotomicMk D Sc a n z) =
      cyclotomicMk D Sc a (n + 1) (appendAlgebra D Sc i (n + 1) z) := rfl

/-- The descended inclusion respects multiplication, but need not preserve one. -/
def cyclotomicAppend (i : I) (a : I → _root_.Polynomial k) (n : ℕ) :
    CyclotomicAlgebra D Sc a n →ₙₐ[k] CyclotomicAlgebra D Sc a (n + 1) where
  toFun := cyclotomicAppendLinear D Sc i a n
  map_zero' := map_zero _
  map_add' := map_add _
  map_smul' := map_smul _
  map_mul' x y := by
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    change cyclotomicAppendLinear D Sc i a n
      (cyclotomicMk D Sc a n x * cyclotomicMk D Sc a n y) = _
    rw [← map_mul, cyclotomicAppendLinear_mk, map_mul, map_mul]
    rfl

end OddMath.QuiverHecke
end

end

section

/-!
# The signed dot slide for strand induction

Ports the dot-intertwining step of
`Categorification/KLR/CyclotomicAction/Slides.lean` and
`Categorification/KLR/CyclotomicAction/Induction.lean`. The ordinary intertwiner
condition is replaced by the homogeneous super-intertwiner condition. These
are actual affine Hom morphisms; descent of their parity to the cyclotomic
supercategory is a separate obligation.
-/

noncomputable section
open CategoryTheory StringDiagrams MonoidalCategory
namespace OddMath.QuiverHecke
universe u v w
variable {I : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  {k : Type w} [CommRing k] (Sc : SKM.Scalars D k)

/-- The one-strand dot, with its literal generator diagram. -/
def inductionStrandDot (i : I) :
    End ((pres D Sc).obj (ob D [i])) :=
  (pres D Sc).diag (mkD D [([], .dot i, [])] ⟨rfl, rfl⟩)

theorem inductionStrandDot_parity (i : I) :
    inductionStrandDot D Sc i ∈ Supercategory.parity (R := k)
      ((pres D Sc).obj (ob D [i])) ((pres D Sc).obj (ob D [i])) (D.parity i) := by
  apply Presentation.diag_mem_homDeg'
  simp [degree_parity_mkD, Shape.parity]

/-- The new dot on a word is the rightmost whiskered generator. -/
def inductionLastDot (i : I) {n : ℕ} (w : Word I n) :
    End (wordObj D Sc (appendWord i w)) :=
  wordObj D Sc w ◁ inductionStrandDot D Sc i

/-- Moving the new dot past a homogeneous old morphism has its Koszul sign. -/
theorem induction_dot_slide (i : I) {n : ℕ} (s t : Word I n) {p : ZMod 2}
    (f : wordObj D Sc s ⟶ wordObj D Sc t)
    (hf : f ∈ Supercategory.parity (R := k) (wordObj D Sc s) (wordObj D Sc t) p) :
    appendHom D Sc i s t f ≫ inductionLastDot D Sc i t =
      Supercategory.koszulSign p (D.parity i) •
        (inductionLastDot D Sc i s ≫ appendHom D Sc i s t f) :=
  MonoidalSupercategory.super_interchange hf (inductionStrandDot_parity D Sc i)

end OddMath.QuiverHecke
end

end

section

/-!
# Parity input for cyclotomic induction

Ports the grading prerequisite for
`Categorification/KLR/CyclotomicAction/Induction.lean` to the quiver Hecke
superalgebra. Parity does not require an integer symmetrizer or integer
homogeneity of the parameters. The homogeneous-ideal theorem retains its
explicit generator-homogeneity premise.
-/

noncomputable section
open CategoryTheory StringDiagrams
open scoped Classical
namespace OddMath.QuiverHecke
universe u v w
variable {I : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  {k : Type w} [CommRing k] (Sc : SKM.Scalars D k) [Fintype I]

/-- Entrywise parity, independently of the integer grading. -/
def affineParity (n : ℕ) (p : ZMod 2) : Submodule k (Hn D Sc n) :=
  FiniteHomMatrix.component
    (fun q => Supercategory.parity (R := k) (wordObj D Sc q.2) (wordObj D Sc q.1)) p

omit [Fintype I] in
theorem affineParity_internal (n : ℕ) : DirectSum.IsInternal (affineParity D Sc n) :=
  FiniteHomMatrix.isInternal_component _ fun _ => Supercategory.isInternal _ _

instance affineParity_graded (n : ℕ) : GradedAlgebra (affineParity D Sc n) where
  __ := (affineParity_internal D Sc n).chooseDecomposition
  one_mem := by
    change FiniteHomMatrix.localUnit Finset.univ ∈ _
    apply Submodule.sum_mem
    intro i _
    exact FiniteHomMatrix.single_mem_component i i (Supercategory.id_mem (R := k) _)
  mul_mem p q := by
    intro x y ha hb
    apply FiniteHomMatrix.mul_mem_component _ _ ha hb
    intro i j l p q f g hf hg
    simpa only [add_comm] using Supercategory.comp_mem hg hf

/-- The two-sided cyclotomic ideal is homogeneous if its first-dot
polynomial generators are homogeneous. Arbitrary right multipliers are
expanded into homogeneous components rather than assumed homogeneous. -/
theorem cyclotomicIdeal_homogeneous (a : I → _root_.Polynomial k) (n : ℕ)
    (ha : ∀ w : Word I (n + 1),
      SetLike.IsHomogeneousElem (affineParity D Sc (n + 1)) (cyclotomicGenerator D Sc a w)) :
    (cyclotomicIdeal D Sc a n).IsHomogeneous (affineParity D Sc (n + 1)) := by
  let G := affineParity D Sc (n + 1)
  let S : Set (Hn D Sc (n + 1)) := {z | ∃ (w : Word I (n + 1)) (b : Hn D Sc (n + 1)),
    SetLike.IsHomogeneousElem G b ∧ z = cyclotomicGenerator D Sc a w * b}
  have hS : (Ideal.span S).IsHomogeneous G := by
    apply Ideal.homogeneous_span
    rintro z ⟨w, b, hb, rfl⟩
    exact (ha w).mul hb
  have he : cyclotomicIdeal D Sc a n = Ideal.span S := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      rintro z ⟨w, b, rfl⟩
      induction b using DirectSum.Decomposition.inductionOn G with
      | zero => simp
      | @homogeneous p b => exact Ideal.subset_span ⟨w, b, ⟨p, b.property⟩, rfl⟩
      | add b c hb hc =>
        rw [mul_add]
        exact Ideal.add_mem _ hb hc
    · apply Ideal.span_le.mpr
      rintro z ⟨w, b, _, rfl⟩
      exact Ideal.subset_span ⟨w, b, rfl⟩
  rw [he]
  exact hS

/-- With even coefficients, all nonzero terms of a cyclotomic polynomial
must have the same parity as its leading term. -/
def CyclotomicPolynomialParity (a : I → _root_.Polynomial k) : Prop :=
  ∀ i m, (a i).coeff m ≠ 0 → m • D.parity i = (a i).natDegree • D.parity i

omit [Fintype I] in
theorem firstDot_parity (i : I) (t : List I) :
    dotE D Sc (i :: t) 0 ∈ Supercategory.parity (R := k)
      ((pres D Sc).obj (ob D (i :: t))) ((pres D Sc).obj (ob D (i :: t))) (D.parity i) := by
  rw [dotE_eq]
  apply Presentation.diag_mem_homDeg'
  simp [degree_parity_mkD, pl, PG.ld, Shape.parity]

omit [Fintype I] in
theorem firstDot_pow_parity (i : I) (t : List I) (m : ℕ) :
    dotE D Sc (i :: t) 0 ^ m ∈ Supercategory.parity (R := k)
      ((pres D Sc).obj (ob D (i :: t))) ((pres D Sc).obj (ob D (i :: t))) (m • D.parity i) := by
  induction m with
  | zero => exact Supercategory.id_mem (R := k) _
  | succ m ih =>
    simpa only [pow_succ, End.mul_def, succ_nsmul, add_comm] using
      Supercategory.comp_mem (firstDot_parity D Sc i t) ih

omit [Fintype I] in
/-- Homogeneous coefficient support gives homogeneous actual generators. -/
theorem cyclotomicGenerator_parity (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) {n : ℕ} (w : Word I (n + 1)) :
    SetLike.IsHomogeneousElem (affineParity D Sc (n + 1)) (cyclotomicGenerator D Sc a w) := by
  rcases w with ⟨l, hl⟩
  cases l with
  | nil => simp at hl
  | cons i t =>
    refine ⟨(a i).natDegree • D.parity i, ?_⟩
    apply FiniteHomMatrix.single_mem_component
    change _root_.Polynomial.aeval (dotE D Sc (i :: t) 0) (a i) ∈
      Supercategory.parity (R := k) _ _ ((a i).natDegree • D.parity i)
    rw [_root_.Polynomial.aeval_def, _root_.Polynomial.eval₂_eq_sum]
    change (∑ m ∈ (a i).support, algebraMap k _ ((a i).coeff m) * dotE D Sc (i :: t) 0 ^ m) ∈ _
    apply Submodule.sum_mem
    intro m hm
    rw [← Algebra.smul_def]
    apply Submodule.smul_mem
    rw [← ha i m (_root_.Polynomial.mem_support_iff.mp hm)]
    exact firstDot_pow_parity D Sc i t m

/-- The homogeneous-polynomial criterion closes the ideal-homogeneity premise. -/
theorem cyclotomicIdeal_homogeneous_of_polynomials (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) :
    (cyclotomicIdeal D Sc a n).IsHomogeneous (affineParity D Sc (n + 1)) :=
  cyclotomicIdeal_homogeneous D Sc a n (cyclotomicGenerator_parity D Sc a ha)

end OddMath.QuiverHecke
end

end

section

/-!
# The actual cyclotomic quotient as a superalgebra

Ports the graded-algebra input to
`Categorification/KLR/CyclotomicAction/Induction.lean`. The superspace carrier
is the already constructed cyclotomic quotient, not a new presentation.
-/

noncomputable section
open CategoryTheory StringDiagrams
open scoped Classical
namespace OddMath.QuiverHecke
universe u v
variable {I k : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  [CommRing k] (Sc : SKM.Scalars D k) [Fintype I]

private theorem affine_algProj_eq (n : ℕ) (p : ZMod 2) (x : Hn D Sc n) :
    SuperBimodule.algProj (affineParity D Sc n) p x =
      GradedAlgebra.proj (affineParity D Sc n) p x := by
  induction x using DirectSum.Decomposition.inductionOn (affineParity D Sc n) with
  | zero => simp
  | add x y hx hy => simp [map_add, hx, hy]
  | @homogeneous q x =>
    by_cases h : q = p
    · subst q
      rw [SuperBimodule.algProj_of_mem _ x.property]
      simp [GradedAlgebra.proj_apply, DirectSum.decompose_coe]
    · rw [SuperBimodule.algProj_of_mem_ne _ x.property h]
      simp only [GradedAlgebra.proj_apply, DirectSum.decompose_coe,
        DirectSum.of_eq_of_ne _ _ _ (Ne.symm h), ZeroMemClass.coe_zero]

/-- The genuine cyclotomic ideal, stable under parity projection. -/
def cyclotomicGradedSubmodule (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) :
    SVec.GradedSubmodule (SuperBimodule.regularSVec (affineParity D Sc (n + 1))) where
  toSubmodule := (cyclotomicIdeal D Sc a n).restrictScalars k
  odd_mem x hx := by
    change SuperBimodule.algProj (affineParity D Sc (n + 1)) 1 x ∈ _
    rw [affine_algProj_eq]
    exact cyclotomicIdeal_homogeneous_of_polynomials D Sc a ha n 1 hx

/-- Parity on the existing cyclotomic quotient. -/
def cyclotomicSuperspace (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) : SVec k :=
  SVec.quot (SuperBimodule.regularSVec (affineParity D Sc (n + 1)))
    (cyclotomicGradedSubmodule D Sc a ha n)

/-- Homogeneous submodules of the actual quotient algebra. -/
def cyclotomicParity (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) (p : ZMod 2) :
    Submodule k (CyclotomicAlgebra D Sc a n) :=
  (cyclotomicSuperspace D Sc a ha n).part p

theorem cyclotomicMk_parity (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) {p : ZMod 2}
    {x : Hn D Sc (n + 1)} (hx : x ∈ affineParity D Sc (n + 1) p) :
    cyclotomicMk D Sc a n x ∈ cyclotomicParity D Sc a ha n p :=
  SVec.quotMkFun_mem_part _ _ ((SuperBimodule.mem_regularSVec_part_iff _).mpr hx)

/-- Every homogeneous quotient vector has a homogeneous affine representative. -/
theorem cyclotomicParity_lift (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) {p : ZMod 2}
    {x : CyclotomicAlgebra D Sc a n} (hx : x ∈ cyclotomicParity D Sc a ha n p) :
    ∃ y ∈ affineParity D Sc (n + 1) p, cyclotomicMk D Sc a n y = x := by
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  refine ⟨SuperBimodule.algProj (affineParity D Sc (n + 1)) p y,
    SuperBimodule.algProj_mem _ _ _, ?_⟩
  change SVec.quotMkFun (SuperBimodule.regularSVec (affineParity D Sc (n + 1)))
    (cyclotomicGradedSubmodule D Sc a ha n) (SuperBimodule.algProj _ p y) =
    SVec.quotMkFun (SuperBimodule.regularSVec (affineParity D Sc (n + 1)))
      (cyclotomicGradedSubmodule D Sc a ha n) y
  rw [← SuperBimodule.regularSVec_proj, ← SVec.quot_proj_mk]
  exact (SVec.mem_part_iff _).mp hx

instance cyclotomicParity_graded (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) :
    GradedAlgebra (cyclotomicParity D Sc a ha n) where
  __ := (SVec.isInternal_part (cyclotomicSuperspace D Sc a ha n)).chooseDecomposition
  one_mem := cyclotomicMk_parity D Sc a ha n (SetLike.one_mem_graded _)
  mul_mem p q := by
    intro x y hx hy
    obtain ⟨x, hx', rfl⟩ := cyclotomicParity_lift D Sc a ha n hx
    obtain ⟨y, hy', rfl⟩ := cyclotomicParity_lift D Sc a ha n hy
    rw [← map_mul]
    exact cyclotomicMk_parity D Sc a ha n (SetLike.GradedMul.mul_mem hx' hy')

omit [Fintype I] in
/-- The affine strand inclusion is parity preserving. -/
theorem appendAlgebra_parity (i : I) (n : ℕ) {p : ZMod 2} {x : Hn D Sc n}
    (hx : x ∈ affineParity D Sc n p) :
    appendAlgebra D Sc i n x ∈ affineParity D Sc (n + 1) p := by
  change appendLinear D Sc i n x ∈ _
  rw [FiniteHomMatrix.eq_sum_single x, map_sum]
  apply Submodule.sum_mem
  intro q _
  rw [appendLinear_single]
  apply FiniteHomMatrix.single_mem_component
  exact MonoidalSupercategory.whiskerRight_mem ((pres D Sc).obj (ob D [i])) (hx q)

/-- The genuine cyclotomic inclusion is an even nonunital algebra map. -/
theorem cyclotomicAppend_parity (i : I) (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) {p : ZMod 2}
    {x : CyclotomicAlgebra D Sc a n} (hx : x ∈ cyclotomicParity D Sc a ha n p) :
    cyclotomicAppend D Sc i a n x ∈ cyclotomicParity D Sc a ha (n + 1) p := by
  obtain ⟨x, hx', rfl⟩ := cyclotomicParity_lift D Sc a ha n hx
  change cyclotomicAppendLinear D Sc i a n (cyclotomicMk D Sc a n x) ∈ _
  rw [cyclotomicAppendLinear_mk]
  exact cyclotomicMk_parity D Sc a ha (n + 1) (appendAlgebra_parity D Sc i (n + 1) hx')

/-- The supercategory of left supermodules over the actual quotient. -/
abbrev CyclotomicSupermodules (a : I → _root_.Polynomial k)
    (ha : CyclotomicPolynomialParity D a) (n : ℕ) :=
  SuperBimodule (cyclotomicParity D Sc a ha n) (trivialGrading k)

end OddMath.QuiverHecke
end

end

