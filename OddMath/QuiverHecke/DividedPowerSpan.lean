/-!
# `K₀(Ḣ_{q,π})` is spanned by products of divided powers

Brundan–Ellis, arXiv:1701.04133v2, Theorem 11.3, surjectivity: over a field, the classes
`[Q^n Π^p P(i₁^{(a₁)}) ⋯ P(i_r^{(a_r)})]` of shifted products of the divided-power projectives
(11.3) generate `K₀(Ḣ_{q,π})` as an abelian group (`mk_mem_dpSpan`).

The proof is Khovanov–Lauda's, arXiv:0803.4121v2, §3.2 (Proposition 3.18 and the lemmas before
it), here for projectives only. By induction on the length `m` of a word, and for fixed `m` by
descending induction on the length `ε` of an `i`-tail, every indecomposable summand `Y` of a word
`s i^ε` has class in the span. Decompose `s = ⊕ Z_a` into indecomposables; `Y` is then a summand
of some `Z_a ⊗ P(i^{(ε)})` (Lemma 11.1). Of the summands of `Z_a ⊗ P(i^{(ε)})`, all but at most
one are summands of words ending in `i^{ε+1}` (`tail_idempotent_mem_tailJ`), whose classes are in
the span by induction; and `[Z_a ⊗ P(i^{(ε)})] = [Z_a][P(i^{(ε)})]` is in the span because
`[Z_a]` is.

## Main declarations

* `dpIdem i r`: the divided-power idempotent `1_{i^{(r)}}` on `iʳ`, of either parity.
* `IsDPProduct t e`: `(t, e)` is a product `(i₁^{a₁} ⋯ i_r^{a_r}, 1_{i₁^{(a₁)}} ⊗ ⋯)`.
* `dpSpan`: the subgroup of `K₀(Ḣ_{q,π})` generated by the shifted products.
* `mk_mem_dpSpan`: every class lies in `dpSpan`.
-/

noncomputable section

open CategoryTheory StringDiagrams MonoidalCategory GradedSupercategory KrullSchmidt
open CategoryTheory.Idempotents OddMath.SKM.Summands
open OddMath.Frontier OddMath.SKM.DividedPowerDecomposition OddMath.SKM.DividedPowerIdempotents
open OddMath.QuiverHecke.DividedPowerModules OddMath.QuiverHecke.CategoricalDividedPowers
open BoxPartitionCount

namespace OddMath.QuiverHecke

universe u v w

variable {I : Type u} {X : Type v} [AddCommGroup X] (D : SKM.Datum I X)
  {k : Type w} [Field k] (Sc : SKM.Scalars D k) (sy : SKM.Symmetrizer D)
  (hc : Sc.Homogeneous)

/-! ## Words -/

section Words

variable {D Sc sy hc}

theorem length_eq_of_sChain {t t' : List I} {ls : List (LayerData I)} (h : SChain t ls t') :
    t'.length = t.length := by
  induction ls generalizing t with
  | nil => exact (congrArg List.length h).symm
  | cons x ls ih =>
    obtain ⟨rfl, h⟩ := h
    rw [ih h]
    rcases x with ⟨l, g, r⟩
    cases g <;> simp [Shape.dom, Shape.cod]

/-- Maps between words of different lengths vanish. -/
theorem eq_zero_of_length_ne {t t' : List I} {n : ℤ} {p : ZMod 2}
    {x : hObj D Sc sy hc t ⟶ hObj D Sc sy hc t'} (hx : x ∈ homPiece D Sc sy hc t t' n p)
    (h : t'.length ≠ t.length) : x = 0 := by
  rw [homPiece_eq_span] at hx
  rw [← Submodule.mem_bot k]
  refine (Submodule.span_le.2 ?_) hx
  rintro _ ⟨j, -, rfl⟩
  exact absurd (length_eq_of_sChain j.2.2.2) h

theorem nil_pl (gs : List PG) : pl ([] : List I) gs = [] := by
  induction gs with
  | nil => rfl
  | cons g gs ih => cases g <;> simp_all [pl, PG.ld, PG.act]

/-- `End(∅)` is `k`. -/
theorem mem_span_id_nil (g : HEnd D Sc sy hc []) : g ∈ k ∙ 𝟙 (hObj D Sc sy hc []) := by
  have hg : g ∈ Submodule.span k (Set.range fun m : NFIdx ([] : List I) [] =>
      (m.nf (D := D) (Sc := Sc) : hObj D Sc sy hc [] ⟶ hObj D Sc sy hc [])) := by
    rw [span_nf]; trivial
  refine (Submodule.span_le.2 ?_) hg
  rintro _ ⟨m, rfl⟩
  change cl D Sc [] [] _ m.2.2.2 ∈ _
  rw [cl_eq_one_of_pl_eq_nil D Sc (nil_pl _) m.2.2.2]
  exact Submodule.mem_span_singleton_self _

end Words

/-! ## Divided-power idempotents -/

section DividedPower

theorem parity_eq_one_of_ne_zero {i : I} (h : D.parity i ≠ 0) : D.parity i = 1 :=
  (Supercategory.parity_eq_zero_or_one _).resolve_left h

variable (i : I) (r : ℕ)

/-- The divided-power idempotent `1_{i^{(r)}}` on `iʳ` (BE2 §11): `D_{w₀}` for an even colour and
its odd analogue for an odd colour. -/
def dpIdem : HEnd D Sc sy hc (List.replicate r i) :=
  if hi : D.parity i = 0 then evenCornerProjector D Sc i hi r
  else oddCornerProjector D Sc i (parity_eq_one_of_ne_zero D hi) r

theorem dpIdem_idem : dpIdem D Sc sy hc i r ≫ dpIdem D Sc sy hc i r = dpIdem D Sc sy hc i r := by
  unfold dpIdem
  split_ifs with hi
  · exact (evenCornerProjector_idempotent D Sc i hi r).eq
  · exact oddCornerProjector_idempotent D Sc i _ r

theorem dpIdem_mem :
    dpIdem D Sc sy hc i r ∈ homPiece D Sc sy hc (List.replicate r i) (List.replicate r i) 0 0 := by
  unfold dpIdem
  split_ifs with hi
  · exact ⟨evenCornerProjector_degree D Sc sy hc i hi r, evenCornerProjector_even D Sc sy hc i hi r⟩
  · match r with
    | 0 => exact ⟨GradedSupercategory.id_mem_degree _, Supercategory.id_mem _⟩
    | 1 => exact ⟨GradedSupercategory.id_mem_degree _, Supercategory.id_mem _⟩
    | n + 2 =>
      exact ⟨oddCornerProjector_degree D Sc sy hc i _ n, oddCornerProjector_even D Sc sy hc i _ n⟩

/-- `1_{i^{(r)}} c 1_{i^{(r)}} ∈ k 1_{i^{(r)}}` for `c` of degree `≤ 0`. -/
theorem dpIdem_corner {n : ℤ} {p : ZMod 2} {c : HEnd D Sc sy hc (List.replicate r i)}
    (hc' : c ∈ homPiece D Sc sy hc (List.replicate r i) (List.replicate r i) n p) (hn : n ≤ 0) :
    dpIdem D Sc sy hc i r ≫ c ≫ dpIdem D Sc sy hc i r ∈ k ∙ dpIdem D Sc sy hc i r := by
  unfold dpIdem
  split_ifs with hi
  · have h := evenCornerProjector_mul_mul_mem D Sc sy i hi r hc hn (g := c) hc'.1
    rwa [End.mul_def, End.mul_def] at h
  · have h := oddCornerProjector_mul_mul_mem D Sc sy i (parity_eq_one_of_ne_zero D hi) hc r hn
      (g := c) hc'.1
    rwa [End.mul_def, End.mul_def] at h

/-- Lemma 11.1 as a splitting: `1_{iʳ} = ∑_c λ_c σ_c` with `σ_c` of degree `m_c`, `λ_c` of
degree `-m_c`, both of parity `q_c`, and `1_{i^{(r)}} σ_c = σ_c`, `λ_c 1_{i^{(r)}} = λ_c`. -/
theorem exists_dpSplitting :
    ∃ (C : Type) (_ : Fintype C) (m : C → ℤ) (q : C → ZMod 2)
      (σ lam : C → HEnd D Sc sy hc (List.replicate r i)),
      (∀ c, σ c ∈ homPiece D Sc sy hc _ _ (m c) (q c)) ∧
      (∀ c, lam c ∈ homPiece D Sc sy hc _ _ (-m c) (q c)) ∧
      ∑ c, lam c ≫ σ c = 𝟙 _ ∧ (∀ c, dpIdem D Sc sy hc i r ≫ σ c = σ c) ∧
      (∀ c, lam c ≫ dpIdem D Sc sy hc i r = lam c) := by
  by_cases hi : D.parity i = 0
  · let S := evenCornerSplitting D Sc i hi r
    refine ⟨evenIndex r, inferInstance, fun j => evenShift r j * sy.d i, fun _ => 0,
      fun j => evenSigma D Sc i hi r j, fun j => evenLam D Sc i hi r j, fun j => ⟨?_, ?_⟩,
      fun j => ⟨?_, ?_⟩, S.sum_eq, fun j => ?_, fun j => ?_⟩
    · have h := evenSigma_mem D Sc i hi (gdeg_dot_eq D sy) (gdeg_cross_self_eq D sy) r j
      rw [smul_eq_mul] at h
      exact h
    · have h := evenSigma_mem D Sc i hi (parityDeg_dot_eq hi) (parityDeg_cross_self_eq hi) r j
      rw [smul_zero] at h
      exact h
    · have h := evenLam_mem D Sc i hi (gdeg_dot_eq D sy) (gdeg_cross_self_eq D sy) r j
      rw [smul_eq_mul, neg_mul] at h
      exact h
    · have h := evenLam_mem D Sc i hi (parityDeg_dot_eq hi) (parityDeg_cross_self_eq hi) r j
      rw [smul_zero] at h
      exact h
    · simp only [dpIdem, dite_eq_left hi]; exact S.sigma_mul j
    · simp only [dpIdem, dite_eq_left hi]; exact S.mul_lam j
  · have hi' := parity_eq_one_of_ne_zero D hi
    match r with
    | 0 | 1 =>
      refine ⟨Unit, inferInstance, fun _ => 0, fun _ => 0, fun _ => 𝟙 _, fun _ => 𝟙 _,
        fun _ => ⟨GradedSupercategory.id_mem_degree _, Supercategory.id_mem _⟩,
        fun _ => ⟨by simpa using GradedSupercategory.id_mem_degree _, Supercategory.id_mem _⟩,
        by simp, fun _ => ?_, fun _ => ?_⟩ <;>
      simp [dpIdem, dite_eq_right hi, DividedPowerModules.oddCornerProjector]
    | n + 2 =>
      let S := oddCornerSplitting D Sc i hi' n
      refine ⟨Sq (n + 2), inferInstance, fun ℓ => 2 * sy.d i * shift n ℓ,
        fun ℓ => (shift n ℓ : ZMod 2), fun ℓ => S.σ ℓ, fun ℓ => S.lam ℓ,
        fun ℓ => ⟨oddNilHecke_mem_integerDegree D Sc sy i hi' (sigma_degree n ℓ),
          oddNilHecke_mem_parity D Sc i hi' (sigma_degree n ℓ)⟩, fun ℓ => ⟨?_, ?_⟩,
        S.sum_eq, fun ℓ => ?_, fun ℓ => ?_⟩
      · have h := oddNilHecke_mem_integerDegree D Sc sy i hi' (lam_degree n ℓ)
        rw [mul_neg] at h
        exact h
      · have h := oddNilHecke_mem_parity D Sc i hi' (lam_degree n ℓ)
        rw [Int.cast_neg, ZMod.neg_eq_self_mod_two] at h
        exact h
      · simp only [dpIdem, dite_eq_right hi]; exact S.sigma_mul ℓ
      · simp only [dpIdem, dite_eq_right hi]; exact S.mul_lam ℓ

end DividedPower

/-! ## Products of divided powers -/

section Products

variable {D Sc sy hc}

section TailT

variable {s : List I} {i : I} {ε : ℕ} {b : HEnd D Sc sy hc (List.replicate ε i)}
  {z : HEnd D Sc sy hc s}

theorem tailT_mem_homPiece
    (hb0 : b ∈ homPiece D Sc sy hc (List.replicate ε i) (List.replicate ε i) 0 0)
    (hz0 : z ∈ homPiece D Sc sy hc s s 0 0) :
    tailT s b z ∈ homPiece D Sc sy hc (s ++ List.replicate ε i) (s ++ List.replicate ε i) 0 0 :=
  mem_homPiece_cast (comp_mem_homPiece (whiskerLeft_mem_homPiece s hb0)
    (whiskerRight_mem_homPiece _ hz0)) (add_zero 0) (add_zero 0)

theorem tailT_idem (hb : b ≫ b = b)
    (hb0 : b ∈ homPiece D Sc sy hc (List.replicate ε i) (List.replicate ε i) 0 0)
    (hz : z ≫ z = z) (hz0 : z ∈ homPiece D Sc sy hc s s 0 0) :
    tailT s b z ≫ tailT s b z = tailT s b z := by
  rw [tailT_comp hb hb0 hz0.2, hz]

/-- The horizontal composite `z ⋆ b` of `MonoidalTwo` is `T(z) = z ⊗ b`. -/
theorem hcomp_eq_tailT
    (hb0 : b ∈ homPiece D Sc sy hc (List.replicate ε i) (List.replicate ε i) 0 0)
    (hz0 : z ∈ homPiece D Sc sy hc s s 0 0) :
    TwoSupercategory.hcomp (B := MonoidalTwo (HGr D Sc sy hc)) (a := MonoidalTwo.star _)
      (b := MonoidalTwo.star _) (c := MonoidalTwo.star _) z b = tailT s b z := by
  change z ▷ hObj D Sc sy hc (List.replicate ε i) ≫ hObj D Sc sy hc s ◁ b = _
  rw [MonoidalSupercategory.interchange_of_even_left (R := k) hz0.2 hb0.2]
  rfl

end TailT

/-- `(t, e)` is a product `(i₁^{a₁} ⋯ i_r^{a_r}, 1_{i₁^{(a₁)}} ⊗ ⋯ ⊗ 1_{i_r^{(a_r)}})` of
divided-power idempotents. -/
inductive IsDPProduct : (t : List I) → HEnd D Sc sy hc t → Prop
  | nil : IsDPProduct [] (𝟙 _)
  | snoc {t : List I} {e : HEnd D Sc sy hc t} (i : I) (r : ℕ) :
      IsDPProduct t e → IsDPProduct (t ++ List.replicate r i) (tailT t (dpIdem D Sc sy hc i r) e)

theorem IsDPProduct.mem_idem {t : List I} {e : HEnd D Sc sy hc t} (h : IsDPProduct t e) :
    e ∈ homPiece D Sc sy hc t t 0 0 ∧ e ≫ e = e := by
  induction h with
  | nil => exact ⟨⟨GradedSupercategory.id_mem_degree _, Supercategory.id_mem _⟩, Category.id_comp _⟩
  | snoc i r _ ih =>
    exact ⟨tailT_mem_homPiece (dpIdem_mem D Sc sy hc i r) ih.1,
      tailT_idem (dpIdem_idem D Sc sy hc i r) (dpIdem_mem D Sc sy hc i r) ih.2 ih.1⟩

variable (D Sc sy hc) in
/-- The classes `[Q^n Π^p P(i₁^{(a₁)}) ⋯ P(i_r^{(a_r)})]`. -/
def dpSet : Set (K₀ (HKar D Sc sy hc)) :=
  {x | ∃ (t : List I) (e : HEnd D Sc sy hc t) (h : IsDPProduct t e) (n : ℤ) (p : ZMod 2),
    x = K₀.mk (raw h.mem_idem.2 h.mem_idem.1.1 h.mem_idem.1.2 n p)}

variable (D Sc sy hc) in
/-- The subgroup of `K₀(Ḣ_{q,π})` generated by the shifted products of divided powers. -/
abbrev dpSpan : AddSubgroup (K₀ (HKar D Sc sy hc)) := AddSubgroup.closure (dpSet D Sc sy hc)

variable (D Sc sy hc) in
/-- The identity functor from `HCat` to `HKar`. -/
def hCatToHKar : HCat D Sc sy hc ⥤ HKar (k := k) D Sc sy hc where
  obj P := P
  map f := f

instance : (hCatToHKar D Sc sy hc).Additive := ⟨rfl⟩

theorem hKarToKH_mk (P : HKar D Sc sy hc) :
    hKarToKH D Sc sy hc (K₀.mk P) =
      K₀Ring.mk (B := HDot D Sc sy hc) (a := HDot.star D Sc sy hc) (b := HDot.star D Sc sy hc) P := by
  rw [hKarToKH, AddMonoidHom.comp_apply, K₀.map_mk]
  rfl

theorem hKarToKH_injective : Function.Injective (hKarToKH (k := k) D Sc sy hc) := by
  have hl : Function.LeftInverse (K₀.map (hCatToHKar D Sc sy hc))
      (K₀.map (hKarToHCat D Sc sy hc)) := by
    intro x
    change ((K₀.map (hCatToHKar D Sc sy hc)).comp (K₀.map (hKarToHCat D Sc sy hc))) x = AddMonoidHom.id _ x
    congr 1
    refine K₀.hom_ext fun X => ?_
    rw [AddMonoidHom.comp_apply, K₀.map_mk, K₀.map_mk]
    rfl
  classical
  exact (DirectSum.of_injective _).comp hl.injective

theorem raw_congr {t : List I} {e₁ e₂ : HEnd D Sc sy hc t} (h : e₁ = e₂) (he₁ he₂ hd₁ hd₂ hp₁ hp₂)
    {n₁ n₂ : ℤ} (hn : n₁ = n₂) {p₁ p₂ : ZMod 2} (hp : p₁ = p₂) :
    raw (k := k) (A := HGr D Sc sy hc) (f := hObj D Sc sy hc t) (e := e₁) he₁ hd₁ hp₁ n₁ p₁ =
      raw (e := e₂) he₂ hd₂ hp₂ n₂ p₂ := by
  subst h hn hp; rfl

section TailT

variable {s : List I} {i : I} {ε : ℕ} {b : HEnd D Sc sy hc (List.replicate ε i)}
  {z : HEnd D Sc sy hc s}

/-- `[Q^n Π^p (s i^ε, z ⊗ b)] = [(i^ε, b)] [Q^n Π^p (s, z)]` in `K₀Ring` order. -/
theorem hKarToKH_raw_tailT (hb : b ≫ b = b)
    (hb0 : b ∈ homPiece D Sc sy hc (List.replicate ε i) (List.replicate ε i) 0 0)
    (hz : z ≫ z = z) (hz0 : z ∈ homPiece D Sc sy hc s s 0 0) (n : ℤ) (p : ZMod 2) :
    hKarToKH D Sc sy hc (K₀.mk (raw (tailT_idem hb hb0 hz hz0) (tailT_mem_homPiece hb0 hz0).1
      (tailT_mem_homPiece hb0 hz0).2 n p)) =
      hKarToKH D Sc sy hc (K₀.mk (raw hb hb0.1 hb0.2 0 0)) *
        hKarToKH D Sc sy hc (K₀.mk (raw hz hz0.1 hz0.2 n p)) := by
  have h := mk_raw_mul_mk_raw (k := k) (B := MonoidalTwo (HGr D Sc sy hc))
    (a := MonoidalTwo.star _) (b := MonoidalTwo.star _) (c := MonoidalTwo.star _)
    (f := hObj D Sc sy hc s) (g := hObj D Sc sy hc (List.replicate ε i)) hz hz0.1 hz0.2 hb hb0.1
    hb0.2 n 0 p 0
  rw [hKarToKH_mk, hKarToKH_mk, hKarToKH_mk, h]
  exact congrArg _ (raw_congr (hcomp_eq_tailT hb0 hz0).symm _ _ _ _ _ _ (add_zero n).symm
    (add_zero p).symm)

/-- **`dpSpan` is closed under `− ⊗ P(i^{(ε)})`.** -/
theorem mk_raw_tailT_mem_dpSpan (hz : z ≫ z = z) (hz0 : z ∈ homPiece D Sc sy hc s s 0 0)
    {n : ℤ} {p : ZMod 2} (h : K₀.mk (raw hz hz0.1 hz0.2 n p) ∈ dpSpan D Sc sy hc) :
    K₀.mk (raw (tailT_idem (dpIdem_idem D Sc sy hc i ε) (dpIdem_mem D Sc sy hc i ε) hz hz0)
      (tailT_mem_homPiece (dpIdem_mem D Sc sy hc i ε) hz0).1
      (tailT_mem_homPiece (dpIdem_mem D Sc sy hc i ε) hz0).2 n p) ∈ dpSpan D Sc sy hc := by
  let φ := hKarToKH (k := k) D Sc sy hc
  let P := φ (K₀.mk (raw (dpIdem_idem D Sc sy hc i ε) (dpIdem_mem D Sc sy hc i ε).1
    (dpIdem_mem D Sc sy hc i ε).2 0 0))
  have key : dpSpan D Sc sy hc ≤ ((dpSpan D Sc sy hc).map φ).comap
      ((AddMonoidHom.mulLeft P).comp φ) := by
    refine (AddSubgroup.closure_le _).2 ?_
    rintro _ ⟨t, e, he, n, p, rfl⟩
    exact ⟨_, AddSubgroup.subset_closure ⟨_, _, he.snoc i ε, n, p, rfl⟩,
      hKarToKH_raw_tailT (dpIdem_idem D Sc sy hc i ε) (dpIdem_mem D Sc sy hc i ε)
        he.mem_idem.2 he.mem_idem.1 n p⟩
  obtain ⟨y, hy, ey⟩ := key h
  have e2 := hKarToKH_raw_tailT (dpIdem_idem D Sc sy hc i ε) (dpIdem_mem D Sc sy hc i ε) hz hz0 n p
  rw [hKarToKH_injective (ey.trans e2.symm)] at hy
  exact hy

end TailT

end Products

/-! ## Summands of words -/

section Summands

/-- The shifted word `Q^n Π^p t`. -/
abbrev Wd (t : List I) (n : ℤ) (p : ZMod 2) : HKar D Sc sy hc :=
  unitRaw (k := k) (hObj D Sc sy hc t) n p

variable {D Sc sy hc}

/-- The corner of an idempotent cutting out an indecomposable summand is local. -/
theorem hloc_of_isIndec {s : List I} {z : HEnd D Sc sy hc s} (hz : z ≫ z = z)
    (hz0 : z ∈ homPiece D Sc sy hc s s 0 0) (hind : IsIndec (raw (k := k) hz hz0.1 hz0.2 0 0)) :
    ∀ a : HEnd D Sc sy hc s, a ∈ homPiece D Sc sy hc s s 0 0 → z ≫ a ≫ z = a →
      IsNilpotent (id a : End (hObj D Sc sy hc s)) ∨ ∃ a' : HEnd D Sc sy hc s,
        a' ∈ homPiece D Sc sy hc s s 0 0 ∧ a ≫ a' = z ∧ a' ≫ a = z := by
  intro a ha hza
  let α : End (raw (k := k) hz hz0.1 hz0.2 0 0) :=
    homR a (by simpa using ha.1) (by simpa using ha.2) hza
  have hpow : ∀ N : ℕ, evR (α ^ (N + 1)) = (id a : End (hObj D Sc sy hc s)) ^ (N + 1) := by
    intro N
    induction N with
    | zero => rw [zero_add, pow_one, pow_one]; rfl
    | succ N ih =>
      rw [pow_succ α, End.mul_def, evR_comp, ih, pow_succ (id a : End (hObj D Sc sy hc s)) (N + 1),
        End.mul_def]
      rfl
  rcases hind.isNilpotent_or_isUnit k α with ⟨N, hN⟩ | ⟨u, hu⟩
  · left
    refine ⟨N + 1, ?_⟩
    rw [← hpow, pow_succ, hN, zero_mul]
    rfl
  · right
    refine ⟨evR u.inv, ⟨by simpa using evR_mem_degree u.inv, by simpa using evR_mem_parity u.inv⟩,
      ?_, ?_⟩
    · have h1 : α ≫ u.inv = 𝟙 _ := by rw [← hu]; exact u.inv_val
      exact (evR_comp α u.inv).symm.trans ((congrArg evR h1).trans evR_id)
    · have h1 : u.inv ≫ α = 𝟙 _ := by rw [← hu]; exact u.val_inv
      exact (evR_comp u.inv α).symm.trans ((congrArg evR h1).trans evR_id)

/-- **Summands through longer tails.** If an even degree-zero idempotent `f` of `t = s i^ε` lies
in `J`, and every indecomposable summand of a shifted word of the same length ending in
`i^{ε+1}` has class in `dpSpan`, then so does `Q^n Π^p (t, f)`. -/
theorem mk_raw_mem_dpSpan_of_mem_tailJ {s : List I} {i : I} {ε : ℕ}
    {f : HEnd D Sc sy hc (s ++ List.replicate ε i)} (hf : f ≫ f = f)
    (hf0 : f ∈ homPiece D Sc sy hc _ _ 0 0) (hJ : f ∈ tailJ D Sc sy hc s i ε)
    (IH : ∀ w : List I, List.replicate (ε + 1) i <:+ w →
      w.length = (s ++ List.replicate ε i).length → ∀ (n : ℤ) (p : ZMod 2) (Y : HKar D Sc sy hc),
      IsIndec Y → ∀ (u : Y ⟶ Wd D Sc sy hc w n p) (v : Wd D Sc sy hc w n p ⟶ Y), u ≫ v = 𝟙 Y →
      K₀.mk Y ∈ dpSpan D Sc sy hc)
    (n : ℤ) (p : ZMod 2) : K₀.mk (raw (k := k) hf hf0.1 hf0.2 n p) ∈ dpSpan D Sc sy hc := by
  obtain ⟨N, c, g, hg⟩ := Submodule.mem_span_set'.1 hJ
  have hg' := fun j => (g j).2
  choose w hw n₁ n₂ p₁ p₂ g₁ g₂ hg₁ hg₂ hn hp heq using hg'
  have hsum : ∑ j, c j • (g₁ j ≫ g₂ j) = f := by
    rw [← hg]
    exact Finset.sum_congr rfl fun j _ => by rw [heq j]
  have hd₁ : ∀ j, f ≫ (c j • g₁ j) ∈ degree (R := k) (C := HGr D Sc sy hc) _ _ (n - (n - n₁ j)) :=
    fun j => by
      have := GradedSupercategory.comp_mem_degree hf0.1 (Submodule.smul_mem _ (c j) (hg₁ j).1)
      rwa [show (0 : ℤ) + n₁ j = n - (n - n₁ j) by ring] at this
  have hp₁ : ∀ j, f ≫ (c j • g₁ j) ∈ Supercategory.parity (R := k) (C := HGr D Sc sy hc) _ _
      (p + (p + p₁ j)) := fun j => by
    have := Supercategory.comp_mem hf0.2 (Submodule.smul_mem _ (c j) (hg₁ j).2)
    rwa [← add_assoc, Supercategory.zmod2_add_self]
  have hd₂ : ∀ j, g₂ j ≫ f ∈ degree (R := k) (C := HGr D Sc sy hc) _ _ (n - n₁ j - n) :=
    fun j => by
      have := GradedSupercategory.comp_mem_degree (hg₂ j).1 hf0.1
      rwa [show n₂ j + 0 = n - n₁ j - n by have := hn j; omega] at this
  have hp₂ : ∀ j, g₂ j ≫ f ∈ Supercategory.parity (R := k) (C := HGr D Sc sy hc) _ _
      (p + p₁ j + p) := fun j => by
    have := Supercategory.comp_mem (hg₂ j).2 hf0.2
    have e : p₂ j = p₁ j := by
      have := hp j
      rw [← ZMod.neg_eq_self_mod_two (p₁ j)]
      exact eq_neg_of_add_eq_zero_right this
    rw [add_zero, e] at this
    rwa [add_comm p, add_assoc, Supercategory.zmod2_add_self, add_zero]
  let U : ∀ j, raw (k := k) hf hf0.1 hf0.2 n p ⟶ Wd D Sc sy hc (w j) (n - n₁ j) (p + p₁ j) :=
    fun j => homR (f ≫ (c j • g₁ j)) (hd₁ j) (hp₁ j) (by rw [Category.comp_id, reassoc_of% hf])
  let V : ∀ j, Wd D Sc sy hc (w j) (n - n₁ j) (p + p₁ j) ⟶ raw (k := k) hf hf0.1 hf0.2 n p :=
    fun j => homR (g₂ j ≫ f) (hd₂ j) (hp₂ j) (by rw [Category.id_comp, Category.assoc, hf])
  have htot : ∑ j, U j ≫ V j = 𝟙 _ := by
    apply evR_injective
    rw [evR_sum, evR_id]
    simp only [evR_comp]
    change ∑ j, (f ≫ (c j • g₁ j)) ≫ g₂ j ≫ f = f
    calc ∑ j, (f ≫ (c j • g₁ j)) ≫ g₂ j ≫ f = f ≫ (∑ j, c j • (g₁ j ≫ g₂ j)) ≫ f := by
          rw [Preadditive.sum_comp, Preadditive.comp_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          simp only [Linear.comp_smul, Linear.smul_comp, Category.assoc]
      _ = f := by rw [hsum, hf, hf]
  refine mk_mem_of_indec_retracts k _ _ fun Y hY u v huv => ?_
  have h1 : ∑ j, (u ≫ U j) ≫ (V j ≫ v) = 𝟙 Y := by
    simp only [Category.assoc]
    rw [← Preadditive.comp_sum]
    simp only [← Category.assoc]
    rw [← Preadditive.sum_comp, htot, Category.id_comp, huv]
  obtain ⟨j, -, v', hv'⟩ := exists_retract_of_sum k hY Finset.univ _ _ h1
  by_cases hl : (w j).length = (s ++ List.replicate ε i).length
  · exact IH (w j) (hw j) hl _ _ Y hY _ v' hv'
  · exfalso
    have hU : U j = 0 := evR_injective (by
      change f ≫ (c j • g₁ j) = 0
      rw [eq_zero_of_length_ne (hg₁ j) hl, smul_zero, Limits.comp_zero])
    rw [hU, Limits.comp_zero, Limits.zero_comp] at hv'
    exact hY.1 ((Limits.IsZero.iff_id_eq_zero _).2 hv'.symm)

section Whisker

variable {s s' r r' : List I}

theorem sum_whiskerRight_hObj {J : Type*} (S : Finset J)
    (x : J → (hObj D Sc sy hc s ⟶ hObj D Sc sy hc s')) (r : List I) :
    (∑ j ∈ S, x j) ▷ hObj D Sc sy hc r = ∑ j ∈ S, x j ▷ hObj D Sc sy hc r := by
  classical
  induction S using Finset.induction_on with
  | empty => simp only [Finset.sum_empty]; exact MonoidalSupercategory.zero_whiskerRight k _
  | insert a S ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, MonoidalSupercategory.add_whiskerRight (R := k),
      ih]

theorem whiskerLeft_sum_hObj {J : Type*} (S : Finset J) (s : List I)
    (x : J → (hObj D Sc sy hc r ⟶ hObj D Sc sy hc r')) :
    hObj D Sc sy hc s ◁ (∑ j ∈ S, x j) = ∑ j ∈ S, hObj D Sc sy hc s ◁ x j := by
  classical
  induction S using Finset.induction_on with
  | empty => simp only [Finset.sum_empty]; exact MonoidalSupercategory.whiskerLeft_zero k _
  | insert a S ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, MonoidalSupercategory.whiskerLeft_add (R := k),
      ih]

variable {z : HEnd D Sc sy hc s} {b σ' lam' : HEnd D Sc sy hc r}

/-- `(1 ⊗ λ)(z ⊗ 1) (z ⊗ b) = (1 ⊗ λ)(z ⊗ 1)` when `λ b = λ`. -/
theorem corner_U (hz : z ≫ z = z) (hz0 : z ∈ Supercategory.parity (R := k) _ _ 0)
    (hb0 : b ∈ Supercategory.parity (R := k) _ _ 0) (hl : lam' ≫ b = lam') :
    (hObj D Sc sy hc s ◁ lam') ≫ (z ▷ hObj D Sc sy hc r) ≫ (hObj D Sc sy hc s ◁ b) ≫
      (z ▷ hObj D Sc sy hc r) = (hObj D Sc sy hc s ◁ lam') ≫ (z ▷ hObj D Sc sy hc r) := by
  rw [← Category.assoc (z ▷ _), MonoidalSupercategory.interchange_of_even_left (R := k) hz0 hb0,
    Category.assoc, ← Category.assoc (hObj D Sc sy hc s ◁ lam'),
    ← MonoidalSupercategory.whiskerLeft_comp (R := k), hl,
    ← MonoidalSupercategory.comp_whiskerRight (R := k), hz]

/-- `(z ⊗ b)(z ⊗ 1)(1 ⊗ σ) = (z ⊗ 1)(1 ⊗ σ)` when `b σ = σ`. -/
theorem corner_V (hz : z ≫ z = z) (hz0 : z ∈ Supercategory.parity (R := k) _ _ 0)
    (hb0 : b ∈ Supercategory.parity (R := k) _ _ 0) (hs : b ≫ σ' = σ') :
    ((hObj D Sc sy hc s ◁ b) ≫ (z ▷ hObj D Sc sy hc r)) ≫ (z ▷ hObj D Sc sy hc r) ≫
      (hObj D Sc sy hc s ◁ σ') = (z ▷ hObj D Sc sy hc r) ≫ (hObj D Sc sy hc s ◁ σ') := by
  rw [Category.assoc, ← Category.assoc (z ▷ _) (z ▷ _),
    ← MonoidalSupercategory.comp_whiskerRight (R := k), hz, ← Category.assoc,
    ← MonoidalSupercategory.interchange_of_even_left (R := k) hz0 hb0, Category.assoc,
    ← MonoidalSupercategory.whiskerLeft_comp (R := k), hs]

/-- `(1 ⊗ λ)(z ⊗ 1)(z ⊗ 1)(1 ⊗ σ) = (1 ⊗ λσ)(z ⊗ 1)`. -/
theorem U_comp_V {q : ZMod 2} (hz : z ≫ z = z) (hz0 : z ∈ Supercategory.parity (R := k) _ _ 0)
    (hσ : σ' ∈ Supercategory.parity (R := k) _ _ q) :
    ((hObj D Sc sy hc s ◁ lam') ≫ (z ▷ hObj D Sc sy hc r)) ≫ (z ▷ hObj D Sc sy hc r) ≫
      (hObj D Sc sy hc s ◁ σ') = (hObj D Sc sy hc s ◁ (lam' ≫ σ')) ≫ (z ▷ hObj D Sc sy hc r) := by
  rw [Category.assoc, ← Category.assoc (z ▷ _) (z ▷ _),
    ← MonoidalSupercategory.comp_whiskerRight (R := k), hz,
    MonoidalSupercategory.interchange_of_even_left (R := k) hz0 hσ,
    MonoidalSupercategory.whiskerLeft_comp (R := k), Category.assoc]

end Whisker

/-- **The inductive step** (Khovanov–Lauda, §3.2). Let `Y` be an indecomposable summand of a
shifted word `s i^ε`. If the indecomposable summands of shifts of `s`, and of shifted words of the
same length ending in `i^{ε+1}`, have classes in `dpSpan`, so does `Y`. -/
theorem mk_mem_dpSpan_step {s : List I} {i : I} {ε : ℕ}
    (IHs : ∀ (n : ℤ) (p : ZMod 2) (Y : HKar D Sc sy hc), IsIndec Y →
      ∀ (u : Y ⟶ Wd D Sc sy hc s n p) (v : Wd D Sc sy hc s n p ⟶ Y), u ≫ v = 𝟙 Y →
      K₀.mk Y ∈ dpSpan D Sc sy hc)
    (IHt : ∀ w : List I, List.replicate (ε + 1) i <:+ w →
      w.length = (s ++ List.replicate ε i).length → ∀ (n : ℤ) (p : ZMod 2) (Y : HKar D Sc sy hc),
      IsIndec Y → ∀ (u : Y ⟶ Wd D Sc sy hc w n p) (v : Wd D Sc sy hc w n p ⟶ Y), u ≫ v = 𝟙 Y →
      K₀.mk Y ∈ dpSpan D Sc sy hc)
    {n : ℤ} {p : ZMod 2} {Y : HKar D Sc sy hc} (hY : IsIndec Y)
    (u : Y ⟶ Wd D Sc sy hc (s ++ List.replicate ε i) n p)
    (v : Wd D Sc sy hc (s ++ List.replicate ε i) n p ⟶ Y) (huv : u ≫ v = 𝟙 Y) :
    K₀.mk Y ∈ dpSpan D Sc sy hc := by
  classical
  have hb := dpIdem_idem D Sc sy hc i ε
  have hb0 := dpIdem_mem D Sc sy hc i ε
  -- the decomposition of `s` into indecomposables `Z_a`, with idempotents `z_a`
  obtain ⟨J, _, Z, ι, π, hZi, hιπ, -, hsumZ⟩ := exists_decomposition k (Wd D Sc sy hc s 0 0)
  let z : J → HEnd D Sc sy hc s := fun a => evR (π a ≫ ι a)
  have hz : ∀ a, z a ≫ z a = z a := fun a => retract_idem (ι a) (π a) (hιπ a)
  have hz0 : ∀ a, z a ∈ homPiece D Sc sy hc s s 0 0 :=
    fun a => ⟨retract_degree (ι a) (π a), retract_parity (ι a) (π a)⟩
  have hzsum : ∑ a, z a = 𝟙 _ := by
    change ∑ a, evR (π a ≫ ι a) = _
    rw [← evR_sum, hsumZ]
    rfl
  -- Lemma 11.1 for `i^ε`
  obtain ⟨C, _, mC, qC, σ, lam, hσ, hlam, hsl, hbσ, hlb⟩ := exists_dpSplitting D Sc sy hc i ε
  -- `1_{s i^ε} = ∑_{a,c} U_{ac} V_{ac}` through `Q^{m_c} Π^{q_c} (s i^ε, z_a ⊗ b)`
  let e : J → HEnd D Sc sy hc (s ++ List.replicate ε i) :=
    fun a => tailT s (dpIdem D Sc sy hc i ε) (z a)
  have he : ∀ a, e a ≫ e a = e a := fun a => tailT_idem hb hb0 (hz a) (hz0 a)
  have he0 : ∀ a, e a ∈ homPiece D Sc sy hc _ _ 0 0 := fun a => tailT_mem_homPiece hb0 (hz0 a)
  let R : J × C → HKar D Sc sy hc := fun x =>
    raw (k := k) (he x.1) (he0 x.1).1 (he0 x.1).2 (n + mC x.2) (p + qC x.2)
  let xU : J × C → HEnd D Sc sy hc (s ++ List.replicate ε i) := fun x =>
    (hObj D Sc sy hc s ◁ lam x.2) ≫ (z x.1 ▷ hObj D Sc sy hc (List.replicate ε i))
  let xV : J × C → HEnd D Sc sy hc (s ++ List.replicate ε i) := fun x =>
    (z x.1 ▷ hObj D Sc sy hc (List.replicate ε i)) ≫ (hObj D Sc sy hc s ◁ σ x.2)
  have hxU : ∀ x, xU x ∈ homPiece D Sc sy hc _ _ (-mC x.2) (qC x.2) := fun x =>
    mem_homPiece_cast (comp_mem_homPiece (whiskerLeft_mem_homPiece s (hlam x.2))
      (whiskerRight_mem_homPiece _ (hz0 x.1))) (add_zero _) (add_zero _)
  have hxV : ∀ x, xV x ∈ homPiece D Sc sy hc _ _ (mC x.2) (qC x.2) := fun x =>
    mem_homPiece_cast (comp_mem_homPiece (whiskerRight_mem_homPiece _ (hz0 x.1))
      (whiskerLeft_mem_homPiece s (hσ x.2))) (zero_add _) (zero_add _)
  let U : ∀ x, Wd D Sc sy hc (s ++ List.replicate ε i) n p ⟶ R x := fun x =>
    homR (xU x) (by rw [show n - (n + mC x.2) = -mC x.2 by ring]; exact (hxU x).1)
      (by rw [← add_assoc, Supercategory.zmod2_add_self, zero_add]; exact (hxU x).2)
      (by
        rw [Category.id_comp]
        simpa only [xU, e, tailT, Category.assoc] using
          corner_U (hz x.1) (hz0 x.1).2 hb0.2 (hlb x.2))
  let V : ∀ x, R x ⟶ Wd D Sc sy hc (s ++ List.replicate ε i) n p := fun x =>
    homR (xV x) (by rw [show n + mC x.2 - n = mC x.2 by ring]; exact (hxV x).1)
      (by rw [add_comm p, add_assoc, Supercategory.zmod2_add_self, add_zero]; exact (hxV x).2)
      (by
        rw [Category.comp_id]
        simpa only [xV, e, tailT, Category.assoc] using
          corner_V (hz x.1) (hz0 x.1).2 hb0.2 (hbσ x.2))
  have htot : ∑ x, U x ≫ V x = 𝟙 _ := by
    apply evR_injective
    rw [evR_sum, evR_id]
    simp only [evR_comp]
    change ∑ x, xU x ≫ xV x = 𝟙 _
    have h1 : ∀ x, xU x ≫ xV x = (hObj D Sc sy hc s ◁ (lam x.2 ≫ σ x.2)) ≫
        (z x.1 ▷ hObj D Sc sy hc (List.replicate ε i)) :=
      fun x => U_comp_V (hz x.1) (hz0 x.1).2 (hσ x.2).2
    simp only [h1]
    rw [Fintype.sum_prod_type_right]
    simp_rw [← Preadditive.comp_sum]
    rw [← sum_whiskerRight_hObj, hzsum, MonoidalSupercategory.id_whiskerRight (R := k)]
    simp_rw [Category.comp_id]
    rw [← whiskerLeft_sum_hObj, hsl, MonoidalSupercategory.whiskerLeft_id (R := k)]
    rfl
  -- `Y` is a summand of one of the `R x`
  have h1 : ∑ x, (u ≫ U x) ≫ (V x ≫ v) = 𝟙 Y := by
    simp only [Category.assoc]
    rw [← Preadditive.comp_sum]
    simp only [← Category.assoc]
    rw [← Preadditive.sum_comp, htot, Category.id_comp, huv]
  obtain ⟨x, -, v', hv'⟩ := exists_retract_of_sum k hY Finset.univ _ _ h1
  -- the idempotents `f₁ = v' u'` and `f₂ = e - f₁` in the corner of `e = z_a ⊗ b`
  have hi₁ := retract_idem (u ≫ U x) v' hv'
  have hf₁0 : evR (v' ≫ u ≫ U x) ∈ homPiece D Sc sy hc _ _ 0 0 :=
    ⟨retract_degree (u ≫ U x) v', retract_parity (u ≫ U x) v'⟩
  have hl₁ := retract_left (u ≫ U x) v'
  have hr₁ := retract_right (u ≫ U x) v'
  set f₁ := evR (v' ≫ u ≫ U x) with hf₁
  set f₂ := e x.1 - f₁ with hf₂
  have hi₂ : f₂ ≫ f₂ = f₂ := by
    simp only [f₂, Preadditive.sub_comp, Preadditive.comp_sub, he, hl₁, hr₁, hi₁, sub_self,
      sub_zero]
  have h₁₂ : f₁ ≫ f₂ = 0 := by simp only [f₂, Preadditive.comp_sub, hr₁, hi₁, sub_self]
  have h₂₁ : f₂ ≫ f₁ = 0 := by simp only [f₂, Preadditive.sub_comp, hl₁, hi₁, sub_self]
  have hf₂0 : f₂ ∈ homPiece D Sc sy hc _ _ 0 0 := sub_mem (he0 x.1) hf₁0
  have he₁ : e x.1 ≫ f₁ ≫ e x.1 = f₁ := by rw [hr₁, hl₁]
  have he₂ : e x.1 ≫ f₂ ≫ e x.1 = f₂ := by
    simp only [f₂, Preadditive.sub_comp, Preadditive.comp_sub, he, hl₁, hr₁]
  have hloc := hloc_of_isIndec (hz x.1) (hz0 x.1)
    (IsIndec.of_iso (retractIso (ι x.1) (π x.1) (hιπ x.1)) (hZi x.1))
  have hYf : K₀.mk Y = K₀.mk (raw (k := k) hi₁ hf₁0.1 hf₁0.2 (n + mC x.2) (p + qC x.2)) :=
    K₀.mk_eq_mk_of_iso (retractIso (u ≫ U x) v' hv')
  rcases tail_idempotent_mem_tailJ hb hb0 (dpIdem_corner D Sc sy hc i ε) (hz0 x.1) (hz x.1) hloc
      hf₁0 hf₂0 he₁ he₂ hi₁ hi₂ h₁₂ with hJ | hJ
  · rw [hYf]
    exact mk_raw_mem_dpSpan_of_mem_tailJ hi₁ hf₁0 hJ IHt _ _
  · have hsplit := mk_raw_eq_add (he := he x.1) (hd0 := (he0 x.1).1) (hp0 := (he0 x.1).2)
      (m := n + mC x.2) (p := p + qC x.2) hi₁ hi₂ h₁₂ h₂₁ (add_sub_cancel f₁ (e x.1)) hf₁0.1
      hf₁0.2 hf₂0.1 hf₂0.2
    have hzx : K₀.mk (raw (k := k) (hz x.1) (hz0 x.1).1 (hz0 x.1).2 (n + mC x.2) (p + qC x.2)) ∈
        dpSpan D Sc sy hc := by
      refine mk_mem_of_indec_retracts k _ _ fun Y'' hY'' u'' v'' huv'' => ?_
      let hU : raw (k := k) (hz x.1) (hz0 x.1).1 (hz0 x.1).2 (n + mC x.2) (p + qC x.2) ⟶
          Wd D Sc sy hc s (n + mC x.2) (p + qC x.2) :=
        homR (z x.1) (by simpa using (hz0 x.1).1)
          (by rw [Supercategory.zmod2_add_self]; exact (hz0 x.1).2)
          (by rw [Category.comp_id, hz x.1])
      let hV : Wd D Sc sy hc s (n + mC x.2) (p + qC x.2) ⟶
          raw (k := k) (hz x.1) (hz0 x.1).1 (hz0 x.1).2 (n + mC x.2) (p + qC x.2) :=
        homR (z x.1) (by simpa using (hz0 x.1).1)
          (by rw [Supercategory.zmod2_add_self]; exact (hz0 x.1).2)
          (by rw [Category.id_comp, hz x.1])
      have hUV : hU ≫ hV = 𝟙 _ := evR_injective (by rw [evR_comp]; exact hz x.1)
      refine IHs _ _ Y'' hY'' (u'' ≫ hU) (hV ≫ v'') ?_
      rw [Category.assoc, ← Category.assoc hU, hUV, Category.id_comp, huv'']
    have hRx : K₀.mk (R x) ∈ dpSpan D Sc sy hc := mk_raw_tailT_mem_dpSpan (hz x.1) (hz0 x.1) hzx
    rw [hYf, eq_sub_of_add_eq hsplit.symm]
    exact sub_mem hRx (mk_raw_mem_dpSpan_of_mem_tailJ hi₂ hf₂0 hJ IHt _ _)

/-- **Summands of words.** Every indecomposable summand of a shifted word has class in
`dpSpan`: by induction on the length `m` of the word, and for fixed `m` by descending induction
on the length of an `i`-tail. -/
theorem mk_mem_dpSpan_of_retract_word (m : ℕ) :
    ∀ t : List I, t.length = m → ∀ (n : ℤ) (p : ZMod 2) (Y : HKar D Sc sy hc), IsIndec Y →
      ∀ (u : Y ⟶ Wd D Sc sy hc t n p) (v : Wd D Sc sy hc t n p ⟶ Y), u ≫ v = 𝟙 Y →
      K₀.mk Y ∈ dpSpan D Sc sy hc := by
  induction m using Nat.strong_induction_on with
  | _ m IHm =>
  have tail : ∀ d ε (s : List I) (i : I), m - ε = d → (s ++ List.replicate ε i).length = m →
      1 ≤ ε → ∀ (n : ℤ) (p : ZMod 2) (Y : HKar D Sc sy hc), IsIndec Y →
      ∀ (u : Y ⟶ Wd D Sc sy hc (s ++ List.replicate ε i) n p)
        (v : Wd D Sc sy hc (s ++ List.replicate ε i) n p ⟶ Y), u ≫ v = 𝟙 Y →
      K₀.mk Y ∈ dpSpan D Sc sy hc := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d IHd =>
    intro ε s i hd hlen hε n p Y hY u v huv
    have hs : s.length < m := by
      rw [List.length_append, List.length_replicate] at hlen
      omega
    refine mk_mem_dpSpan_step (fun n p Y hY u v huv => IHm s.length hs s rfl n p Y hY u v huv)
      (fun w hw hwl n p Y hY u v huv => ?_) hY u v huv
    obtain ⟨s', rfl⟩ := hw
    have hm : ε + 1 ≤ m := by
      rw [hlen, List.length_append, List.length_replicate] at hwl
      omega
    exact IHd (m - (ε + 1)) (by omega) (ε + 1) s' i rfl (hwl.trans hlen) (by omega) n p Y hY u v
      huv
  intro t ht n p Y hY u v huv
  rcases List.eq_nil_or_concat' t with rfl | ⟨s, i, rfl⟩
  · obtain ⟨c, hcu⟩ := Submodule.mem_span_singleton.1 (mem_span_id_nil (evR (v ≫ u)))
    have hidem := retract_idem u v huv
    by_cases h0 : evR (v ≫ u) = 0
    · exfalso
      have hvu : v ≫ u = 0 := evR_injective h0
      have : 𝟙 Y = 0 := by
        rw [← huv, ← Category.comp_id (u ≫ v), ← huv]
        simp only [Category.assoc]
        rw [reassoc_of% hvu, Limits.zero_comp, Limits.comp_zero]
      exact hY.1 ((Limits.IsZero.iff_id_eq_zero _).2 this)
    · have hc1 : c = 1 := by
        rw [← hcu] at hidem h0
        rw [Linear.smul_comp, Linear.comp_smul, Category.comp_id, smul_smul] at hidem
        have hc0 : c ≠ 0 := by rintro rfl; exact h0 (zero_smul _ _)
        have h1 : (c * c - c) • 𝟙 (hObj D Sc sy hc []) = 0 := by rw [sub_smul, hidem, sub_self]
        rcases smul_eq_zero.1 h1 with h | h
        · have : c * (c - 1) = 0 := by rw [mul_sub, mul_one]; exact h
          rcases mul_eq_zero.1 this with h' | h'
          · exact absurd h' hc0
          · exact sub_eq_zero.1 h'
        · exact absurd (by rw [h, smul_zero]) h0
      have hvu : v ≫ u = 𝟙 _ := evR_injective (by rw [← hcu, hc1, one_smul]; rfl)
      rw [K₀.mk_eq_mk_of_iso ⟨u, v, huv, hvu⟩]
      exact AddSubgroup.subset_closure ⟨[], 𝟙 _, .nil, n, p, rfl⟩
  · exact tail _ 1 s i rfl (by simpa using ht) le_rfl n p Y hY u v huv

end Summands

/-! ## The span -/

/-- **Brundan–Ellis, Theorem 11.3, surjectivity.** Over a field, every class in `K₀(Ḣ_{q,π})`
is an integral combination of the classes `[Q^n Π^p P(i₁^{(a₁)}) ⋯ P(i_r^{(a_r)})]` of shifted
products of divided powers. -/
theorem mk_mem_dpSpan (P : HKar D Sc sy hc) : K₀.mk P ∈ dpSpan D Sc sy hc := by
  refine mk_mem_of_indec_retracts k _ _ fun Y hY _ _ _ => ?_
  obtain ⟨J, _, f, n, p, u, v, h⟩ := sum_unitRaw Y
  obtain ⟨j, -, v', hv'⟩ := exists_retract_of_sum k hY Finset.univ u v h
  have key : ∀ (F : HGr D Sc sy hc) (N : ℤ) (Q : ZMod 2) (u : Y ⟶ unitRaw (k := k) F N Q)
      (v : unitRaw (k := k) F N Q ⟶ Y), u ≫ v = 𝟙 Y → K₀.mk Y ∈ dpSpan D Sc sy hc := by
    intro F N Q u v huv
    obtain ⟨t, rfl⟩ := exists_hObj D Sc sy hc F
    exact mk_mem_dpSpan_of_retract_word _ t rfl N Q Y hY u v huv
  exact key _ _ _ (u j) v' hv'

/-- `K₀(Ḣ_{q,π})` is generated by the shifted products of divided powers. -/
theorem dpSpan_eq_top : dpSpan D Sc sy hc = ⊤ :=
  eq_top_iff.2 fun x _ => K₀.induction_on x (mk_mem_dpSpan D Sc sy hc) (zero_mem _)
    (fun _ _ => add_mem) (fun _ => neg_mem)

end OddMath.QuiverHecke
