import OddMath.QuiverHecke.ELVCyclotomicSeparation
import OddMath.QuiverHecke.SwappedVacuumBlock

/-! # The transformed last-boundary ideal and its weight bound

`docs/Nondegeneracy/SwappedVacuumCoordinates.md` §§5–6. The inverse image under the
word-reversing presentation map `U` of the first-boundary factor ideal is the two-sided ideal
`K_N` generated by

1. the exact coefficient ideal `J_N` (`SKM.SYM.elvCoefficientIdeal`) in every word corner;
2. the last-position polynomials (4)
   `g_i(y) = Σ_j (-1)^(p(i) binom(j,2)) c_(i,j) ⊗ y_last^j` in the words `v ++ [i]`, where
   `c_(i,j)` are the literal monic factor coefficients (`SKM.SYM.elvMonicCoefficient` for an
   odd colour, `SKM.SYM.evenMonicCoefficient` for an even one);
3. optionally the coefficient-power ideal `T` of a nilpotent reservoir, given by a set of
   coefficients of weight at least `N₀`.

This file defines these generators (`TransformedGenerator`) and their two-sided span
(`TransformedIdeal`), and proves the bound (5) of §6:
`K_N(s,t) ⊆ WeightedRelationSpan N₀ ⊆ ExtendedAtLeast (N₀ - 2·C(|s|,2))`
whenever `N₀ ≤ N_i` for every colour (`transformedIdeal_le_extendedAtLeast`), hence
injectivity of the quotient map on `ExtendedAtMost d` for `d + 2·C(|s|,2) < N₀`
(`transformedIdeal_quotient_injective_on_extendedAtMost`). The identification of `K_N` with
the kernel of the corner evaluation (via `U`) is not part of this file.

At the reservoir levels `N_i = 2N₀ + |h_i(μ)|` of the vacuum schedule the bound is the
`ideal_le` field of `SwappedVacuumObservation` (`transformedIdeal_le_vacuumWindow`).

Main declarations: `lastDotPower`, `lastBoundaryPolynomial`, `transformedCoefficient`,
`TransformedGenerator`, `TransformedIdeal`, `transformedIdeal_le_extendedAtLeast`,
`transformedIdeal_le_vacuumWindow`.
-/

noncomputable section
namespace OddMath.QuiverHecke
open CategoryTheory StringDiagrams
open scoped Classical TensorProduct
universe u
variable {I X k : Type u} [AddCommGroup X] [CommRing k]
  (D : SKM.Datum I X) (Sc : SKM.Scalars D k)

/-- `N` dots on the last strand of the word `t`. -/
def lastDotPower (t : List I) (N : ℕ) :
    (pres D Sc).obj (ob D t) ⟶ (pres D Sc).obj (ob D t) :=
  cl D Sc t t ((List.replicate N (t.length - 1)).map PG.dot)
    (by simpa only [tgt_map_dot] using
      sChain_pl t ((List.replicate N (t.length - 1)).map PG.dot))

/-- The coefficient polynomial `Σ_j c_j ⊗ y_last^j` on the last strand, with the coefficients
placed on the left. -/
def lastBoundaryPolynomial (t : List I) (N : ℕ) (c : Fin (N + 1) → SKM.SYM D k) :
    coefficientObj D Sc t ⟶ coefficientObj D Sc t :=
  ∑ j : Fin (N + 1), sourceCoefficientHom D Sc (c j) (lastDotPower D Sc t j.val)

/-- A last-boundary polynomial whose coefficient of `y^j` has weight at least `N - j` lies in
score `N`: every term has `j` dots at the valid last position and no crossing (§6). -/
theorem lastBoundaryPolynomial_mem_score (t : List I) (N : ℕ)
    (c : Fin (N + 1) → SKM.SYM D k) (ht : 0 < t.length)
    (hc : ∀ j, c j ∈ SKM.SYM.CoefficientAtLeast D k (N - j.val)) :
    lastBoundaryPolynomial D Sc t N c ∈ ExtendedScore D Sc t t (N : ℤ) := by
  apply Submodule.sum_mem
  intro j _
  have hm : ∀ p ∈ List.replicate j.val (t.length - 1), p < t.length := by
    intro p hp
    have : p = t.length - 1 := (List.mem_replicate.mp hp).2
    omega
  have he := highCoefficient_word_mem_score D Sc (hc j)
    ((List.replicate j.val (t.length - 1)).map PG.dot)
    (show SChain t (pl t ((List.replicate j.val (t.length - 1)).map PG.dot)) t from
      by simpa only [tgt_map_dot] using
        sChain_pl t ((List.replicate j.val (t.length - 1)).map PG.dot))
  rw [positionedScore_dots hm, List.length_replicate] at he
  have hval : ((N - j.val : ℕ) : ℤ) + j.val = N := by have := j.isLt; omega
  rw [hval] at he
  exact he

/-- The literal monic coefficient `c_(i,j)` of the factor polynomial of colour `i` at
cutoff `N`, coefficients on the left. -/
def factorCoefficient (i : I) (N : ℕ) (j : Fin (N + 1)) : SKM.SYM D k :=
  if h : D.parity i = 1 then SKM.SYM.elvMonicCoefficient D k ⟨i, h⟩ N j
  else SKM.SYM.evenMonicCoefficient D k i N j

theorem factorCoefficient_mem_coefficientAtLeast (i : I) (N : ℕ) (j : Fin (N + 1)) :
    factorCoefficient D i N j ∈ SKM.SYM.CoefficientAtLeast D k (N - j.val) := by
  unfold factorCoefficient
  split_ifs with h
  · exact SKM.SYM.elvMonicCoefficient_mem_coefficientAtLeast D k _ N j
  · have h0 : D.parity i = 0 := by
      have : ∀ x : ZMod 2, x ≠ 1 → x = 0 := by decide
      exact this _ h
    exact SKM.SYM.evenMonicCoefficient_mem_coefficientAtLeast D k i h0 N j

/-- The coefficients of the transformed polynomial (4):
`(-1)^(p(i) binom(j,2)) c_(i,j)`. -/
def transformedCoefficient (i : I) (N : ℕ) (j : Fin (N + 1)) : SKM.SYM D k :=
  (if D.parity i = 1 then (-1 : k) ^ (j.val.choose 2) else 1) • factorCoefficient D i N j

theorem transformedCoefficient_mem_coefficientAtLeast (i : I) (N : ℕ) (j : Fin (N + 1)) :
    transformedCoefficient D i N j ∈ SKM.SYM.CoefficientAtLeast D k (N - j.val) :=
  Submodule.smul_mem _ _ (factorCoefficient_mem_coefficientAtLeast D i N j)

/-- The transformed last-boundary polynomial (4) of colour `i` in the word `v ++ [i]`. -/
def transformedCyclotomic (v : List I) (i : I) (N : ℕ) :
    coefficientObj D Sc (v ++ [i]) ⟶ coefficientObj D Sc (v ++ [i]) :=
  lastBoundaryPolynomial D Sc (v ++ [i]) N (transformedCoefficient D i N)

theorem transformedCyclotomic_mem_score (v : List I) (i : I) (N : ℕ) :
    transformedCyclotomic D Sc v i N ∈ ExtendedScore D Sc (v ++ [i]) (v ++ [i]) (N : ℤ) :=
  lastBoundaryPolynomial_mem_score D Sc _ _ _ (by simp)
    (transformedCoefficient_mem_coefficientAtLeast D i N)

/-- The generators of the transformed ideal `K_(N,T)` of §5: the exact coefficient ideal
`J_N`, the coefficients in `T`, and the transformed last-boundary polynomials (4) at the
cutoff of their own colour. -/
def TransformedGenerator (cutoff : I → ℕ) (T : Set (SKM.SYM D k)) (t : List I)
    (r : coefficientObj D Sc t ⟶ coefficientObj D Sc t) : Prop :=
  (∃ a : SKM.SYM D k, a ∈ SKM.SYM.elvCoefficientIdeal D k cutoff ∧
    r = sourceCoefficientHom D Sc a (𝟙 ((pres D Sc).obj (ob D t)))) ∨
  (∃ a ∈ T, r = sourceCoefficientHom D Sc a (𝟙 ((pres D Sc).obj (ob D t)))) ∨
  (∃ v : List I, ∃ i : I, ∃ h : t = v ++ [i],
    r = eqToHom (congrArg (coefficientObj D Sc) h) ≫
      transformedCyclotomic D Sc v i (cutoff i) ≫
      eqToHom (congrArg (coefficientObj D Sc) h.symm))

theorem transformedGenerator_mem_score {cutoff : I → ℕ} {T : Set (SKM.SYM D k)} {N : ℕ}
    (hN : ∀ i, N ≤ cutoff i) (hT : ∀ a ∈ T, a ∈ SKM.SYM.CoefficientAtLeast D k N)
    {t : List I} {r : coefficientObj D Sc t ⟶ coefficientObj D Sc t}
    (hr : TransformedGenerator D Sc cutoff T t r) : r ∈ ExtendedScore D Sc t t (N : ℤ) := by
  rcases hr with ⟨a, ha, rfl⟩ | ⟨a, ha, rfl⟩ | ⟨v, i, h, rfl⟩
  · have hw := (SKM.SYM.mem_coefficientIdeal_iff D k _ _).mp
      (SKM.SYM.elvCoefficientIdeal_le_weight D k hN ha)
    have hm := highCoefficient_word_mem_score D Sc (t := t) (t' := t)
      (SKM.SYM.coefficientAtLeast_antitone D k (Nat.le_succ N) hw) [] (sChain_pl t [])
    simpa [coefficient_cl_nil, positionedScore, wordScore, crossCount] using hm
  · have hm := highCoefficient_word_mem_score D Sc (t := t) (t' := t) (hT a ha) []
      (sChain_pl t [])
    simpa [coefficient_cl_nil, positionedScore, wordScore, crossCount] using hm
  · subst t
    simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
    exact extendedScore_antitone D Sc (by exact_mod_cast hN i)
      (transformedCyclotomic_mem_score D Sc v i (cutoff i))

/-- **The transformed ideal** `K_(N,T)(s,t)`: the two-sided span of the transformed
generators with arbitrary coefficient-extended affine multipliers, at fixed strand number. -/
def TransformedIdeal (cutoff : I → ℕ) (T : Set (SKM.SYM D k)) (s t : List I) :
    Submodule k (coefficientObj D Sc s ⟶ coefficientObj D Sc t) :=
  Submodule.span k {f | ∃ v : List I, v.length = s.length ∧
    ∃ r : coefficientObj D Sc v ⟶ coefficientObj D Sc v, TransformedGenerator D Sc cutoff T v r ∧
    ∃ a : coefficientObj D Sc s ⟶ coefficientObj D Sc v,
    ∃ b : coefficientObj D Sc v ⟶ coefficientObj D Sc t, a ≫ r ≫ b = f}

theorem transformedIdeal_le_weighted {cutoff : I → ℕ} {T : Set (SKM.SYM D k)} {N : ℕ}
    (hN : ∀ i, N ≤ cutoff i) (hT : ∀ a ∈ T, a ∈ SKM.SYM.CoefficientAtLeast D k N)
    (s t : List I) :
    TransformedIdeal D Sc cutoff T s t ≤ WeightedRelationSpan D Sc s t N := by
  apply Submodule.span_le.mpr
  rintro _ ⟨v, hv, r, hr, a, b, rfl⟩
  exact Submodule.subset_span ⟨v, hv, r, transformedGenerator_mem_score D Sc hN hT hr, a, b, rfl⟩

/-- **The weight bound (5)** of `SwappedVacuumCoordinates.md` §6: if `N₀ ≤ N_i` for every
colour and every coefficient of `T` has weight at least `N₀`, then
`K_(N,T)(s,t) ⊆ ExtendedAtLeast (N₀ - 2·C(|s|,2))`. -/
theorem transformedIdeal_le_extendedAtLeast {cutoff : I → ℕ} {T : Set (SKM.SYM D k)} {N : ℕ}
    (hN : ∀ i, N ≤ cutoff i) (hT : ∀ a ∈ T, a ∈ SKM.SYM.CoefficientAtLeast D k N)
    (s t : List I) :
    TransformedIdeal D Sc cutoff T s t ≤
      ExtendedAtLeast D Sc s t ((N : ℤ) - 2 * (s.length.choose 2 : ℤ)) :=
  (transformedIdeal_le_weighted D Sc hN hT s t).trans
    (weightedRelationSpan_le_extendedAtLeast D Sc s t N)

/-- **Detection (6)**: the quotient by the transformed ideal is injective on
`ExtendedAtMost d` when `d + 2·C(|s|,2) < N₀`. -/
theorem transformedIdeal_quotient_injective_on_extendedAtMost {cutoff : I → ℕ}
    {T : Set (SKM.SYM D k)} {s t : List I} {d N : ℕ} (hN : ∀ i, N ≤ cutoff i)
    (hT : ∀ a ∈ T, a ∈ SKM.SYM.CoefficientAtLeast D k N) (hd : d + 2 * s.length.choose 2 < N) :
    Function.Injective (fun x : ExtendedAtMost D Sc s t d =>
      (TransformedIdeal D Sc cutoff T s t).mkQ
        (x : coefficientObj D Sc s ⟶ coefficientObj D Sc t)) := by
  intro x y hxy
  apply Subtype.ext
  apply sub_eq_zero.mp
  have hm : (x : coefficientObj D Sc s ⟶ coefficientObj D Sc t) - y ∈
      TransformedIdeal D Sc cutoff T s t := (Submodule.Quotient.eq _).mp hxy
  exact Submodule.disjoint_def.mp
    (disjoint_extendedAtMost_extendedAtLeast D Sc (by omega)) _
    (Submodule.sub_mem _ x.property y.property)
    (transformedIdeal_le_extendedAtLeast D Sc hN hT s t hm)

/-- **The vacuum window bound**: at the reservoir levels of the vacuum schedule, the
transformed ideal lies in `ExtendedAtLeast (N₀ - 2·C(|t|,2))`, `N₀ = vacuumCutoff t d`. A
corner evaluation whose kernel is contained in this ideal satisfies `ideal_le`. -/
theorem transformedIdeal_le_vacuumWindow (μ : X) (t t' : List I) (d : ℕ)
    {T : Set (SKM.SYM D k)}
    (hT : ∀ a ∈ T, a ∈ SKM.SYM.CoefficientAtLeast D k (vacuumCutoff t d)) :
    TransformedIdeal D Sc (reservoirLevel D μ t d) T t t' ≤
      ExtendedAtLeast D Sc t t' ((vacuumCutoff t d : ℤ) - 2 * t.length.choose 2) :=
  transformedIdeal_le_extendedAtLeast D Sc
    (fun i => by unfold reservoirLevel; omega) hT t t'

end OddMath.QuiverHecke
