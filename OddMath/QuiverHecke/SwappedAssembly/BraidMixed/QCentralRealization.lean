import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Tactic

/-!
# A commutative realization of four commuting elements

The generated subalgebra contains the two evaluation points, the spectator variable,
and the correction term. Polynomial coefficients are evaluated at the spectator.
All products are ordinary ring products; no regularity or invertibility is required.
-/

namespace QCentralRealization

variable {k R : Type*} [CommRing k] [Ring R] [Algebra k R]

/-- The subalgebra generated by the evaluation points, spectator, and correction. -/
def carrier (a b v d : R) : Subalgebra k R :=
  Algebra.adjoin k {a, b, v, d}

/-- Six commuting pairs suffice, including when generators coincide. -/
theorem generators_pairwise (a b v d : R)
    (hab : Commute a b) (hav : Commute a v) (had : Commute a d)
    (hbv : Commute b v) (hbd : Commute b d) (hvd : Commute v d) :
    ({a, b, v, d} : Set R).Pairwise Commute := by
  intro x hx y hy _
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy
  rcases hx with rfl | rfl | rfl | rfl <;>
    rcases hy with rfl | rfl | rfl | rfl <;>
    first | exact Commute.refl _ | assumption | exact hab.symm | exact hav.symm |
      exact had.symm | exact hbv.symm | exact hbd.symm | exact hvd.symm

open scoped IsMulCommutative in
/-- The canonical ring structure on the generated subalgebra is commutative. -/
abbrev commRing (a b v d : R)
    (hab : Commute a b) (hav : Commute a v) (had : Commute a d)
    (hbv : Commute b v) (hbd : Commute b d) (hvd : Commute v d) :
    CommRing (carrier (k := k) a b v d) := by
  letI : IsMulCommutative (carrier (k := k) a b v d) :=
    Algebra.isMulCommutative_adjoin k
      (generators_pairwise a b v d hab hav had hbv hbd hvd)
  infer_instance

variable (k) (a b v d : R)

/-- The first evaluation point in the generated subalgebra. -/
def pointA : carrier (k := k) a b v d :=
  ⟨a, Algebra.subset_adjoin (by simp)⟩

/-- The second evaluation point in the generated subalgebra. -/
def pointB : carrier (k := k) a b v d :=
  ⟨b, Algebra.subset_adjoin (by simp)⟩

/-- The spectator in the generated subalgebra. -/
def spectator : carrier (k := k) a b v d :=
  ⟨v, Algebra.subset_adjoin (by simp)⟩

/-- The correction in the generated subalgebra. -/
def correction : carrier (k := k) a b v d :=
  ⟨d, Algebra.subset_adjoin (by simp)⟩

/-- The faithful inclusion in the ambient, possibly noncommutative ring. -/
def embedding : carrier (k := k) a b v d →+* R :=
  (carrier (k := k) a b v d).val.toRingHom

/-- Coefficients in `k[V]` are evaluated at the spectator. -/
noncomputable def coefficients : Polynomial k →+* carrier (k := k) a b v d :=
  (Polynomial.aeval (spectator k a b v d)).toRingHom

@[simp] theorem embedding_pointA :
    embedding k a b v d (pointA k a b v d) = a := rfl

@[simp] theorem embedding_pointB :
    embedding k a b v d (pointB k a b v d) = b := rfl

@[simp] theorem embedding_spectator :
    embedding k a b v d (spectator k a b v d) = v := rfl

@[simp] theorem embedding_correction :
    embedding k a b v d (correction k a b v d) = d := rfl

theorem embedding_injective : Function.Injective (embedding k a b v d) :=
  Subtype.val_injective

@[simp] theorem embedding_coefficients (p : Polynomial k) :
    embedding k a b v d (coefficients k a b v d p) = Polynomial.aeval v p := by
  have h : (carrier (k := k) a b v d).val.comp
      (Polynomial.aeval (spectator k a b v d)) = Polynomial.aeval v := by
    ext
    simp [spectator]
  exact DFunLike.congr_fun h p

/-- Commutation with the spectator implies commutation with every coefficient value. -/
theorem commute_coefficients (ψ : R) (hv : Commute ψ v) (p : Polynomial k) :
    Commute ψ (embedding k a b v d (coefficients k a b v d p)) := by
  rw [embedding_coefficients]
  induction p using Polynomial.induction_on with
  | C r => simpa only [Polynomial.aeval_C] using
      (Algebra.commute_algebraMap_left r ψ).symm
  | add p q hp hq => simpa only [map_add] using hp.add_right hq
  | monomial n r ih =>
      simpa only [map_mul, map_pow, Polynomial.aeval_X, pow_succ, mul_assoc] using ih.mul_right hv

end QCentralRealization
