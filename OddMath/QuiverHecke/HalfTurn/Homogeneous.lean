import OddMath.QuiverHecke.HalfTurn.CornerIdeal
import OddMath.SKM.PolynomialExteriorSupercomm

/-! # Homogeneous half-turn identities

The signed reversal formulas hold on homogeneous morphisms, including linear
combinations of diagrams, with the full coefficient algebra retained.
-/
noncomputable section
open scoped Classical TensorProduct
namespace OddMath.QuiverHecke
open CategoryTheory StringDiagrams Supercategory
open SKM (zsign)
universe u
variable {I X k : Type u} [AddCommGroup X] [CommRing k]
  (D : SKM.Datum I X) (Sc : SKM.Scalars D k)

/-- Homogeneous affine morphisms are generated by diagrams of that same parity. -/
theorem affine_homogeneous_induction {s t : List I} {p : ZMod 2}
    {P : ((pres D Sc).obj (ob D s) ⟶ (pres D Sc).obj (ob D t)) → Prop}
    (zero : P 0) (add : ∀ f g, P f → P g → P (f + g))
    (smul : ∀ (c : k) f, P f → P (c • f))
    (diag : ∀ (d : ob D s ⟶ ob D t), Diagram.degree (Presentation.parityDeg (sig D)) d = p → P ((pres D Sc).diag d))
    {f : (pres D Sc).obj (ob D s) ⟶ (pres D Sc).obj (ob D t)}
    (hf : f ∈ parity (R := k) _ _ p) : P f := by
  obtain ⟨x, hx, rfl⟩ := Presentation.mem_homDeg_iff.mp hf
  clear hf
  rw [LinDiagram.homDeg, Finsupp.supported_eq_span_single] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨d, hd, rfl⟩ := hy
    exact diag d hd
  | zero => simpa only [Presentation.lin_zero] using zero
  | add x y _ _ hx hy => simpa only [Presentation.lin_add] using add _ _ hx hy
  | smul c x _ hx => simpa only [Presentation.lin_smul] using smul c _ hx

/-- The affine half-turn preserves the actual homogeneous parity submodules. -/
theorem htPres_mem_parity {s t : List I} {p : ZMod 2}
    {f : (pres D Sc).obj (ob D s) ⟶ (pres D Sc).obj (ob D t)}
    (hf : f ∈ parity (R := k) _ _ p) :
    htPres D Sc s t f ∈ parity (R := k) _ _ p := by
  apply affine_homogeneous_induction D Sc
      (P := fun f => htPres D Sc s t f ∈ parity (R := k) _ _ p)
      (by simp only [map_zero]; exact Submodule.zero_mem _) (fun _ _ hf hg => by
        rw [map_add]; exact Submodule.add_mem _ hf hg)
      (fun c _ hf => by rw [map_smul]; exact Submodule.smul_mem _ c hf) ?_ hf
  intro d hd
  obtain ⟨ls, hl, rfl⟩ := exists_mkD d
  rw [degree_parity_mkD] at hd
  exact hd ▸ htPres_diag_mkD_mem_parity D Sc ls hl

/-- The chronological composition law for arbitrary homogeneous affine morphisms. -/
theorem htPres_comp {s t r : List I} {p q : ZMod 2}
    {f : (pres D Sc).obj (ob D s) ⟶ (pres D Sc).obj (ob D t)}
    {g : (pres D Sc).obj (ob D t) ⟶ (pres D Sc).obj (ob D r)}
    (hf : f ∈ parity (R := k) _ _ p) (hg : g ∈ parity (R := k) _ _ q) :
    htPres D Sc s r (f ≫ g) = zsign k (p * q) •
      (htPres D Sc t r g ≫ htPres D Sc s t f) := by
  apply affine_homogeneous_induction D Sc
      (P := fun f => htPres D Sc s r (f ≫ g) = zsign k (p * q) •
        (htPres D Sc t r g ≫ htPres D Sc s t f))
      (by simp) (fun _ _ h₁ h₂ => by simp only [Preadditive.add_comp,
        Preadditive.comp_add, map_add, smul_add, h₁, h₂])
      (fun c _ h => by simp only [Linear.smul_comp, Linear.comp_smul, map_smul, h, smul_comm c]) ?_ hf
  intro d hd
  obtain ⟨A, hA, rfl⟩ := exists_mkD d
  rw [degree_parity_mkD] at hd
  subst p
  apply affine_homogeneous_induction D Sc
      (P := fun g => htPres D Sc s r ((pres D Sc).diag (mkD D A hA) ≫ g) =
        zsign k (psum D A * q) • (htPres D Sc t r g ≫
          htPres D Sc s t ((pres D Sc).diag (mkD D A hA))))
      (by simp) (fun _ _ h₁ h₂ => by simp only [Preadditive.comp_add,
        Preadditive.add_comp, map_add, smul_add, h₁, h₂])
      (fun c _ h => by simp only [Linear.smul_comp, Linear.comp_smul, map_smul, h, smul_comm c]) ?_ hg
  intro d hd
  obtain ⟨B, hB, rfl⟩ := exists_mkD d
  rw [degree_parity_mkD] at hd
  exact hd ▸ htPres_diag_comp D Sc A B hA hB

/-- Homogeneous full coefficient tensors have the sum of the two actual parities. -/
theorem sourceCoefficientHom_mem_parity {s t : List I} {a : SKM.SYM D k}
    {p q : ZMod 2} (ha : CoefParity D p a)
    {f : (pres D Sc).obj (ob D s) ⟶ (pres D Sc).obj (ob D t)}
    (hf : f ∈ parity (R := k) _ _ q) :
    sourceCoefficientHom D Sc a f ∈ parity (R := k) _ _ (p + q) :=
  BoxProd.tmul_mem_parity ha hf

/-- A homogeneous coefficient-extended morphism is a sum of pure homogeneous
coefficient/affine tensors whose total parity is that of the original morphism. -/
theorem coefficient_homogeneous_induction {s t : List I} {p : ZMod 2}
    {P : (coefficientObj D Sc s ⟶ coefficientObj D Sc t) → Prop}
    (zero : P 0) (add : ∀ f g, P f → P g → P (f + g))
    (pure : ∀ (a b : ZMod 2) (c : SKM.SYM D k)
      (f : (pres D Sc).obj (ob D s) ⟶ (pres D Sc).obj (ob D t)),
      a + b = p → CoefParity D a c → f ∈ parity (R := k) _ _ b →
      P (sourceCoefficientHom D Sc c f))
    {x : coefficientObj D Sc s ⟶ coefficientObj D Sc t}
    (hx : x ∈ parity (R := k) _ _ p) : P x := by
  have h : P (proj k p x) := by
    clear hx
    induction x using BoxProd.induction_on_homogeneous with
    | zero => simpa only [map_zero] using zero
    | add x y hx hy => simpa only [map_add] using add _ _ hx hy
    | tmul a b c f hc hf =>
      by_cases hab : a + b = p
      · rw [← hab, proj_of_mem (BoxProd.tmul_mem_parity hc hf)]
        let α := (SKM.SYM.polynomialExteriorEquiv D k).symm (SuperalgebraCat.toElem c)
        change SuperalgebraCat.toElem c ∈ SKM.SYM.polynomialExteriorParity D k a at hc
        have hα : CoefParity D a α := by
          change SKM.SYM.polynomialExteriorEquiv D k α ∈ _
          simpa only [α, AlgEquiv.apply_symm_apply] using hc
        simpa only [sourceCoefficientHom, coefficientHom, α, AlgEquiv.apply_symm_apply,
          SuperalgebraCat.toElem, SuperalgebraCat.ofElem, BoxProd.tmulHom] using
          pure a b α f hab hα hf
      · rw [proj_of_mem_ne (BoxProd.tmul_mem_parity hc hf) hab]
        exact zero
  rwa [proj_of_mem hx] at h

/-- The full coefficient half-turn preserves total parity, including the exterior factor. -/
theorem htCoef_mem_parity {s t : List I} {p : ZMod 2}
    {x : coefficientObj D Sc s ⟶ coefficientObj D Sc t}
    (hx : x ∈ parity (R := k) _ _ p) :
    htCoef D Sc s t x ∈ parity (R := k) _ _ p := by
  apply coefficient_homogeneous_induction D Sc
    (P := fun x => htCoef D Sc s t x ∈ parity (R := k) _ _ p)
    (by simp only [map_zero]; exact Submodule.zero_mem _)
    (fun _ _ hx hy => by rw [map_add]; exact Submodule.add_mem _ hx hy) ?_ hx
  intro a b c f hab hc hf
  rw [htCoef_sourceCoefficientHom, ← hab]
  exact sourceCoefficientHom_mem_parity D _ hc (htPres_mem_parity D Sc hf)

/-- Supercommutation of full abstract coefficients, transported through the
proved polynomial/exterior algebra equivalence. -/
theorem CoefParity.supercomm {p q : ZMod 2} {a b : SKM.SYM D k}
    (ha : CoefParity D p a) (hb : CoefParity D q b) :
    a * b = zsign k (p * q) • (b * a) := by
  apply (SKM.SYM.polynomialExteriorEquiv D k).injective
  simpa only [map_mul, map_smul] using SKM.SYM.polynomialExteriorParity_supercomm D ha hb

private theorem htCoef_pure_comp {s t r : List I} {a b u v : ZMod 2}
    {α β : SKM.SYM D k} (hα : CoefParity D a α) (hβ : CoefParity D b β)
    {f : (pres D Sc).obj (ob D s) ⟶ (pres D Sc).obj (ob D t)}
    {g : (pres D Sc).obj (ob D t) ⟶ (pres D Sc).obj (ob D r)}
    (hf : f ∈ parity (R := k) _ _ u) (hg : g ∈ parity (R := k) _ _ v) :
    htCoef D Sc s r (sourceCoefficientHom D Sc α f ≫ sourceCoefficientHom D Sc β g) =
      zsign k ((a + u) * (b + v)) •
        (htCoef D Sc t r (sourceCoefficientHom D Sc β g) ≫
          htCoef D Sc s t (sourceCoefficientHom D Sc α f)) := by
  rw [sourceCoefficientHom_comp D Sc hα _ _ hg, ← Int.cast_smul_eq_zsmul k,
    map_smul, htCoef_sourceCoefficientHom, htPres_comp D Sc hf hg,
    sourceCoefficientHom_smul_right, hβ.supercomm D hα, sourceCoefficientHom_smul,
    htCoef_sourceCoefficientHom, htCoef_sourceCoefficientHom,
    sourceCoefficientHom_comp D (parameterTwist D Sc) hβ _ _ (htPres_mem_parity D Sc hf),
    ← Int.cast_smul_eq_zsmul k]
  simp only [smul_smul, koszulSign_cast, ← SKM.zsign_add]
  congr 2
  have h : ∀ a b u v : ZMod 2,
      a * v + (u * v + b * a) = (a + u) * (b + v) + b * u := by decide
  exact h a b u v

/-- The actual full-coefficient signed chronological composition law. The sign
uses total parity, so odd exterior coefficients contribute to it. -/
theorem htCoef_comp {s t r : List I} {p q : ZMod 2}
    {x : coefficientObj D Sc s ⟶ coefficientObj D Sc t}
    {y : coefficientObj D Sc t ⟶ coefficientObj D Sc r}
    (hx : x ∈ parity (R := k) _ _ p) (hy : y ∈ parity (R := k) _ _ q) :
    htCoef D Sc s r (x ≫ y) = zsign k (p * q) •
      (htCoef D Sc t r y ≫ htCoef D Sc s t x) := by
  apply coefficient_homogeneous_induction D Sc
    (P := fun x => htCoef D Sc s r (x ≫ y) = zsign k (p * q) •
      (htCoef D Sc t r y ≫ htCoef D Sc s t x))
    (by simp) (fun _ _ h₁ h₂ => by simp only [Preadditive.add_comp,
      Preadditive.comp_add, map_add, smul_add, h₁, h₂]) ?_ hx
  intro a u α f hau hα hf
  apply coefficient_homogeneous_induction D Sc
    (P := fun y => htCoef D Sc s r (sourceCoefficientHom D Sc α f ≫ y) =
      zsign k (p * q) • (htCoef D Sc t r y ≫
        htCoef D Sc s t (sourceCoefficientHom D Sc α f)))
    (by simp) (fun _ _ h₁ h₂ => by simp only [Preadditive.comp_add,
      Preadditive.add_comp, map_add, smul_add, h₁, h₂]) ?_ hy
  intro b v β g hbv hβ hg
  simpa only [hau, hbv] using htCoef_pure_comp D Sc hα hβ hf hg

end OddMath.QuiverHecke
