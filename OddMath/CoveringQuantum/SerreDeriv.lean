import OddMath.CoveringQuantum.SerreIdeal
import OddMath.CoveringQuantum.PreF.Reversal
import OddMath.CoveringQuantum.UDot.Rho

/-!
# Skew derivatives preserve the Serre ideal

The skew derivatives of Clark–Hill–Wang, arXiv:1301.1665v2, §1.5 preserve the
ideal generated by the Serre relations of Brundan–Ellis, arXiv:1701.04133v2,
§10. The generator calculation is that of [CHW1] §1.7, with the inverse quantum
parameter convention of [BE2]. Twisted Leibniz extends it to the two-sided ideal;
word reversal exchanges the derivatives. These results supply quotient descent
for the Verma lowering operators, without identifying the ideal with a radical.
Neither finiteness of the colour type nor bar consistency is required. In contrast,
[CHW1] uses a finite colour set and defines its half algebra by the radical.
-/

noncomputable section

namespace OddMath.CoveringQuantum.SuperCartanDatum

variable {k I : Type*} [CommRing k] (C : SuperCartanDatum I) (q : kˣ) (π : k)

/-- The right skew derivative preserves the two-sided Serre ideal. -/
theorem rDeriv_mem_serreIdeal [DecidableEq I] (hπ : π ^ 2 = 1) (i : I)
    {x : PreF k I} (hx : x ∈ C.serreIdeal q π) :
    PreF.rDeriv (C.chi q π) i x ∈ C.serreIdeal q π := by
  let J := C.serreIdeal q π
  suffices h : x ∈ J ∧ PreF.rDeriv (C.chi q π) i x ∈ J from h.2
  rw [C.serreIdeal_eq_span] at hx
  induction hx using TwoSidedIdeal.span_induction with
  | mem x hx =>
    obtain ⟨a, b, hab, rfl⟩ := hx
    exact ⟨(C.mem_serreIdeal q π _).mpr (C.toSerreF_serreElt q π hab),
      by rw [C.rDeriv_serreElt q π hπ hab]; exact J.zero_mem⟩
  | zero => exact ⟨J.zero_mem, by rw [map_zero]; exact J.zero_mem⟩
  | add x y _ _ hx hy =>
    exact ⟨J.add_mem hx.1 hy.1, by rw [map_add]; exact J.add_mem hx.2 hy.2⟩
  | neg x _ hx => exact ⟨J.neg_mem hx.1, by rw [map_neg]; exact J.neg_mem hx.2⟩
  | left_absorb a x _ hx =>
    refine ⟨J.mul_mem_left _ _ hx.1, ?_⟩
    rw [PreF.rDeriv_mul]
    exact J.add_mem (J.mul_mem_left _ _ hx.2)
      (J.mul_mem_left _ _ (C.diagTwist_mem_serreIdeal q π _ hx.1))
  | right_absorb a x _ hx =>
    refine ⟨J.mul_mem_right _ _ hx.1, ?_⟩
    rw [PreF.rDeriv_mul]
    exact J.add_mem (J.mul_mem_right _ _ hx.1) (J.mul_mem_right _ _ hx.2)

private theorem reverse_pow (i : I) (n : ℕ) :
    PreF.wordReverse (PreF.θ k i ^ n) = PreF.θ k i ^ n := by
  induction n with
  | zero => simp
  | succ n ih => simp only [pow_succ, PreF.wordReverse_mul, PreF.wordReverse_θ, ih];
                 rw [← pow_succ', pow_succ]

/-- Reversal scales a Serre generator by its reflected endpoint coefficient. -/
theorem wordReverse_serreElt (hπ : π ^ 2 = 1) {i j : I} (hij : i ≠ j) :
    PreF.wordReverse (C.serreElt q π i j) =
      ((-1) ^ C.serreDeg i j *
        C.pii π i ^ (C.serreDeg i j * (C.parity j).val + (C.serreDeg i j).choose 2)) •
        C.serreElt q π i j := by
  unfold serreElt
  rw [map_sum, Finset.smul_sum]
  conv_lhs => rw [← Finset.sum_range_reflect]
  refine Finset.sum_congr rfl fun r hr ↦ ?_
  have hrN : r ≤ C.serreDeg i j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
  simp only [Nat.add_sub_cancel, map_smul, PreF.wordReverse_mul, reverse_pow,
    PreF.wordReverse_θ, Nat.sub_sub_self hrN, C.serreCoeff_reflect q π hπ hij hrN,
    smul_smul, mul_assoc]

/-- Word reversal preserves the Serre ideal. -/
theorem wordReverse_mem_serreIdeal (hπ : π ^ 2 = 1) {x : PreF k I}
    (hx : x ∈ C.serreIdeal q π) : PreF.wordReverse x ∈ C.serreIdeal q π := by
  let J := C.serreIdeal q π
  rw [C.serreIdeal_eq_span] at hx
  induction hx using TwoSidedIdeal.span_induction with
  | mem x hx =>
    obtain ⟨i, j, hij, rfl⟩ := hx
    apply (C.mem_serreIdeal q π _).mpr
    rw [C.wordReverse_serreElt q π hπ hij, map_smul,
      C.toSerreF_serreElt q π hij, smul_zero]
  | zero => rw [map_zero]; exact J.zero_mem
  | add x y _ _ hx hy => rw [map_add]; exact J.add_mem hx hy
  | neg x _ hx => rw [map_neg]; exact J.neg_mem hx
  | left_absorb a x _ hx => rw [PreF.wordReverse_mul]; exact J.mul_mem_right _ _ hx
  | right_absorb a x _ hx => rw [PreF.wordReverse_mul]; exact J.mul_mem_left _ _ hx

private theorem reverse_reverse (x : PreF k I) :
    PreF.wordReverse (PreF.wordReverse x) = x := by
  induction x using FreeAlgebra.induction with
  | grade0 c => simp
  | grade1 i => simp
  | mul x y hx hy => simp only [PreF.wordReverse_mul, hx, hy]
  | add x y hx hy => simp only [map_add, hx, hy]

/-- The left skew derivative preserves the two-sided Serre ideal. -/
theorem lDeriv_mem_serreIdeal [DecidableEq I] (hπ : π ^ 2 = 1) (i : I)
    {x : PreF k I} (hx : x ∈ C.serreIdeal q π) :
    PreF.lDeriv (C.chi q π) i x ∈ C.serreIdeal q π := by
  have h := C.wordReverse_mem_serreIdeal q π hπ
    (C.rDeriv_mem_serreIdeal q π hπ i (C.wordReverse_mem_serreIdeal q π hπ hx))
  rwa [PreF.rDeriv_wordReverse, reverse_reverse] at h

end OddMath.CoveringQuantum.SuperCartanDatum
