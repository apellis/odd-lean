import OddMath.CoveringQuantum.SuperCount.Coefficients
import OddMath.CoveringQuantum.SuperCount.SerreSpecialization
import OddMath.CoveringQuantum.SerreBaseChange
import LieLean.Algebra.Lie.KacMoody.Super.ShapovalovPairing

/-!
# The Serre relations of the covering half algebra at `π = -1`

For a super Cartan datum with finitely many simple roots, a field `k` of characteristic zero and
`q ∈ k` transcendental over `ℚ`, the radical of the form on `'f` at `π = -1` is the two-sided
ideal generated by the quantum Serre elements (10.1) of [BE2]
(`SuperCartanDatum.serreIdeal_neg_one_eq_radical_of_transcendental`), and its weight-`ν` part has
dimension `#{words of weight ν} - K(ν)`, with `K` Kostant's partition function of the underlying
Kac–Moody algebra (`SuperCartanDatum.finrank_productSpan_neg_one`). This is the dimension count
of Hill–Wang, *Categorification of quantum Kac–Moody superalgebras*, arXiv:1202.2769v2,
Lemma 6.11, for all super Cartan data; no bar-consistency hypothesis is needed.

The argument is the specialization argument of the quantum Gabber–Kac theorem
(`LusztigF.mem_serreSpan_of_mem_radical_and_finrank_serreSpan` in `LieLean`). Over
`ℚ[T, T⁻¹]` the Serre products specialize at `T = q` to elements of the ideal and at `T = 1`, by
`SuperCartanDatum.serreElt_one_neg_one`, to the super Serre products of the contragredient Lie
superalgebra `G(A, τ)` of Kac (Adv. Math. 30 (1978)). The Shapovalov-type pairings of the raising
operators (`OddMath.CoveringQuantum.SuperCount.Operator`) vanish on the radical and specialize to
the sign-twisted classical pairings, whose kernel is the super Serre ideal
(`LusztigF.mem_superSerreIdeal_of_shapovalovMap_eq_zero`, from the irreducibility of the
integrable highest-weight modules of `G(A, τ)`). Comparing dimensions gives the result. The
computation is ours.

## Main results

* `SuperCartanDatum.serreElt_mem_wordSpan`: the Serre elements are homogeneous.
* `SuperCartanDatum.mem_productSpan_of_mem_radical`: the count, weight by weight.
* `SuperCartanDatum.serreIdeal_neg_one_eq_radical_of_transcendental`.
* `SuperCartanDatum.finrank_productSpan_neg_one`.
-/

noncomputable section

namespace OddMath.CoveringQuantum

open Module FreeAlgebra LusztigF Matrix.Realization Matrix.Realization.SuperEnveloping

/-! ### Gradedness of the radical -/

namespace PreF

variable {k I : Type*} [Field k] [DecidableEq I] (χ : Bichar k I) (nm : I → k)

/-- The projections onto weight spaces are self-adjoint for the form. -/
lemma form_weightProj (ν : I →₀ ℕ) (y x : PreF k I) :
    form χ nm (weightProj k ν y) x = form χ nm y (weightProj k ν x) := by
  induction y using induction_wordBasis with
  | zero => simp
  | add y y' hy hy' => simp only [map_add, LinearMap.add_apply, hy, hy']
  | smul c y hy => simp only [map_smul, LinearMap.smul_apply, hy]
  | word w =>
    induction x using induction_wordBasis with
    | zero => simp
    | add x x' hx hx' => rw [map_add, map_add, map_add, hx, hx']
    | smul c x hx => rw [map_smul, map_smul, map_smul, hx]
    | word u =>
      rw [weightProj_wordBasis, weightProj_wordBasis]
      by_cases hwu : LusztigF.wordWeight w = LusztigF.wordWeight u
      · rw [hwu]; split_ifs <;> simp
      · have h0 := form_eq_zero_of_ne χ nm hwu (wordBasis_mem_wordSpan (R := k) w)
          (wordBasis_mem_wordSpan (R := k) u)
        split_ifs <;> simp only [map_zero, LinearMap.zero_apply, h0]

/-- The radical of the form is graded. -/
lemma weightProj_mem_radical (ν : I →₀ ℕ) {x : PreF k I} (hx : x ∈ radical χ nm) :
    weightProj k ν x ∈ radical χ nm := by
  rw [mem_radical_iff']
  intro y
  rw [← form_weightProj, (mem_radical_iff' χ nm).1 hx]

end PreF

namespace SuperCartanDatum

variable {I : Type*} (C : SuperCartanDatum I)

/-! ### Homogeneity of the Serre elements -/

section Homogeneous

variable {R : Type*} [CommRing R] (q : Rˣ) (π : R)

lemma θ_pow_mem_weightSpace (i : I) (m : ℕ) :
    PreF.θ R i ^ m ∈ PreF.weightSpace R (m • Finsupp.single i 1) := by
  induction m with
  | zero => rw [pow_zero, zero_smul]; exact PreF.one_mem_weightSpace
  | succ m ih =>
    rw [pow_succ, succ_nsmul]
    exact PreF.mul_mem_weightSpace ih (PreF.θ_mem_weightSpace i)

lemma serreDeg_eq_toNat {i j : I} (h : i ≠ j) : C.serreDeg i j = (-C.a i j).toNat + 1 := by
  have := C.isGCM.offDiag_nonpos i j h
  unfold serreDeg
  omega

/-- The Serre element `sᵢⱼ` has weight `(1 - aᵢⱼ) αᵢ + αⱼ`. -/
lemma serreElt_mem_wordSpan (ij : SerrePair I) :
    C.serreElt q π ij.1.1 ij.1.2 ∈ wordSpan R (superSerreWeight C.a ij) := by
  obtain ⟨⟨i, j⟩, hij⟩ := ij
  refine Submodule.sum_mem _ fun r hr ↦ Submodule.smul_mem _ _ ?_
  have h := PreF.mul_mem_weightSpace (PreF.mul_mem_weightSpace
    (θ_pow_mem_weightSpace (R := R) i (C.serreDeg i j - r)) (PreF.θ_mem_weightSpace j))
    (θ_pow_mem_weightSpace (R := R) i r)
  have hr' : r ≤ C.serreDeg i j := Nat.lt_succ_iff.1 (Finset.mem_range.1 hr)
  have key : superSerreWeight C.a ⟨(i, j), hij⟩ =
      (C.serreDeg i j - r) • Finsupp.single i 1 + Finsupp.single j 1 + r • Finsupp.single i 1 := by
    show Finsupp.single j 1 + wordWeight (List.replicate ((-C.a i j).toNat + 1) i) = _
    rw [wordWeight_replicate, ← C.serreDeg_eq_toNat hij]
    obtain ⟨t, ht⟩ := Nat.exists_eq_add_of_le hr'
    rw [ht, Nat.add_sub_cancel_left, add_nsmul]
    abel
  rw [key]
  exact h

end Homogeneous

/-! ### The Serre families -/

variable [DecidableEq I] {k : Type*} [Field k] [CharZero k]

/-- The quantum Serre elements over `ℚ[T, T⁻¹]`, at `q = T` and `π = -1`. -/
def serreFamilyL (ij : SerrePair I) : FreeAlgebra (LaurentPolynomial ℚ) I :=
  C.serreElt laurentT (-1) ij.1.1 ij.1.2

/-- The quantum Serre elements at `π = -1`, as a family indexed by the pairs `i ≠ j`. -/
def serreFamily (q : kˣ) (ij : SerrePair I) : FreeAlgebra k I :=
  C.serreElt q (-1) ij.1.1 ij.1.2

lemma mapCoeffs_product {R S X J : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (s : J → FreeAlgebra R X) (g : List X × J × List X) :
    mapCoeffs φ (product s g) = product (fun j ↦ mapCoeffs φ (s j)) g := by
  rw [product, product, map_mul, map_mul, mapCoeffs_wordBasis, mapCoeffs_wordBasis]

omit [DecidableEq I] in
lemma mapCoeffs_serreFamilyL (q : kˣ) (ij : SerrePair I) :
    mapCoeffs (evalAt (q : k) q.ne_zero) (C.serreFamilyL ij) = C.serreFamily q ij := by
  rw [serreFamilyL, serreFamily, mapCoeffs_serreElt, map_neg, map_one]
  congr 1
  ext
  simp [evalAt_laurentT]

omit [DecidableEq I] in
lemma mapCoeffs_one_serreFamilyL (ij : SerrePair I) :
    mapCoeffs (evalAt (1 : ℚ) one_ne_zero) (C.serreFamilyL ij) =
      superSerreFamily ℚ C.a C.parity ij := by
  have h := C.mapCoeffs_serreFamilyL (1 : ℚˣ) ij
  simp only [Units.val_one] at h
  rw [h, serreFamily, superSerreFamily, serreElt_one_neg_one C ij.2]

omit [DecidableEq I] [CharZero k] in
lemma serreFamily_mem_serreIdeal (q : kˣ) {ν : I →₀ ℕ} {x : PreF k I}
    (hx : x ∈ productSpan (C.serreFamily q) (superSerreWeight C.a) ν) :
    x ∈ C.serreIdeal q (-1) := by
  have h := productSpan_le_ideal (s := C.serreFamily q) (wt := superSerreWeight C.a) ν hx
  refine (TwoSidedIdeal.span_le.2 ?_) h
  rintro _ ⟨ij, rfl⟩
  rw [SetLike.mem_coe, mem_serreIdeal]
  exact C.toSerreF_serreElt q (-1) ij.2

/-! ### The count -/

omit [DecidableEq I] in
lemma finiteDimensional_wordSpan (K : Type*) [Field K] (ν : I →₀ ℕ) :
    FiniteDimensional K (wordSpan K ν) :=
  FiniteDimensional.span_of_finite K ((finite_setOf_wordWeight_eq ν).image _)

/-- **The π = -1 Serre count, weight by weight.** For `q` transcendental over `ℚ`, an element of
weight `ν` of the radical of the form at `π = -1` is a combination of products `a sᵢⱼ b` of weight
`ν` of the quantum Serre elements with words, and the span of these products has the dimension of
the span of the super Serre products of weight `ν` of `G(A, τ)` over `ℚ`. -/
theorem mem_productSpan_of_mem_radical [Finite I] {q : kˣ} (hq : Transcendental ℚ (q : k))
    (ν : I →₀ ℕ) :
    (∀ x : PreF k I, x ∈ PreF.radical (C.chi q (-1)) (C.norm q (-1)) → x ∈ wordSpan k ν →
      x ∈ productSpan (C.serreFamily q) (superSerreWeight C.a) ν) ∧
    finrank k (productSpan (C.serreFamily q) (superSerreWeight C.a) ν) =
      finrank ℚ (productSpan (superSerreFamily ℚ C.a C.parity) (superSerreWeight C.a) ν) := by
  have := Fintype.ofFinite I
  have hq0 : (q : k) ≠ 0 := q.ne_zero
  have hinj : Function.Injective (evalAt (q : k) hq0) :=
    LaurentPolynomial.eval₂_injective_of_transcendental hq hq0
  have hden : ∀ i, qDenom C.lusztigDatum (q : k) i ≠ 0 := by
    intro i
    simp only [qDenom, lusztigDatum_d]
    rw [sub_ne_zero]
    intro h
    have hx : (q : k) ^ C.d i ≠ 0 := pow_ne_zero _ hq0
    have h2 : ((q : k) ^ C.d i) ^ 2 = 1 := by
      rw [sq]; nth_rewrite 2 [h]; exact mul_inv_cancel₀ hx
    rw [← pow_mul] at h2
    exact pow_ne_one_of_transcendental hq (by have := C.d_pos i; omega) h2
  have hA : C.lusztigDatum.cartanMatrix = C.a := by
    ext i j; exact lusztigDatum_cartanMatrix C i j
  have hp : C.lusztigDatum.cartanMatrix.IsSuperAdmissible C.parity := by
    rw [hA]; exact C.even_of_odd
  set n : I → ℕ := fun i ↦ 2 * ν i with hn_def
  set cL : I → (I →₀ ℕ) → LaurentPolynomial ℚ := C.superCoeff n
  set c₀ : I → (I →₀ ℕ) → ℚ := fun i μ ↦
    weightSign (superSign ℚ C.parity i) μ * classicalCoeff ℚ C.lusztigDatum n i μ
  have hc₀ : (fun i ↦ (evalAt (1 : ℚ) one_ne_zero) ∘ cL i) = c₀ := by
    funext i μ
    exact C.evalAt_one_superCoeff n i μ
  have hcq : (fun i μ ↦ C.raiseA q n i * (C.chi q⁻¹ (-1)).wt (Finsupp.single i 1) μ -
      C.raiseB q n i * (C.chi q (-1)).wt (Finsupp.single i 1) μ) =
      fun i ↦ (evalAt (q : k) hq0) ∘ cL i := by
    funext i μ
    exact C.raiseCoeff_eq_evalAt q n (hden i) μ
  -- the quantum and classical Shapovalov maps
  let Φ : PreF k I →ₗ[k] (Words ν → k) :=
    shapovalovMap (fun i ↦ (evalAt (q : k) hq0) ∘ cL i) ν
  let Φ₀ : FreeAlgebra ℚ I →ₗ[ℚ] (Words ν → ℚ) := shapovalovMap c₀ ν
  have hspecQ : ∀ (u : List I) (w : Words ν),
      evalAt (q : k) hq0 (vermaForm cL w.1 (wordBasis _ I u)) = Φ (wordBasis k I u) w := by
    intro u w
    rw [map_vermaForm, mapCoeffs_wordBasis]
    rfl
  have hspec₀ : ∀ (u : List I) (w : Words ν),
      evalAt (1 : ℚ) one_ne_zero (vermaForm cL w.1 (wordBasis _ I u)) =
        Φ₀ (wordBasis ℚ I u) w := by
    intro u w
    rw [map_vermaForm, mapCoeffs_wordBasis, hc₀]
    rfl
  set V := wordSpan k ν
  set V₀ := wordSpan ℚ ν
  have := finiteDimensional_wordSpan k ν
  have := finiteDimensional_wordSpan ℚ ν
  set Z := productSpan (superSerreFamily ℚ C.a C.parity) (superSerreWeight C.a) ν
  have hZV : Z ≤ V₀ := productSpan_le_wordSpan (superSerreFamily_mem_wordSpan C.a C.parity) ν
  have hZfin : FiniteDimensional ℚ Z := Submodule.finiteDimensional_of_le hZV
  set Ser := productSpan (C.serreFamily q) (superSerreWeight C.a) ν
  have hSerV : Ser ≤ V := productSpan_le_wordSpan (fun ij ↦ C.serreElt_mem_wordSpan q (-1) ij) ν
  have : FiniteDimensional k Ser := Submodule.finiteDimensional_of_le hSerV
  -- Step 1: the kernel of `Φ₀` on `V₀` lies in `Z`
  have hker₀ : finrank ℚ (LinearMap.ker (Φ₀.domRestrict V₀)) ≤ finrank ℚ Z := by
    rw [← Submodule.finrank_map_subtype_eq]
    refine Submodule.finrank_mono ?_
    rintro _ ⟨y, hy, rfl⟩
    have hy' : Φ₀ (y : FreeAlgebra ℚ I) = 0 := hy
    have h := mem_superSerreIdeal_of_shapovalovMap_eq_zero C.lusztigDatum hp n
      (fun i _ ↦ even_two_mul _) (s := fun _ ↦ (1 : ℚ)) (fun _ ↦ one_ne_zero)
      (fun i μ ↦ (one_mul _).symm) (fun i ↦ by simp only [hn_def]; omega) y.2 hy'
    rw [hA] at h
    exact (mem_superSerreIdeal_iff_mem_productSpan y.2).1 h
  have hrange₀ : LinearMap.range (Φ₀.domRestrict V₀) =
      Submodule.span ℚ (Set.range fun w : Words ν ↦ Φ₀ (wordBasis ℚ I w.1)) := by
    rw [LinearMap.range_domRestrict, show V₀ = _ from weightSpace_eq_span ℚ ν, Submodule.map_span,
      ← Set.range_comp]
    rfl
  have hrank₀ := LinearMap.finrank_range_add_finrank_ker (Φ₀.domRestrict V₀)
  -- Step 2: `rank Φ ≥ rank Φ₀` by specialization
  obtain ⟨a, ha⟩ := exists_linearIndependent_fin (K := ℚ) fun w : Words ν ↦ Φ₀ (wordBasis ℚ I w.1)
  have hqa : LinearIndependent k fun t ↦ Φ (wordBasis k I (a t).1) := by
    have h := LinearIndependent.of_comp_ratHom (evalAt (1 : ℚ) one_ne_zero) (evalAt (q : k) hq0)
      hinj (fun t (w : Words ν) ↦ vermaForm cL w.1 (wordBasis _ I (a t).1)) (by
        convert ha using 1
        funext t w
        exact hspec₀ _ w)
    convert h using 1
    funext t w
    exact (hspecQ _ w).symm
  have hr := card_le_finrank_of_linearIndependent hqa (S := LinearMap.range (Φ.domRestrict V))
    fun t ↦ ⟨⟨_, wordBasis_mem_wordSpan_of_eq (a t).2⟩, rfl⟩
  rw [← hrange₀] at hr
  have hrank := LinearMap.finrank_range_add_finrank_ker (Φ.domRestrict V)
  have hV₁ : finrank k V = Fintype.card (Words ν) := finrank_weightSpace k ν
  have hV₂ : finrank ℚ V₀ = Fintype.card (Words ν) := finrank_weightSpace ℚ ν
  have hVV₀ : finrank k V = finrank ℚ V₀ := hV₁.trans hV₂.symm
  have hker : finrank k (LinearMap.ker (Φ.domRestrict V)) ≤ finrank ℚ Z := by
    rw [hV₁] at hrank
    omega
  -- Step 3: `dim Ser ≥ dim Z` by specialization of the Serre products
  let G := {g : List I × SerrePair I × List I | productWeight (superSerreWeight C.a) g = ν}
  have hZ : Z = Submodule.span ℚ
      (Set.range fun g : G ↦ product (superSerreFamily ℚ C.a C.parity) g.1) := by
    rw [show Z = productSpan _ _ ν from rfl, productSpan, Set.image_eq_range]
  have : FiniteDimensional ℚ (Submodule.span ℚ
      (Set.range fun g : G ↦ product (superSerreFamily ℚ C.a C.parity) g.1)) := hZ ▸ hZfin
  obtain ⟨b, hb⟩ := exists_linearIndependent_fin (K := ℚ)
    fun g : G ↦ product (superSerreFamily ℚ C.a C.parity) g.1
  have hm : finrank ℚ (Submodule.span ℚ
      (Set.range fun g : G ↦ product (superSerreFamily ℚ C.a C.parity) g.1)) =
      finrank ℚ Z := by rw [hZ]
  have hb' : LinearIndependent ℚ fun t ↦
      wordCoord ℚ ν (product (superSerreFamily ℚ C.a C.parity) (b t).1) := by
    refine hb.map (f := wordCoord ℚ ν) ?_
    rw [Submodule.disjoint_def]
    intro y hy hy0
    refine eq_zero_of_wordCoord_eq_zero ?_ hy0
    have hle : Submodule.span ℚ (Set.range
        ((fun g : G ↦ product (superSerreFamily ℚ C.a C.parity) g.1) ∘ b)) ≤ wordSpan ℚ ν := by
      rw [Submodule.span_le]
      rintro _ ⟨t, rfl⟩
      exact hZV (Submodule.subset_span ⟨(b t).1, (b t).2, rfl⟩)
    exact hle hy
  have hqS : LinearIndependent k fun t ↦ product (C.serreFamily q) (b t).1 := by
    have h := LinearIndependent.of_comp_ratHom (evalAt (1 : ℚ) one_ne_zero) (evalAt (q : k) hq0)
      hinj (fun t (w : Words ν) ↦ (wordBasis _ I).repr (product C.serreFamilyL (b t).1) w.1) (by
        convert hb' using 1
        funext t w
        simp only [Function.comp_apply, wordCoord_apply, ← wordBasis_repr_mapCoeffs,
          mapCoeffs_product, mapCoeffs_one_serreFamilyL])
    refine LinearIndependent.of_comp (wordCoord k ν) ?_
    convert h using 1
    funext t w
    simp only [Function.comp_apply, wordCoord_apply, ← wordBasis_repr_mapCoeffs,
      mapCoeffs_product, mapCoeffs_serreFamilyL]
  have hm' := card_le_finrank_of_linearIndependent hqS (S := Ser) fun t ↦
    Submodule.subset_span ⟨(b t).1, (b t).2, rfl⟩
  -- Step 4: `Ser ⊆ radical ⊆ ker Φ` and `dim ker Φ ≤ dim Z ≤ dim Ser`
  have hrad : ∀ y : PreF k I, y ∈ PreF.radical (C.chi q (-1)) (C.norm q (-1)) → Φ y = 0 := by
    intro y hy
    funext w
    have h := PreF.vermaForm_eq_zero_of_mem_radical (C.chi q (-1)) (C.chi q⁻¹ (-1))
      (C.chi_inv_mul_chi q (-1) (by norm_num))
      (C.norm_isUnit_of_transcendental q hq (by norm_num)) (C.raiseA q n) (C.raiseB q n) w.1 hy
    rw [hcq] at h
    exact h
  let SerV : Submodule k V := Ser.comap V.subtype
  have hSerKer : SerV ≤ LinearMap.ker (Φ.domRestrict V) := fun y hy ↦ by
    rw [LinearMap.mem_ker]
    exact hrad _ (C.serreIdeal_le_radical q (-1) (by norm_num) (C.serreFamily_mem_serreIdeal q hy))
  have hSerV' : finrank k SerV = finrank k Ser := by
    rw [← Submodule.finrank_map_subtype_eq, Submodule.map_comap_subtype, inf_eq_right.2 hSerV]
  have hZS : finrank ℚ Z ≤ finrank k Ser := by
    rw [← hm]; simpa using hm'
  have hEq : SerV = LinearMap.ker (Φ.domRestrict V) :=
    Submodule.eq_of_le_of_finrank_le hSerKer (by rw [hSerV']; exact hker.trans hZS)
  refine ⟨fun x hx hxν ↦ ?_, ?_⟩
  · have hxV : (⟨x, hxν⟩ : V) ∈ SerV := by
      rw [hEq, LinearMap.mem_ker]
      exact hrad x hx
    exact hxV
  · refine le_antisymm ?_ hZS
    rw [← hSerV', hEq]
    exact hker

/-- **The Serre relations at `π = -1`.** For a super Cartan datum with finitely many simple
roots, a field `k` of characteristic zero and `q ∈ k` transcendental over `ℚ`, the radical of the
form on `'f` at `π = -1` is the two-sided ideal generated by the quantum Serre elements (10.1) of
[BE2]: `f = 'f / I` is presented by the quantum Serre relations. -/
theorem serreIdeal_neg_one_eq_radical_of_transcendental [Finite I] {q : kˣ}
    (hq : Transcendental ℚ (q : k)) :
    C.serreIdeal q (-1) = PreF.radical (C.chi q (-1)) (C.norm q (-1)) := by
  refine le_antisymm (C.serreIdeal_le_radical q (-1) (by norm_num)) fun x hx ↦ ?_
  rw [← LusztigF.sum_weightProj x]
  refine Finset.sum_induction _ (· ∈ C.serreIdeal q (-1))
    (fun a b ha hb ↦ TwoSidedIdeal.add_mem _ ha hb) (C.serreIdeal q (-1)).zero_mem fun ν _ ↦ ?_
  exact C.serreFamily_mem_serreIdeal q ((C.mem_productSpan_of_mem_radical hq ν).1 _
    (PreF.weightProj_mem_radical _ _ ν hx) (weightProj_mem ν x))

/-- **The π = -1 dimension count** (Hill–Wang, arXiv:1202.2769v2, Lemma 6.11, for all super
Cartan data): the weight-`ν` part of the ideal generated by the quantum Serre elements at
`π = -1` has dimension `#{words of weight ν} - K(ν)`, with `K` Kostant's partition function of the
Kac–Moody algebra of the Cartan matrix (for any realization over `ℚ`). -/
theorem finrank_productSpan_neg_one [Fintype I] {q : kˣ} (hq : Transcendental ℚ (q : k))
    {H : Type*} [AddCommGroup H] [Module ℚ H] [FiniteDimensional ℚ H] (P : Matrix.Realization C.a ℚ H) (ν : I →₀ ℕ) :
    KacMoodyAlgebra.kostantPartition P (P.rootOf (natVec ν)) +
      finrank k (productSpan (C.serreFamily q) (superSerreWeight C.a) ν) =
        Fintype.card (Words ν) := by
  have hA : C.lusztigDatum.cartanMatrix = C.a := by
    ext i j; exact lusztigDatum_cartanMatrix C i j
  obtain ⟨S⟩ := Matrix.isSymmetrizable_iff_nonempty_symmetrization.1
    (hA ▸ C.lusztigDatum.isSymmetrizable_cartanMatrix)
  rw [(C.mem_productSpan_of_mem_radical hq ν).2]
  have h := kostantPartition_add_finrank_superSerreIdeal (P := P) (p := C.parity) S C.isGCM
    C.even_of_odd ν
  have hZ : productSpan (superSerreFamily ℚ C.a C.parity) (superSerreWeight C.a) ν =
      wordSpan ℚ ν ⊓ (superSerreIdeal ℚ C.a C.parity).restrictScalars ℚ := by
    ext y
    refine ⟨fun hy ↦ ?_, fun hy ↦ (mem_superSerreIdeal_iff_mem_productSpan hy.1).1 hy.2⟩
    have hyν := productSpan_le_wordSpan (superSerreFamily_mem_wordSpan C.a C.parity) ν hy
    exact ⟨hyν, (mem_superSerreIdeal_iff_mem_productSpan hyν).2 hy⟩
  rw [hZ]
  exact h

end SuperCartanDatum

end OddMath.CoveringQuantum
