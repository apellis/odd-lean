import OddMath.CoveringQuantum.SerreForm
import OddMath.CoveringQuantum.PreF.GaugeForm
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# The Serre ideal and diagonal maps

The kernel of the Serre presentation is the two-sided ideal generated by its
relations. Diagonal changes of the generators preserve this ideal. These
facts allow word-gauge identities on generators to extend to ideal transport.
-/

noncomputable section

namespace OddMath.CoveringQuantum.SuperCartanDatum

variable {k I : Type*} [CommRing k] (C : SuperCartanDatum I) (q : kˣ) (π : k)

/-- The presentation kernel is contained in every ideal containing its relations. -/
theorem serreIdeal_le (J : TwoSidedIdeal (PreF k I))
    (hJ : ∀ i j, i ≠ j → C.serreElt q π i j ∈ J) : C.serreIdeal q π ≤ J := by
  let Q : PreF k I →ₐ[k] J.ringCon.Quotient := RingCon.mkₐ k J.ringCon
  have hz (x : PreF k I) : Q x = 0 ↔ x ∈ J := by
    rw [TwoSidedIdeal.mem_iff, ← RingCon.eq]
    rfl
  have hr : ∀ x y, C.SerreRel q π x y → Q x = Q y := by
    intro x y h
    cases h with
    | serre i j hij => rw [map_zero, hz]; exact hJ i j hij
  let g : C.serreF q π →ₐ[k] J.ringCon.Quotient := RingQuot.liftAlgHom k ⟨Q, hr⟩
  intro x hx
  apply (hz x).mp
  have he : g (C.toSerreF q π x) = Q x := RingQuot.liftAlgHom_mkAlgHom_apply _ _ _ _
  rw [← he, (C.mem_serreIdeal q π x).mp hx, map_zero]

/-- The kernel presentation of the Serre ideal equals its generated-ideal presentation. -/
theorem serreIdeal_eq_span : C.serreIdeal q π =
    TwoSidedIdeal.span {x | ∃ i j, i ≠ j ∧ C.serreElt q π i j = x} := by
  apply le_antisymm
  · exact C.serreIdeal_le q π _ fun i j hij ↦ TwoSidedIdeal.subset_span ⟨i, j, hij, rfl⟩
  · apply TwoSidedIdeal.span_le.mpr
    rintro x ⟨i, j, hij, rfl⟩
    exact (C.mem_serreIdeal q π _).mpr (C.toSerreF_serreElt q π hij)

/-- A diagonal map scales a Serre relation according to its weight. -/
theorem diagTwist_serreElt (c : I → k) (i j : I) :
    PreF.diagTwist c (C.serreElt q π i j) =
      (c i ^ C.serreDeg i j * c j) • C.serreElt q π i j := by
  unfold serreElt
  rw [map_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl fun r hr ↦ ?_
  have hrN : r ≤ C.serreDeg i j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
  have hp : c i ^ (C.serreDeg i j - r) * c i ^ r = c i ^ C.serreDeg i j := by
    rw [← pow_add, Nat.sub_add_cancel hrN]
  simp only [map_smul, map_mul, map_pow, PreF.diagTwist_θ, smul_pow,
    smul_mul_smul_comm, smul_smul]
  congr 1
  linear_combination C.serreCoeff q π i j r * c j * hp

/-- Every diagonal change of free generators preserves the Serre ideal. -/
theorem diagTwist_mem_serreIdeal (c : I → k) {x : PreF k I}
    (hx : x ∈ C.serreIdeal q π) : PreF.diagTwist c x ∈ C.serreIdeal q π := by
  let g := (C.toSerreF q π).comp (PreF.diagTwist c)
  have hle : C.serreIdeal q π ≤ TwoSidedIdeal.ker g := by
    apply C.serreIdeal_le q π
    intro i j hij
    rw [TwoSidedIdeal.mem_ker]
    change C.toSerreF q π (PreF.diagTwist c (C.serreElt q π i j)) = 0
    rw [C.diagTwist_serreElt, map_smul, C.toSerreF_serreElt q π hij, smul_zero]
  exact (C.mem_serreIdeal q π _).mpr ((TwoSidedIdeal.mem_ker g).mp (hle hx))

/-- A word gauge transporting the defining generators transports the whole Serre ideal.
The diagonal-map invariance supplies the missing multiplicative closure. -/
theorem wordGauge_mem_serreIdeal (q' : kˣ) (π' : k) (f : I → I → kˣ)
    (hg : ∀ i j, i ≠ j → PreF.wordGauge f (C.serreElt q π i j) ∈ C.serreIdeal q' π')
    {x : PreF k I} (hx : x ∈ C.serreIdeal q π) :
    PreF.wordGauge f x ∈ C.serreIdeal q' π' := by
  let J := C.serreIdeal q' π'
  have hs (c : k) (y : PreF k I) (hy : y ∈ J) : c • y ∈ J := by
    apply (C.mem_serreIdeal q' π' _).mpr
    rw [map_smul, (C.mem_serreIdeal q' π' _).mp hy, smul_zero]
  have hl (a : PreF k I) : ∀ y, PreF.wordGauge f y ∈ J → PreF.wordGauge f (a * y) ∈ J := by
    induction a using FreeAlgebra.induction with
    | grade0 c =>
      intro y hy
      rw [← Algebra.smul_def, map_smul]
      exact hs _ _ hy
    | grade1 i =>
      intro y hy
      rw [PreF.wordGauge_theta_mul]
      exact J.mul_mem_left _ _ (C.diagTwist_mem_serreIdeal q' π' _ hy)
    | mul a b ha hb =>
      intro y hy
      rw [mul_assoc]
      exact ha _ (hb _ hy)
    | add a b ha hb =>
      intro y hy
      rw [add_mul, map_add]
      exact J.add_mem (ha _ hy) (hb _ hy)
  have hr (a : PreF k I) : ∀ y, PreF.wordGauge f y ∈ J → PreF.wordGauge f (y * a) ∈ J := by
    induction a using FreeAlgebra.induction with
    | grade0 c =>
      intro y hy
      rw [← Algebra.commutes, ← Algebra.smul_def, map_smul]
      exact hs _ _ hy
    | grade1 i =>
      intro y hy
      rw [PreF.wordGauge_mul_theta]
      exact J.mul_mem_right _ _ (C.diagTwist_mem_serreIdeal q' π' _ hy)
    | mul a b ha hb =>
      intro y hy
      rw [← mul_assoc]
      exact hb _ (ha _ hy)
    | add a b ha hb =>
      intro y hy
      rw [mul_add, map_add]
      exact J.add_mem (ha _ hy) (hb _ hy)
  rw [C.serreIdeal_eq_span] at hx
  induction hx using TwoSidedIdeal.span_induction with
  | mem x hx => obtain ⟨i, j, hij, rfl⟩ := hx; exact hg i j hij
  | zero => rw [map_zero]; exact J.zero_mem
  | add x y _ _ hx hy => rw [map_add]; exact J.add_mem hx hy
  | neg x _ hx => rw [map_neg]; exact J.neg_mem hx
  | left_absorb a x _ hx => exact hl a x hx
  | right_absorb a x _ hx => exact hr a x hx

end OddMath.CoveringQuantum.SuperCartanDatum
