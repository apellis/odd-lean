import OddMath.CoveringQuantum.UDot.Rho
import Mathlib.Algebra.Algebra.NonUnitalSubalgebra
import Mathlib.LinearAlgebra.DFinsupp

/-!
# The nonunital modified algebra inside its unital envelope

`CoveringUDot` is a unital presentation: its scalar identity is not one of the weight
idempotents. The modified algebra in [BE2] §9 is `UDot.modified`, the sum of the blocks
`1_μ CoveringUDot 1_η`. Each element has a unique finite block decomposition.

`modified_eq_adjoin` identifies this algebra with the nonunital algebra generated by the
weight idempotents and the Chevalley generators. The form of [BE2] Theorem 10.1 is to be
constructed on this nonunital algebra, not on the whole unital envelope.
-/

noncomputable section

namespace OddMath.CoveringQuantum.UDot

open Finset

variable {k I X : Type*} [CommRing k] [AddCommGroup X] [DecidableEq I] [DecidableEq X]
variable (D : RootDatum I X) (q : kˣ) (π : k)

/-- The block `1_μ U 1_η`, expressed by its left and right local identities. -/
def block (μ η : X) : Submodule k (CoveringUDot k D q π) where
  carrier := {x | one D q π μ * x = x ∧ x * one D q π η = x}
  zero_mem' := by simp
  add_mem' := by
    intro x y hx hy
    exact ⟨by rw [mul_add, hx.1, hy.1], by rw [add_mul, hx.2, hy.2]⟩
  smul_mem' := by
    intro c x hx
    exact ⟨by rw [mul_smul_comm, hx.1], by rw [smul_mul_assoc, hx.2]⟩

@[simp] theorem mem_block {μ η : X} {x : CoveringUDot k D q π} :
    x ∈ block D q π μ η ↔ one D q π μ * x = x ∧ x * one D q π η = x := Iff.rfl

/-- Projection to a weight block. -/
def blockProj (μ η : X) : CoveringUDot k D q π →ₗ[k] CoveringUDot k D q π where
  toFun x := one D q π μ * x * one D q π η
  map_add' x y := by simp only [mul_add, add_mul]
  map_smul' c x := by simp only [mul_smul_comm, smul_mul_assoc, RingHom.id_apply]

@[simp] theorem blockProj_apply (μ η : X) (x : CoveringUDot k D q π) :
    blockProj D q π μ η x = one D q π μ * x * one D q π η := rfl

theorem blockProj_mem (μ η : X) (x : CoveringUDot k D q π) :
    blockProj D q π μ η x ∈ block D q π μ η := by
  simp only [mem_block, blockProj_apply]
  constructor
  · rw [← mul_assoc, ← mul_assoc, one_mul_one_self]
  · rw [mul_assoc, one_mul_one_self]

theorem blockProj_eq_self {μ η : X} {x : CoveringUDot k D q π}
    (hx : x ∈ block D q π μ η) : blockProj D q π μ η x = x := by
  rw [blockProj_apply, hx.1, hx.2]

theorem one_mul_of_mem_block {ν κ : X} {x : CoveringUDot k D q π}
    (hx : x ∈ block D q π ν κ) (μ : X) :
    one D q π μ * x = if μ = ν then x else 0 := by
  conv_lhs => rw [← hx.1]
  rw [← mul_assoc, one_mul_one]
  split_ifs with h
  · simpa only [h] using hx.1
  · exact zero_mul _

theorem mul_one_of_mem_block {ν κ : X} {x : CoveringUDot k D q π}
    (hx : x ∈ block D q π ν κ) (η : X) :
    x * one D q π η = if κ = η then x else 0 := by
  conv_lhs => rw [← hx.2]
  rw [mul_assoc, one_mul_one]
  split_ifs with h
  · exact hx.2
  · exact mul_zero _

theorem blockProj_of_mem {ν κ : X} {x : CoveringUDot k D q π}
    (hx : x ∈ block D q π ν κ) (μ η : X) :
    blockProj D q π μ η x = if (μ, η) = (ν, κ) then x else 0 := by
  rw [blockProj_apply, one_mul_of_mem_block D q π hx]
  by_cases h : μ = ν
  · simp only [h, ite_true, mul_one_of_mem_block D q π hx, Prod.mk.injEq, true_and]
    simp only [eq_comm]
  · simp [h]

theorem mul_mem_block {μ η ν κ : X} {x y : CoveringUDot k D q π}
    (hx : x ∈ block D q π μ η) (hy : y ∈ block D q π ν κ) :
    x * y ∈ block D q π μ κ := by
  constructor
  · rw [← mul_assoc, hx.1]
  · rw [mul_assoc, hy.2]

/-- Mismatched adjacent blocks multiply to zero. -/
theorem mul_eq_zero_of_mem_block {μ η ν κ : X} {x y : CoveringUDot k D q π}
    (hx : x ∈ block D q π μ η) (hy : y ∈ block D q π ν κ) (h : η ≠ ν) : x * y = 0 := by
  calc
    x * y = x * (one D q π η * y) := by rw [← mul_assoc, hx.2]
    _ = 0 := by rw [one_mul_of_mem_block D q π hy]; simp [h]

/-- The nonunital modified algebra, the finite sum of all weight blocks. -/
def modified : NonUnitalSubalgebra k (CoveringUDot k D q π) :=
  { (⨆ b : X × X, block D q π b.1 b.2) with
    mul_mem' := by
      intro x y hx hy
      refine Submodule.iSup_induction (fun b : X × X ↦ block D q π b.1 b.2)
        (motive := fun x ↦ x * y ∈ ⨆ b : X × X, block D q π b.1 b.2) hx ?_ ?_ ?_
      · intro b x hx
        refine Submodule.iSup_induction (fun c : X × X ↦ block D q π c.1 c.2)
          (motive := fun y ↦ x * y ∈ ⨆ b : X × X, block D q π b.1 b.2) hy ?_ ?_ ?_
        · intro c y hy
          exact Submodule.mem_iSup_of_mem (b.1, c.2) (mul_mem_block D q π hx hy)
        · simpa only [mul_zero] using Submodule.zero_mem (⨆ b : X × X, block D q π b.1 b.2)
        · intro y z hy hz
          simpa only [mul_add] using Submodule.add_mem _ hy hz
      · simpa only [zero_mul] using Submodule.zero_mem (⨆ b : X × X, block D q π b.1 b.2)
      · intro x z hx hz
        simpa only [add_mul] using Submodule.add_mem _ hx hz }

theorem block_le_modified (μ η : X) : block D q π μ η ≤ (modified D q π).toSubmodule :=
  le_iSup (fun b : X × X ↦ block D q π b.1 b.2) (μ, η)

/-- Every element of the modified algebra is a finite sum of block elements. -/
theorem mem_modified_iff (x : CoveringUDot k D q π) :
    x ∈ modified D q π ↔ ∃ f : (X × X) →₀ CoveringUDot k D q π,
      (∀ b, f b ∈ block D q π b.1 b.2) ∧ f.sum (fun _ z ↦ z) = x :=
  Submodule.mem_iSup_iff_exists_finsupp _ _

/-- A finite sum of weight idempotents acts as the identity on blocks whose left index it contains. -/
theorem sum_one_mul_block {μ η : X} {x : CoveringUDot k D q π}
    (hx : x ∈ block D q π μ η) {s : Finset X} (hμ : μ ∈ s) :
    (∑ ν ∈ s, one D q π ν) * x = x := by
  rw [Finset.sum_mul]
  simp only [one_mul_of_mem_block D q π hx]
  simp [hμ]

/-- A finite sum of weight idempotents acts as the identity on blocks whose right index it contains. -/
theorem block_mul_sum_one {μ η : X} {x : CoveringUDot k D q π}
    (hx : x ∈ block D q π μ η) {s : Finset X} (hη : η ∈ s) :
    x * (∑ ν ∈ s, one D q π ν) = x := by
  rw [Finset.mul_sum]
  simp only [mul_one_of_mem_block D q π hx]
  simp [hη]

/-- Every element of the modified algebra has a finite two-sided local identity. -/
theorem exists_localUnit {x : CoveringUDot k D q π} (hx : x ∈ modified D q π) :
    ∃ s : Finset X, (∑ μ ∈ s, one D q π μ) * x = x ∧ x * (∑ μ ∈ s, one D q π μ) = x := by
  obtain ⟨f, hf, rfl⟩ := (mem_modified_iff D q π x).mp hx
  refine ⟨f.support.image Prod.fst ∪ f.support.image Prod.snd, ?_, ?_⟩
  · rw [Finsupp.sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b hb
    exact sum_one_mul_block D q π (hf b) (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hb))
  · rw [Finsupp.sum, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro b hb
    exact block_mul_sum_one D q π (hf b) (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hb))

/-- Sandwiching a finite block sum recovers its corresponding component. -/
theorem blockProj_sum (f : (X × X) →₀ CoveringUDot k D q π)
    (hf : ∀ b, f b ∈ block D q π b.1 b.2) (b : X × X) :
    blockProj D q π b.1 b.2 (f.sum (fun _ z ↦ z)) = f b := by
  rw [Finsupp.sum, map_sum]
  simp only [blockProj_of_mem D q π (hf _), Prod.eta]
  rw [Finset.sum_ite_eq]
  split_ifs with h
  · rfl
  · exact (Finsupp.notMem_support_iff.mp h).symm

/-- Finite block decompositions are unique. -/
theorem block_sum_injective (f g : (X × X) →₀ CoveringUDot k D q π)
    (hf : ∀ b, f b ∈ block D q π b.1 b.2) (hg : ∀ b, g b ∈ block D q π b.1 b.2)
    (h : f.sum (fun _ z ↦ z) = g.sum (fun _ z ↦ z)) : f = g := by
  ext b
  have := congrArg (blockProj D q π b.1 b.2) h
  simpa only [blockProj_sum D q π f hf, blockProj_sum D q π g hg] using this

theorem one_mem_modified (μ : X) : one D q π μ ∈ modified D q π :=
  block_le_modified D q π μ μ ⟨one_mul_one_self D q π μ, one_mul_one_self D q π μ⟩

theorem E_mem_modified (i : I) (μ : X) : E D q π i μ ∈ modified D q π :=
  block_le_modified D q π (μ + D.α i) μ ⟨one_mul_E_self D q π i μ, E_mul_one_self D q π i μ⟩

theorem F_mem_modified (i : I) (μ : X) : F D q π i μ ∈ modified D q π :=
  block_le_modified D q π (μ - D.α i) μ ⟨one_mul_F_self D q π i μ, F_mul_one_self D q π i μ⟩

/-- The three families of generators, without the adjoined scalar identity. -/
def generators : Set (CoveringUDot k D q π) :=
  Set.range fun g : Gen I X ↦ mk D q π (FreeAlgebra.ι k g)

private theorem gen_mem_adjoin (g : Gen I X) :
    mk D q π (FreeAlgebra.ι k g) ∈ NonUnitalAlgebra.adjoin k (generators D q π) :=
  NonUnitalAlgebra.subset_adjoin k ⟨g, rfl⟩

private theorem adjoin_mul {x : CoveringUDot k D q π}
    (hx : x ∈ NonUnitalAlgebra.adjoin k (generators D q π)) (y : CoveringUDot k D q π) :
    x * y ∈ NonUnitalAlgebra.adjoin k (generators D q π) := by
  obtain ⟨z, rfl⟩ := mk_surjective D q π y
  induction z using FreeAlgebra.induction generalizing x with
  | grade0 c =>
    rw [AlgHom.commutes, Algebra.algebraMap_eq_smul_one, mul_smul_comm, mul_one]
    exact SMulMemClass.smul_mem _ hx
  | grade1 g => exact mul_mem hx (gen_mem_adjoin D q π g)
  | add a b ha hb => simpa only [map_add, mul_add] using add_mem (ha hx) (hb hx)
  | mul a b ha hb =>
    rw [map_mul, ← mul_assoc]
    exact hb (ha hx)

/-- The block sum is precisely the nonunital algebra generated by `1_η`, `eᵢ1_η`, `fᵢ1_η`. -/
theorem modified_eq_adjoin : modified D q π = NonUnitalAlgebra.adjoin k (generators D q π) := by
  apply le_antisymm
  · intro x hx
    change x ∈ ⨆ b : X × X, block D q π b.1 b.2 at hx
    refine Submodule.iSup_induction (fun b : X × X ↦ block D q π b.1 b.2)
      (motive := fun x ↦ x ∈ NonUnitalAlgebra.adjoin k (generators D q π)) hx ?_ ?_ ?_
    · intro b x hx
      rw [← hx.1]
      exact adjoin_mul D q π (gen_mem_adjoin D q π (.one b.1)) x
    · exact zero_mem _
    · intro x y hx hy
      exact add_mem hx hy
  · apply NonUnitalAlgebra.adjoin_le
    rintro _ ⟨g, rfl⟩
    cases g with
    | one μ => exact one_mem_modified D q π μ
    | e i μ => exact E_mem_modified D q π i μ
    | f i μ => exact F_mem_modified D q π i μ

private def augmentationFree : Free k I X →ₐ[k] k := FreeAlgebra.lift k fun _ ↦ 0

omit [AddCommGroup X] [DecidableEq I] [DecidableEq X] in
private theorem augmentationFree_ι (g : Gen I X) :
    augmentationFree (k := k) (FreeAlgebra.ι k g) = 0 := by simp [augmentationFree]

private theorem augmentationFree_rel {x y : Free k I X} (h : Rel D q π x y) :
    augmentationFree x = augmentationFree y := by
  cases h with
  | one_one μ ν =>
    split_ifs <;> simp [Free.one, augmentationFree_ι]
  | one_E i μ => simp [Free.one, Free.E, augmentationFree_ι]
  | E_one i μ => simp [Free.one, Free.E, augmentationFree_ι]
  | one_F i μ => simp [Free.one, Free.F, augmentationFree_ι]
  | F_one i μ => simp [Free.one, Free.F, augmentationFree_ι]
  | comm i j μ =>
    split_ifs <;> simp [Free.one, Free.E, Free.F, augmentationFree_ι]
  | serreE i j μ h => simp [serreE, Free.E, augmentationFree_ι]
  | serreF i j μ h => simp [serreF, Free.F, augmentationFree_ι]

/-- The augmentation kills all weight and Chevalley generators, but preserves the adjoined scalars. -/
def augmentation : CoveringUDot k D q π →ₐ[k] k :=
  RingQuot.liftAlgHom k ⟨augmentationFree, fun _ _ h ↦ augmentationFree_rel D q π h⟩

@[simp] private theorem augmentation_mk (x : Free k I X) :
    augmentation D q π (mk D q π x) = augmentationFree x := by
  simp only [augmentation, mk, RingQuot.liftAlgHom_mkAlgHom_apply]

@[simp] theorem augmentation_one (μ : X) : augmentation D q π (one D q π μ) = 0 := by
  rw [one, augmentation_mk, Free.one, augmentationFree_ι]

/-- All blocks lie in the augmentation ideal. -/
theorem augmentation_eq_zero {x : CoveringUDot k D q π} (hx : x ∈ modified D q π) :
    augmentation D q π x = 0 := by
  refine Submodule.iSup_induction (fun b : X × X ↦ block D q π b.1 b.2)
    (motive := fun x ↦ augmentation D q π x = 0) hx ?_ (map_zero _) ?_
  · intro b x hx
    rw [← hx.1, map_mul, augmentation_one, zero_mul]
  · intro x y hx hy
    rw [map_add, hx, hy, add_zero]

/-- The scalar identity of the unital envelope does not belong to the modified algebra. -/
theorem unit_not_mem_modified [Nontrivial k] : (1 : CoveringUDot k D q π) ∉ modified D q π := by
  intro h
  have := augmentation_eq_zero D q π h
  rw [map_one] at this
  exact one_ne_zero this

/-- `ρ` reverses the two block indices. -/
theorem rho_mem_block {μ η : X} {x : CoveringUDot k D q π} (hπ : π ^ 2 = 1)
    (hx : x ∈ block D q π μ η) : (rho D q π hπ x).unop ∈ block D q π η μ := by
  constructor
  · have := congrArg (fun z ↦ (rho D q π hπ z).unop) hx.2
    simpa only [rho_mul, rho_one] using this
  · have := congrArg (fun z ↦ (rho D q π hπ z).unop) hx.1
    simpa only [rho_mul, rho_one] using this

/-- `ρ` restricts to the nonunital modified algebra. -/
theorem rho_mem_modified {x : CoveringUDot k D q π} (hπ : π ^ 2 = 1)
    (hx : x ∈ modified D q π) : (rho D q π hπ x).unop ∈ modified D q π := by
  refine Submodule.iSup_induction (fun b : X × X ↦ block D q π b.1 b.2)
    (motive := fun x ↦ (rho D q π hπ x).unop ∈ modified D q π) hx ?_ ?_ ?_
  · intro b x hx
    exact block_le_modified D q π b.2 b.1 (rho_mem_block D q π hπ hx)
  · simp only [map_zero, MulOpposite.unop_zero]; exact zero_mem _
  · intro x y hx hy
    simpa only [map_add, MulOpposite.unop_add] using add_mem hx hy

variable {σ : k →+* k}

/-- `ψ` preserves the weight blocks. -/
theorem psi_mem_block {μ η : X} {x : CoveringUDot k D q π} (hσ : BarData q π σ)
    (hx : x ∈ block D q π μ η) : psi D q π σ hσ x ∈ block D q π μ η := by
  constructor
  · have := congrArg (psi D q π σ hσ) hx.1
    simpa only [map_mul, psi_one] using this
  · have := congrArg (psi D q π σ hσ) hx.2
    simpa only [map_mul, psi_one] using this

/-- `ψ` restricts to the nonunital modified algebra. -/
theorem psi_mem_modified {x : CoveringUDot k D q π} (hσ : BarData q π σ)
    (hx : x ∈ modified D q π) : psi D q π σ hσ x ∈ modified D q π := by
  refine Submodule.iSup_induction (fun b : X × X ↦ block D q π b.1 b.2)
    (motive := fun x ↦ psi D q π σ hσ x ∈ modified D q π) hx ?_ ?_ ?_
  · intro b x hx
    exact block_le_modified D q π b.1 b.2 (psi_mem_block D q π hσ hx)
  · rw [map_zero]; exact zero_mem _
  · intro x y hx hy
    simpa only [map_add] using add_mem hx hy

/-- `∗` restricts to the nonunital modified algebra. -/
theorem star_mem_modified {x : CoveringUDot k D q π} (hσ : BarData q π σ)
    (hx : x ∈ modified D q π) : (star D q π σ hσ x).unop ∈ modified D q π :=
  rho_mem_modified D q π hσ.π_sq (psi_mem_modified D q π hσ hx)

/-- `!` restricts to the nonunital modified algebra. -/
theorem shriek_mem_modified {x : CoveringUDot k D q π} (hσ : BarData q π σ)
    (hx : x ∈ modified D q π) : (shriek D q π σ hσ x).unop ∈ modified D q π :=
  psi_mem_modified D q π hσ (rho_mem_modified D q π hσ.π_sq hx)

end OddMath.CoveringQuantum.UDot
