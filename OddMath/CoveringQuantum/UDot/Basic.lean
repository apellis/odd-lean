import Mathlib.Algebra.Algebra.NonUnitalSubalgebra
import Mathlib.RingTheory.Adjoin.Basic
import OddMath.CoveringQuantum.HalfAlgebra

/-!
# The covering quantum group `U̇_{q,π}(𝔤)`

Brundan–Ellis, arXiv:1701.04133v2 ([BE2]), §9: `U̇_{q,π}(𝔤)` is the locally unital algebra with
mutually orthogonal idempotents `1_λ` (`λ ∈ P`) and generators `eᵢ 1_λ = 1_{λ+αᵢ} eᵢ`,
`fᵢ 1_λ = 1_{λ-αᵢ} fᵢ`, subject to
```
(eᵢ fⱼ - π^{|i||j|} fⱼ eᵢ) 1_λ = δᵢⱼ [⟨hᵢ, λ⟩]_{qᵢ,πᵢ} 1_λ,                                (9.2)
Σ_{r=0}^{dᵢⱼ+1} (-1)ʳ πᵢ^{r|j| + r(r-1)/2} [dᵢⱼ+1, r]_{qᵢ,πᵢ} eᵢ^{dᵢⱼ+1-r} eⱼ eᵢʳ 1_λ = 0,   (9.3)
Σ_{r=0}^{dᵢⱼ+1} (-1)ʳ πᵢ^{r|j| + r(r-1)/2} [dᵢⱼ+1, r]_{qᵢ,πᵢ} fᵢ^{dᵢⱼ+1-r} fⱼ fᵢʳ 1_λ = 0    (9.4)
```
(`i ≠ j` in (9.3), (9.4)), and `U̇_{q,π}(𝔤)_𝓛` is the `𝓛`-subalgebra generated by the divided
powers `eᵢ^{(n)} 1_λ = eᵢⁿ 1_λ / [n]!_{qᵢ,πᵢ}`, `fᵢ^{(n)} 1_λ = fᵢⁿ 1_λ / [n]!_{qᵢ,πᵢ}` (9.5).

## Formalization

We work over any commutative ring `k` with a unit `q` and an element `π` ([BE2] uses
`𝕃 = ℚ(q)[π]/(π² - 1)`), with weights in the lattice `X` of a `RootDatum`. A locally unital
algebra presented by generators and relations is encoded as the unital algebra `CoveringUDot`
with the same generators and relations (`RingQuot` of a free algebra); its unit is an extra
element, and `U̇ = ⊕_{λ,μ} 1_μ U̇ 1_λ` is the non-unital subalgebra spanned by the generators
(every product of generators lies in some `1_μ U̇ 1_λ`). The "locally unital" axioms are the
relations `1_λ 1_μ = δ_{λμ} 1_λ`, `1_{λ+αᵢ} eᵢ1_λ = eᵢ1_λ = eᵢ1_λ 1_λ`,
`1_{λ-αᵢ} fᵢ1_λ = fᵢ1_λ = fᵢ1_λ 1_λ`.

Words are written with their idempotents: `eᵢⁿ 1_λ = (eᵢ1_{λ+(n-1)αᵢ}) ⋯ (eᵢ1_λ)` (`epow`), and
similarly for `f` (`fpow`); `eᵢ^{N-r} eⱼ eᵢʳ 1_λ` is
`eᵢ^{N-r} 1_{λ+rαᵢ+αⱼ} · eⱼ1_{λ+rαᵢ} · eᵢʳ1_λ`.

The `𝓛`-form is taken over any commutative ring `L` with `Algebra L k` (for [BE2], `𝓛 → 𝕃`); the
divided powers use `Ring.inverse` of `[n]!` (a genuine inverse when `[n]!` is a unit, as in `𝕃`).
We include the idempotents `1_λ` (the `n = 0` divided powers) among the generators.

## Main definitions

* `UDot.Gen`, `UDot.Free`: generators `1_λ`, `eᵢ1_λ`, `fᵢ1_λ` and the free algebra on them.
* `UDot.Rel`: the relations above.
* `CoveringUDot k D q π`: `U̇_{q,π}(𝔤)`; `UDot.one`, `UDot.E`, `UDot.F` the generators.
* `UDot.edp`, `UDot.fdp`, `UDot.lForm`: divided powers and the `𝓛`-form (9.5).

## Main results

* `UDot.one_mul_one`, `UDot.one_mul_E`, `UDot.E_mul_one`, `UDot.one_mul_F`, `UDot.F_mul_one`.
* `UDot.comm_rel`, `UDot.serreE_rel`, `UDot.serreF_rel`: (9.2)–(9.4) hold in `CoveringUDot`.
-/

noncomputable section

namespace OddMath.CoveringQuantum

open Finset

namespace UDot

/-- The generators `1_λ`, `eᵢ1_λ`, `fᵢ1_λ` of `U̇` ([BE2] §9). -/
inductive Gen (I X : Type*)
  | one (μ : X)
  | e (i : I) (μ : X)
  | f (i : I) (μ : X)

variable (k : Type*) [CommRing k] {I X : Type*} [AddCommGroup X] [DecidableEq I] [DecidableEq X]

/-- The free algebra on the generators. -/
abbrev Free (I X : Type*) := FreeAlgebra k (Gen I X)

namespace Free

/-- `1_λ`. -/
def one (μ : X) : Free k I X := FreeAlgebra.ι k (Gen.one μ)

/-- `eᵢ 1_λ`. -/
def E (i : I) (μ : X) : Free k I X := FreeAlgebra.ι k (Gen.e i μ)

/-- `fᵢ 1_λ`. -/
def F (i : I) (μ : X) : Free k I X := FreeAlgebra.ι k (Gen.f i μ)

end Free

variable {k} (D : RootDatum I X) (q : kˣ) (π : k)

open Free

/-- `eᵢⁿ 1_λ = (eᵢ1_{λ+(n-1)αᵢ}) ⋯ (eᵢ1_λ)`, with `eᵢ⁰ 1_λ = 1_λ`. -/
def epow (i : I) : ℕ → X → Free k I X
  | 0, μ => one k μ
  | n + 1, μ => E k i (μ + n • D.α i) * epow i n μ

/-- `fᵢⁿ 1_λ = (fᵢ1_{λ-(n-1)αᵢ}) ⋯ (fᵢ1_λ)`, with `fᵢ⁰ 1_λ = 1_λ`. -/
def fpow (i : I) : ℕ → X → Free k I X
  | 0, μ => one k μ
  | n + 1, μ => F k i (μ - n • D.α i) * fpow i n μ

/-- The left side of (9.3) at `1_λ`. -/
def serreE (i j : I) (μ : X) : Free k I X :=
  ∑ r ∈ range (D.serreDeg i j + 1), D.serreCoeff q π i j r •
    (epow D i (D.serreDeg i j - r) (μ + r • D.α i + D.α j) * E k j (μ + r • D.α i) * epow D i r μ)

/-- The left side of (9.4) at `1_λ`. -/
def serreF (i j : I) (μ : X) : Free k I X :=
  ∑ r ∈ range (D.serreDeg i j + 1), D.serreCoeff q π i j r •
    (fpow D i (D.serreDeg i j - r) (μ - r • D.α i - D.α j) * F k j (μ - r • D.α i) * fpow D i r μ)

/-- The defining relations of `U̇_{q,π}(𝔤)` ([BE2] §9). -/
inductive Rel : Free k I X → Free k I X → Prop
  | one_one (μ ν : X) : Rel (one k μ * one k ν) (if μ = ν then one k μ else 0)
  | one_E (i : I) (μ : X) : Rel (one k (μ + D.α i) * E k i μ) (E k i μ)
  | E_one (i : I) (μ : X) : Rel (E k i μ * one k μ) (E k i μ)
  | one_F (i : I) (μ : X) : Rel (one k (μ - D.α i) * F k i μ) (F k i μ)
  | F_one (i : I) (μ : X) : Rel (F k i μ * one k μ) (F k i μ)
  /-- (9.2): `(eᵢ fⱼ - π^{|i||j|} fⱼ eᵢ) 1_λ = δᵢⱼ [⟨hᵢ, λ⟩]_{qᵢ,πᵢ} 1_λ`. -/
  | comm (i j : I) (μ : X) :
      Rel (E k i (μ - D.α j) * F k j μ -
          π ^ (D.parity i * D.parity j).val • (F k j (μ + D.α i) * E k i μ))
        (if i = j then qpInt (D.qi q i) (D.pii π i) (D.h i μ) • one k μ else 0)
  /-- (9.3). -/
  | serreE (i j : I) (μ : X) (h : i ≠ j) : Rel (serreE D q π i j μ) 0
  /-- (9.4). -/
  | serreF (i j : I) (μ : X) (h : i ≠ j) : Rel (serreF D q π i j μ) 0

end UDot

open UDot

variable (k : Type*) [CommRing k] {I X : Type*} [AddCommGroup X] [DecidableEq I] [DecidableEq X]

/-- The covering quantum group `U̇_{q,π}(𝔤)` of [BE2] §9 (with an adjoined unit, see the module
docstring). -/
abbrev CoveringUDot (D : RootDatum I X) (q : kˣ) (π : k) := RingQuot (UDot.Rel D q π)

namespace UDot

variable {k} (D : RootDatum I X) (q : kˣ) (π : k)

/-- The projection from the free algebra. -/
def mk : Free k I X →ₐ[k] CoveringUDot k D q π := RingQuot.mkAlgHom k (Rel D q π)

theorem mk_surjective : Function.Surjective (mk D q π) := RingQuot.mkAlgHom_surjective k _

theorem mk_rel {x y : Free k I X} (h : Rel D q π x y) : mk D q π x = mk D q π y :=
  RingQuot.mkAlgHom_rel k h

/-- `1_λ ∈ U̇`. -/
def one (μ : X) : CoveringUDot k D q π := mk D q π (Free.one k μ)

/-- `eᵢ 1_λ ∈ U̇`. -/
def E (i : I) (μ : X) : CoveringUDot k D q π := mk D q π (Free.E k i μ)

/-- `fᵢ 1_λ ∈ U̇`. -/
def F (i : I) (μ : X) : CoveringUDot k D q π := mk D q π (Free.F k i μ)

/-- `1_λ 1_μ = δ_{λμ} 1_λ`. -/
theorem one_mul_one (μ ν : X) :
    one D q π μ * one D q π ν = if μ = ν then one D q π μ else 0 := by
  have := mk_rel D q π (Rel.one_one μ ν)
  rw [map_mul] at this
  rw [one, one, this]
  split_ifs <;> simp

theorem one_mul_one_self (μ : X) : one D q π μ * one D q π μ = one D q π μ := by
  simp [one_mul_one]

theorem E_mul_one_self (i : I) (μ : X) : E D q π i μ * one D q π μ = E D q π i μ := by
  have := mk_rel D q π (Rel.E_one i μ); rwa [map_mul] at this

theorem one_mul_E_self (i : I) (μ : X) : one D q π (μ + D.α i) * E D q π i μ = E D q π i μ := by
  have := mk_rel D q π (Rel.one_E i μ); rwa [map_mul] at this

theorem F_mul_one_self (i : I) (μ : X) : F D q π i μ * one D q π μ = F D q π i μ := by
  have := mk_rel D q π (Rel.F_one i μ); rwa [map_mul] at this

theorem one_mul_F_self (i : I) (μ : X) : one D q π (μ - D.α i) * F D q π i μ = F D q π i μ := by
  have := mk_rel D q π (Rel.one_F i μ); rwa [map_mul] at this

/-- `1_ν eᵢ1_λ = δ_{ν, λ+αᵢ} eᵢ1_λ`. -/
theorem one_mul_E (ν : X) (i : I) (μ : X) :
    one D q π ν * E D q π i μ = if ν = μ + D.α i then E D q π i μ else 0 := by
  rw [← one_mul_E_self, ← mul_assoc, one_mul_one]
  split_ifs with h
  · rw [h, one_mul_E_self]
  · rw [zero_mul]

/-- `eᵢ1_λ 1_ν = δ_{λν} eᵢ1_λ`. -/
theorem E_mul_one (i : I) (μ ν : X) :
    E D q π i μ * one D q π ν = if μ = ν then E D q π i μ else 0 := by
  rw [← E_mul_one_self, mul_assoc, one_mul_one]
  split_ifs with h
  · rw [E_mul_one_self]
  · rw [mul_zero]

/-- `1_ν fᵢ1_λ = δ_{ν, λ-αᵢ} fᵢ1_λ`. -/
theorem one_mul_F (ν : X) (i : I) (μ : X) :
    one D q π ν * F D q π i μ = if ν = μ - D.α i then F D q π i μ else 0 := by
  rw [← one_mul_F_self, ← mul_assoc, one_mul_one]
  split_ifs with h
  · rw [h, one_mul_F_self]
  · rw [zero_mul]

/-- `fᵢ1_λ 1_ν = δ_{λν} fᵢ1_λ`. -/
theorem F_mul_one (i : I) (μ ν : X) :
    F D q π i μ * one D q π ν = if μ = ν then F D q π i μ else 0 := by
  rw [← F_mul_one_self, mul_assoc, one_mul_one]
  split_ifs with h
  · rw [F_mul_one_self]
  · rw [mul_zero]

/-- (9.2) in `U̇`. -/
theorem comm_rel (i j : I) (μ : X) :
    E D q π i (μ - D.α j) * F D q π j μ -
        π ^ (D.parity i * D.parity j).val • (F D q π j (μ + D.α i) * E D q π i μ) =
      if i = j then qpInt (D.qi q i) (D.pii π i) (D.h i μ) • one D q π μ else 0 := by
  have := mk_rel D q π (Rel.comm i j μ)
  simp only [map_sub, map_mul, map_smul] at this
  rw [E, F, F, E, this]
  split_ifs <;> simp [one]

/-- (9.3) in `U̇`. -/
theorem serreE_rel {i j : I} (h : i ≠ j) (μ : X) : mk D q π (serreE D q π i j μ) = 0 := by
  rw [mk_rel D q π (Rel.serreE i j μ h), map_zero]

/-- (9.4) in `U̇`. -/
theorem serreF_rel {i j : I} (h : i ≠ j) (μ : X) : mk D q π (serreF D q π i j μ) = 0 := by
  rw [mk_rel D q π (Rel.serreF i j μ h), map_zero]

/-! ### Divided powers and the `𝓛`-form (9.5) -/

/-- `eᵢ^{(n)} 1_λ = eᵢⁿ 1_λ / [n]!_{qᵢ,πᵢ}`. -/
def edp (i : I) (n : ℕ) (μ : X) : CoveringUDot k D q π :=
  Ring.inverse (qpFact (D.qi q i) (D.pii π i) n) • mk D q π (epow D i n μ)

/-- `fᵢ^{(n)} 1_λ = fᵢⁿ 1_λ / [n]!_{qᵢ,πᵢ}`. -/
def fdp (i : I) (n : ℕ) (μ : X) : CoveringUDot k D q π :=
  Ring.inverse (qpFact (D.qi q i) (D.pii π i) n) • mk D q π (fpow D i n μ)

theorem edp_zero (i : I) (μ : X) : edp D q π i 0 μ = one D q π μ := by
  simp [edp, epow, one]

theorem fdp_zero (i : I) (μ : X) : fdp D q π i 0 μ = one D q π μ := by
  simp [fdp, fpow, one]

theorem edp_one (i : I) (μ : X) : edp D q π i 1 μ = E D q π i μ := by
  have h : epow D i 1 μ = Free.E k i μ * Free.one k μ := by simp [epow]
  rw [edp, h, map_mul, qpFact_succ, qpFact_zero, qpNat_one, mul_one, Ring.inverse_one, one_smul]
  exact E_mul_one_self D q π i μ

theorem fdp_one (i : I) (μ : X) : fdp D q π i 1 μ = F D q π i μ := by
  have h : fpow D i 1 μ = Free.F k i μ * Free.one k μ := by simp [fpow]
  rw [fdp, h, map_mul, qpFact_succ, qpFact_zero, qpNat_one, mul_one, Ring.inverse_one, one_smul]
  exact F_mul_one_self D q π i μ

/-- The `𝓛`-form `U̇_{q,π}(𝔤)_𝓛` (9.5): the (non-unital) `L`-subalgebra generated by the
idempotents `1_λ` and the divided powers `eᵢ^{(n)} 1_λ`, `fᵢ^{(n)} 1_λ`. -/
def lForm (L : Type*) [CommRing L] [Algebra L k] : NonUnitalSubalgebra L (CoveringUDot k D q π) :=
  NonUnitalAlgebra.adjoin L
    (Set.range (one D q π) ∪ Set.range (fun p : I × ℕ × X ↦ edp D q π p.1 p.2.1 p.2.2) ∪
      Set.range (fun p : I × ℕ × X ↦ fdp D q π p.1 p.2.1 p.2.2))

theorem one_mem_lForm (L : Type*) [CommRing L] [Algebra L k] (μ : X) :
    one D q π μ ∈ lForm D q π L :=
  NonUnitalAlgebra.subset_adjoin L (Or.inl (Or.inl ⟨μ, rfl⟩))

theorem edp_mem_lForm (L : Type*) [CommRing L] [Algebra L k] (i : I) (n : ℕ) (μ : X) :
    edp D q π i n μ ∈ lForm D q π L :=
  NonUnitalAlgebra.subset_adjoin L (Or.inl (Or.inr ⟨(i, n, μ), rfl⟩))

theorem fdp_mem_lForm (L : Type*) [CommRing L] [Algebra L k] (i : I) (n : ℕ) (μ : X) :
    fdp D q π i n μ ∈ lForm D q π L :=
  NonUnitalAlgebra.subset_adjoin L (Or.inr ⟨(i, n, μ), rfl⟩)

end UDot

end OddMath.CoveringQuantum
